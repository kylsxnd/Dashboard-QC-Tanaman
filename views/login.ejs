<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - Agrinas Enterprise</title>
    
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    
    <style>
        body { 
            font-family: 'Inter', sans-serif; 
            background-color: #f3f4f6; 
        }
        
        .glass-logo { 
            background: rgba(255, 255, 255, 0.15); 
            backdrop-filter: blur(10px); 
        }
    </style>
</head>
<body class="h-screen w-full flex items-center justify-center p-4 md:p-8">

    <div class="bg-white w-full max-w-6xl h-full max-h-[750px] rounded-[32px] shadow-2xl flex overflow-hidden">
        
        <!-- BAGIAN KIRI: Gambar Kebun Sawit Online -->
        <div class="hidden lg:flex w-[45%] relative bg-slate-900">
            
            <img src="https://images.unsplash.com/photo-1590055531615-f16d36ffe8ea?ixlib=rb-4.0.3&auto=format&fit=crop&w=1000&q=80" 
                 alt="Kebun Sawit" 
                 class="absolute inset-0 w-full h-full object-cover opacity-80 mix-blend-overlay">
            
            <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/20 to-transparent"></div>

            <div class="absolute top-1/3 left-1/2 transform -translate-x-1/2 -translate-y-1/2">
                <div class="w-28 h-28 glass-logo rounded-3xl flex items-center justify-center border border-white/30 shadow-2xl">
                    <svg class="w-14 h-14 text-white drop-shadow-md" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                    </svg>
                </div>
            </div>

            <div class="absolute bottom-12 left-10 right-10 text-white">
                <h2 class="text-[28px] font-bold mb-3 leading-tight tracking-tight">
                    Sistem Operasional<br>Kebun dan Pabrik
                </h2>
                <p class="text-slate-300 text-sm leading-relaxed font-medium">
                    Pantau dan kelola data operasional kebun dan pabrik kelapa sawit secara real-time melalui Executive Portal.
                </p>
            </div>
        </div>

        <!-- BAGIAN KANAN: Form Login -->
        <div class="w-full lg:w-[55%] flex flex-col justify-center px-10 md:px-20 relative">
            
            <div class="absolute top-10 right-10 flex items-center gap-2">
                <svg class="w-6 h-6 text-[#72a356]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
                </svg>
            </div>

            <div class="mb-10">
                <h1 class="text-[34px] font-bold text-slate-800 mb-2 leading-tight tracking-tight">
                    Halo,<br>Selamat Datang!
                </h1>
                <p class="text-slate-500 text-sm font-medium">
                    Masuk ke Sistem AGRINAS OPS
                </p>
            </div>

            <form action="/dashboard" method="GET" class="space-y-5 w-full max-w-md">
                
                <div>
                    <label class="block text-xs font-semibold text-slate-600 mb-2">Email</label>
                    <input type="email" value="staf.pic.ho.tanaman@agrinas.id" required
                           class="w-full px-4 py-3.5 rounded-xl border border-slate-300 focus:outline-none focus:border-[#72a356] focus:ring-4 focus:ring-[#72a356]/10 transition-all text-sm text-slate-700 font-medium">
                </div>

                <div>
                    <label class="block text-xs font-semibold text-slate-600 mb-2">Password</label>
                    <div class="relative">
                        <input type="password" value="rahasia123" required
                               class="w-full px-4 py-3.5 rounded-xl border border-slate-300 focus:outline-none focus:border-[#72a356] focus:ring-4 focus:ring-[#72a356]/10 transition-all text-sm text-slate-700 font-medium tracking-wider">
                        
                        <button type="button" class="absolute right-4 top-1/2 transform -translate-y-1/2 text-slate-400 hover:text-slate-600">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                            </svg>
                        </button>
                    </div>
                </div>

                <button type="submit" class="w-full bg-[#83b765] hover:bg-[#72a356] text-white font-bold text-sm py-4 rounded-xl shadow-lg shadow-[#83b765]/25 transition-all mt-4">
                    Masuk
                </button>
            </form>

            <div class="mt-12 text-center text-[10px] text-slate-400 leading-relaxed max-w-sm">
                Dengan masuk, Anda menyetujui Ketentuan dan Kebijakan Privasi.<br>
                © 2026 PT Agrinas Palma Nusantara (Persero). Divisi TI & GIS.
            </div>

        </div>
    </div>
</body>
</html>