<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Executive Portal - Agrinas</title>
    
    <!-- Library CSS & Framework -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <script src="https://code.highcharts.com/highcharts.js"></script>
    
    <!-- DataTables -->
    <link href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css" rel="stylesheet">
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>

    <!-- Google Fonts Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <style>
        /* =========================================
           SISTEM TEMA: DARK / LIGHT MODE
           ========================================= */
        :root {
            /* Tema Gelap (Bawaan) */
            --bg-main: #0a0a0a; 
            --bg-panel: #111111;
            --bg-card: #151515;
            --border-color: #262626;
            --text-main: #ffffff;
            --text-muted: #a1a1aa;
            --hover-bg: #27272a;
            --shadow-drop: 0 10px 40px -10px rgba(0,0,0,0.8);
            --bg-dropdown: rgba(21, 21, 21, 0.95);
        }
        
        body.light-mode {
            /* Tema Terang */
            --bg-main: #f3f4f6; 
            --bg-panel: #ffffff;
            --bg-card: #ffffff;
            --border-color: #e5e7eb;
            --text-main: #1f2937;
            --text-muted: #6b7280;
            --hover-bg: #f8fafc;
            --shadow-drop: 0 10px 40px -10px rgba(0,0,0,0.15);
            --bg-dropdown: rgba(255, 255, 255, 0.98); 
        }

        /* CLASS KHUSUS UNTUK MENERAPKAN TEMA */
        .theme-bg-main { background-color: var(--bg-main); transition: all 0.3s ease; }
        .theme-bg-panel { background-color: var(--bg-panel); transition: all 0.3s ease; }
        .theme-border { border-color: var(--border-color); transition: all 0.3s ease; }
        .theme-text-main { color: var(--text-main); transition: all 0.3s ease; }
        .theme-text-muted { color: var(--text-muted); transition: all 0.3s ease; }

        /* =========================================
           BASE & LAYOUT
           ========================================= */
        body { background-color: var(--bg-main); color: var(--text-main); font-family: 'Inter', sans-serif; overflow: hidden; transition: all 0.3s ease; }
        
        /* PREMIUM CARDS */
        .premium-card { background: var(--bg-card); border: 1px solid var(--border-color); border-radius: 12px; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1); transition: all 0.3s ease; }

        /* =========================================
           DROPDOWN NOTIFIKASI KHUSUS (ANTI TRANSPARAN)
           ========================================= */
        .premium-dropdown { background-color: var(--bg-dropdown); backdrop-filter: blur(12px); border: 1px solid var(--border-color); box-shadow: var(--shadow-drop); z-index: 100 !important; }
        .premium-dropdown-header { background-color: var(--bg-panel); border-bottom: 1px solid var(--border-color); }

        /* =========================================
           SIDEBAR LINKS
           ========================================= */
        .sidebar-link { padding: 10px 16px; font-size: 13px; font-weight: 500; color: var(--text-muted); border-radius: 8px; transition: all 0.2s ease; display: flex; align-items: center; margin-bottom: 4px; position: relative; }
        .sidebar-link:hover { color: var(--text-main); background: var(--hover-bg); }
        .sidebar-link.active { color: var(--text-main); background: var(--hover-bg); border-left: 3px solid #83b765; }

        /* ANIMASI BADGE KIRI */
        @keyframes pop { 0% { transform: scale(0.8); opacity: 0; } 50% { transform: scale(1.2); opacity: 1; } 100% { transform: scale(1); opacity: 1; } }
        .badge-pop { animation: pop 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards; }
        
        /* =========================================
           TABS NAVIGATION (Menu Sheet)
           ========================================= */
        .tab-btn { padding: 8px 16px; font-size: 13px; cursor: pointer; white-space: nowrap; transition: all 0.25s ease; border-radius: 6px; color: var(--text-muted); font-weight: 500; background: transparent; border: 1px solid transparent; }
        .tab-active { background: var(--hover-bg) !important; color: var(--text-main) !important; border-color: var(--border-color) !important; }
        .tab-btn:hover:not(.tab-active) { color: var(--text-main); background: var(--hover-bg); }

        /* =========================================
           DATATABLES CUSTOMIZATION
           ========================================= */
        .dataTables_wrapper .dataTables_length, .dataTables_wrapper .dataTables_filter, .dataTables_wrapper .dataTables_info, .dataTables_wrapper .dataTables_paginate { color: var(--text-muted) !important; font-size: 12px; margin-top: 16px; margin-bottom: 24px; }
        .dataTables_wrapper select, .dataTables_wrapper .dataTables_filter input { background-color: var(--bg-main) !important; border: 1px solid var(--border-color) !important; color: var(--text-main) !important; padding: 6px 12px !important; border-radius: 6px !important; outline: none !important; transition: all 0.2s; }
        .dataTables_wrapper .dataTables_filter input:focus { border-color: #83b765 !important; }

        table.dataTable { border-collapse: collapse !important; border-spacing: 0 !important; margin-top: 12px !important; margin-bottom: 20px !important; width: 100% !important; border-bottom: 1px solid var(--border-color) !important; }
        table.dataTable thead th { background-color: var(--bg-card) !important; color: var(--text-muted) !important; border-bottom: 1px solid var(--border-color) !important; font-weight: 600; font-size: 11px; letter-spacing: 0.05em; padding: 14px 18px !important; text-transform: uppercase; white-space: nowrap !important; }
        table.dataTable tbody tr { background-color: transparent !important; transition: all 0.15s ease; }
        table.dataTable tbody tr:hover { background-color: var(--hover-bg) !important; }
        table.dataTable tbody td { border-bottom: 1px solid var(--border-color) !important; font-size: 13px; padding: 12px 18px !important; color: var(--text-main) !important; white-space: nowrap !important; vertical-align: middle !important; }

        .dataTables_wrapper .dataTables_paginate .paginate_button { background: transparent !important; border: 1px solid transparent !important; border-radius: 6px !important; color: var(--text-muted) !important; padding: 4px 10px !important; margin: 0 2px !important; transition: all 0.2s; }
        .dataTables_wrapper .dataTables_paginate .paginate_button:hover { background: var(--hover-bg) !important; color: var(--text-main) !important; }
        .dataTables_wrapper .dataTables_paginate .paginate_button.current { background: var(--hover-bg) !important; color: var(--text-main) !important; border-color: var(--border-color) !important; font-weight: 600; }

        /* =========================================
           ANIMATIONS & SCROLLBAR
           ========================================= */
        .fade-in { animation: fadeIn 0.4s ease forwards; }
        @keyframes fadeIn { from { opacity: 0; transform: translateY(4px); } to { opacity: 1; transform: translateY(0); } }

        ::-webkit-scrollbar { width: 6px; height: 8px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: var(--border-color); border-radius: 4px; }
        ::-webkit-scrollbar-thumb:hover { background: var(--text-muted); }

        /* Sub-tab buttons styling */
        .sub-tab-btn { padding: 8px 16px; font-size: 12px; font-weight: 600; border-radius: 8px; transition: all 0.2s; border: 1px solid transparent; }
        .sub-tab-active { background-color: rgba(59, 130, 246, 0.15); color: #60a5fa; border-color: rgba(59, 130, 246, 0.3); }
        .sub-tab-inactive { background-color: transparent; color: var(--text-muted); }
        .sub-tab-inactive:hover { background-color: var(--hover-bg); color: var(--text-main); }
    </style>
</head>
<body class="flex h-screen w-full theme-bg-main theme-text-main relative">

    <div id="sidebar-overlay" onclick="toggleSidebar()" class="fixed inset-0 bg-black/60 z-40 hidden md:hidden backdrop-blur-sm transition-opacity opacity-0 duration-300"></div>

    <aside id="mobile-sidebar" class="w-64 theme-bg-panel border-r theme-border flex flex-col h-full flex-shrink-0 z-50 fixed md:relative transform -translate-x-full md:translate-x-0 transition-transform duration-300">
        <div class="h-16 flex items-center px-6 border-b theme-border">
            <div class="flex items-center gap-3">
                <svg class="w-6 h-6 text-[#83b765]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path></svg>
                <div class="flex flex-col">
                    <h1 class="text-sm font-bold theme-text-main tracking-wide leading-tight">AGRINAS OPS</h1>
                    <span class="text-[10px] theme-text-muted">PT Agrinas Nusantara</span>
                </div>
            </div>
            <button onclick="toggleSidebar()" class="ml-auto md:hidden text-gray-400 hover:text-white focus:outline-none">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
            </button>
        </div>

        <div class="flex-1 overflow-y-auto py-5 px-3">
            <div class="text-[10px] font-bold theme-text-muted uppercase tracking-widest mb-3 px-3">Menu Utama</div>
            <button onclick="switchView('view-dashboard', 'nav-dashboard')" class="w-full sidebar-link active" id="nav-dashboard">
                <svg class="w-4 h-4 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"></path></svg> Dashboard On Farm
            </button>
            <button onclick="switchView('view-database', 'nav-database')" class="w-full sidebar-link" id="nav-database">
                <svg class="w-4 h-4 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4"></path></svg> Master Data Kebun
            </button>
            <button onclick="switchView('view-evaluasi', 'nav-evaluasi')" class="w-full sidebar-link" id="nav-evaluasi">
                <svg class="w-4 h-4 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path></svg> Evaluasi Kinerja
            </button>
            <button onclick="switchView('view-inbox', 'nav-inbox')" class="w-full sidebar-link" id="nav-inbox">
                <svg class="w-4 h-4 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg> Inbox Email
                <span id="sidebar-email-badge" class="absolute right-3 bg-red-500 text-white text-[10px] font-bold px-2 py-0.5 rounded-full hidden">0</span>
            </button>
        </div>

        <div class="p-4 border-t theme-border theme-bg-main transition-colors duration-300">
            <div class="flex items-center gap-3">
                <div class="w-8 h-8 rounded-full border theme-border flex items-center justify-center text-xs font-bold theme-text-main" style="background-color: var(--hover-bg);">PIC</div>
                <div class="flex flex-col overflow-hidden">
                    <span class="text-xs font-semibold theme-text-main truncate">Staf PIC HO</span>
                    <span class="text-[10px] theme-text-muted truncate">staf.pic.ho@agrinas.id</span>
                </div>
            </div>
        </div>
    </aside>

    <div class="flex-1 flex flex-col h-full overflow-hidden theme-bg-main transition-colors duration-300">
        <header class="h-16 theme-bg-panel border-b theme-border flex items-center justify-between px-4 md:px-6 z-10 flex-shrink-0 transition-colors duration-300">
            <div class="flex items-center text-sm font-medium theme-text-muted min-w-0">
                <button onclick="toggleSidebar()" class="md:hidden mr-3 p-2 -ml-2 rounded-lg theme-text-muted hover:bg-[var(--hover-bg)] focus:outline-none shrink-0">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
                </button>
                <svg class="w-4 h-4 mr-2 shrink-0 hidden sm:block" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
                <span id="header-title" class="truncate max-w-[130px] sm:max-w-xs md:max-w-md">Executive On-Farm > Dashboard</span>
            </div>

            <div class="flex items-center gap-2 md:gap-4 shrink-0">
                <button onclick="toggleTheme()" class="relative p-2 theme-text-muted hover:text-[var(--text-main)] transition-colors focus:outline-none" title="Ganti Tema">
                    <svg id="theme-icon" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
                </button>
                <div class="w-px h-5 theme-border border-l"></div>
                <div class="flex items-center gap-2 text-[10px] font-semibold text-emerald-500 bg-emerald-500/10 px-2.5 py-1.5 md:px-3 rounded-full border border-emerald-500/20">
                    <span id="sync-dot" class="relative flex h-1.5 w-1.5"><span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span><span class="relative inline-flex rounded-full h-1.5 w-1.5 bg-emerald-500"></span></span>
                    <span id="sync-text" class="hidden sm:inline">LIVE SYSTEM</span>
                </div>
                <div class="w-px h-5 theme-border border-l hidden sm:block"></div>
                <div class="relative group">
                    <button onclick="markAsRead()" class="relative p-2 theme-text-muted hover:text-[var(--text-main)] transition-colors focus:outline-none z-50">
                        <span id="notif-badge" class="absolute top-1.5 right-1.5 w-2 h-2 bg-red-500 rounded-full hidden"></span>
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"></path></svg>
                    </button>
                    <div class="absolute right-0 mt-2 w-72 sm:w-80 md:w-96 premium-dropdown rounded-xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 flex flex-col max-h-[450px]">
                        <div class="px-5 py-3 premium-dropdown-header rounded-t-xl flex justify-between items-center"><span class="text-[11px] font-bold theme-text-muted uppercase tracking-widest">Audit Trail Database</span></div>
                        <div id="notif-list" class="p-3 overflow-y-auto flex-grow text-left"></div>
                    </div>
                </div>
            </div>
        </header>

        <main class="flex-1 overflow-y-auto p-4 md:p-6 lg:p-8">
            
            <!-- 1. DASHBOARD PIVOT UTAMA -->
            <section id="view-dashboard" class="fade-in block">
                <div class="mb-6 flex flex-col sm:flex-row sm:justify-between sm:items-end gap-4">
                    <div>
                        <h2 class="text-xl md:text-2xl font-bold theme-text-main tracking-tight">Dashboard Summary</h2>
                        <p class="text-[10px] md:text-[11px] theme-text-muted mt-1 flex items-center gap-1">
                            <svg class="w-3 h-3 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg> Data dikalkulasi akurat otomatis Vercel Auto-Sync.
                        </p>
                    </div>
                    <div class="flex items-center justify-between sm:justify-start gap-3 theme-bg-panel border theme-border px-4 py-2 rounded-lg shadow-sm">
                        <span class="text-[10px] md:text-[11px] font-bold theme-text-muted uppercase tracking-widest">Filter CRO:</span>
                        <select id="cro-filter" onchange="renderPivotDashboard()" class="bg-transparent theme-text-main text-xs md:text-sm font-semibold outline-none cursor-pointer">
                            <option value="ALL" class="bg-[#111111] text-white">Semua CRO</option>
                        </select>
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-4 md:gap-5 mb-8" id="pivot-kpi-container"></div>

                <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 md:gap-5 mb-8">
                    <div class="premium-card p-4 md:p-6 w-full">
                        <h3 id="chart-title-bar" class="text-[10px] font-bold theme-text-muted uppercase tracking-widest mb-4">Target Produksi (Ton) per CRO</h3>
                        <div id="pivot-bar-chart" style="height: 300px; width: 100%;"></div>
                    </div>
                    <div class="premium-card p-4 md:p-6 w-full">
                        <h3 id="chart-title-pie" class="text-[10px] font-bold theme-text-muted uppercase tracking-widest mb-4">Luas Kebun (Ha) per CRO</h3>
                        <div id="pivot-pie-chart" style="height: 300px; width: 100%;"></div>
                    </div>
                </div>

                <div class="premium-card p-4 md:p-6 mt-5 w-full">
                    <h3 id="pt-list-title" class="text-[10px] font-bold theme-text-muted uppercase tracking-widest mb-4">Daftar Perusahaan (PT)</h3>
                    <div class="overflow-x-auto">
                        <table class="w-full text-left border-collapse min-w-[600px]">
                            <thead>
                                <tr>
                                    <th class="border-b theme-border py-3 px-4 text-[10px] theme-text-muted uppercase">Nama Perusahaan (PT)</th>
                                    <th class="border-b theme-border py-3 px-4 text-[10px] theme-text-muted uppercase text-right">Luas Kebun (Ha)</th>
                                    <th class="border-b theme-border py-3 px-4 text-[10px] theme-text-muted uppercase text-right">Luas TM (Ha)</th>
                                    <th class="border-b theme-border py-3 px-4 text-[10px] theme-text-muted uppercase text-right">Target Produksi (Ton)</th>
                                </tr>
                            </thead>
                            <tbody id="pt-list-body"></tbody>
                        </table>
                    </div>
                </div>
            </section>

            <!-- 2. MASTER DATA KEBUN -->
            <section id="view-database" class="fade-in hidden">
                <div class="mb-6">
                    <h2 class="text-xl md:text-2xl font-bold theme-text-main tracking-tight">Master Data Repository</h2>
                    <p class="text-xs md:text-sm theme-text-muted mt-1">Eksplorasi arsip dokumen dan database terpusat.</p>
                </div>
                <div class="premium-card p-4 md:p-6 w-full">
                    <div id="tab-container" class="flex space-x-2 overflow-x-auto pb-4 mb-4 border-b theme-border scrollbar-thin"></div>
                    <div class="w-full overflow-hidden" id="data-wrapper">
                        <div id="table-area" class="w-full">
                            <div id="custom-filter-container" class="mb-4 hidden flex items-center gap-3 theme-bg-panel border theme-border px-4 py-2 rounded-lg shadow-sm w-fit"></div>
                            <table id="mainTable" class="w-full text-left"></table>
                        </div>
                        <div id="pivot-area" class="hidden w-full h-[700px] border theme-border rounded-lg overflow-hidden bg-white shadow-inner">
                            <iframe src="https://docs.google.com/spreadsheets/d/1JNPHD-Vg1YjN84z0aVHFiNXhLLQ86ARNCb2MMo5s5iY/edit?gid=2130529003#gid=2130529003&rm=minimal" class="w-full h-full border-none"></iframe>
                        </div>
                    </div>
                </div>
            </section>

            <!-- 3. EVALUASI KINERJA (SHEET 2) -->
            <section id="view-evaluasi" class="fade-in hidden">
                <div class="mb-6">
                    <h2 class="text-xl md:text-2xl font-bold theme-text-main tracking-tight">Evaluasi Kinerja Produksi</h2>
                    <p class="text-xs md:text-sm theme-text-muted mt-1">Analisis dan evaluasi data pra & setelah penugasan dari dokumen viewer.</p>
                </div>

                <div class="premium-card p-4 md:p-6 w-full">
                    <!-- TABS UTAMA EVALUASI KINERJA -->
                    <div id="evaluasi-tab-container" class="flex space-x-2 overflow-x-auto pb-4 mb-4 border-b theme-border scrollbar-thin"></div>
                    
                    <div class="w-full overflow-hidden" id="evaluasi-data-wrapper">
                        
                        <!-- TABEL NORMAL EVALUASI -->
                        <div id="evaluasi-table-area" class="w-full">
                            <table id="evaluasiTable" class="w-full text-left"></table>
                        </div>
                        
                        <!-- DASHBOARD KHUSUS REKAP KEMITRAAN (DENGAN 4 BUTTON SUB-TABS) -->
                        <div id="evaluasi-dashboard-area" class="hidden w-full">
                            
                            <!-- 4 BUTTON SUB-TABS UNTUK REKAP KEMITRAAN -->
                            <div class="flex space-x-2 overflow-x-auto pb-2 mb-6 border-b theme-border">
                                <button id="btn-tahap1-5" onclick="setKemitraanTab('tahap1-5')" class="sub-tab-btn sub-tab-inactive">Tahap 1 - 5</button>
                                <button id="btn-tahap1-7" onclick="setKemitraanTab('tahap1-7')" class="sub-tab-btn sub-tab-active">Tahap 1 - 7</button>
                                <button id="btn-status-mitra" onclick="setKemitraanTab('status-mitra')" class="sub-tab-btn sub-tab-inactive">Status Mitra/Vendor</button>
                                <button id="btn-list-pt" onclick="setKemitraanTab('list-pt')" class="sub-tab-btn sub-tab-inactive">List Nama PT</button>
                            </div>

                            <div id="kemitraan-loading" class="text-center py-10 hidden">
                                <p class="text-sm theme-text-muted animate-pulse">Menghitung Data Akurat...</p>
                            </div>

                            <!-- AREA KONTEN REKAP KEMITRAAN -->
                            <div id="kemitraan-content-box">
                                <div class="grid grid-cols-1 md:grid-cols-3 gap-4 md:gap-5 mb-8" id="kemitraan-kpi-container"></div>
                                <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 md:gap-5 mb-8" id="kemitraan-chart-container">
                                    <div class="premium-card p-4 md:p-6 w-full">
                                        <h3 id="kemitraan-bar-title" class="text-[10px] font-bold theme-text-muted uppercase tracking-widest mb-4">Sebaran Jumlah PT per CRO</h3>
                                        <div id="kemitraan-bar-chart" style="height: 300px; width: 100%;"></div>
                                    </div>
                                    <div class="premium-card p-4 md:p-6 w-full" id="kemitraan-pie-card">
                                        <h3 class="text-[10px] font-bold theme-text-muted uppercase tracking-widest mb-4">Status Pengelolaan PT (%)</h3>
                                        <div id="kemitraan-pie-chart" style="height: 300px; width: 100%;"></div>
                                    </div>
                                </div>
                                <div class="premium-card p-4 md:p-6 mt-5 w-full">
                                    <h3 id="kemitraan-table-title" class="text-[10px] font-bold theme-text-muted uppercase tracking-widest mb-4">Rekap Kemitraan per Wilayah</h3>
                                    <div class="overflow-x-auto">
                                        <table class="w-full text-left border-collapse min-w-[700px]">
                                            <thead id="kemitraan-list-head"></thead>
                                            <tbody id="kemitraan-list-body"></tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            </section>

            <!-- 4. INBOX EMAIL -->
            <section id="view-inbox" class="fade-in hidden">
                <div class="mb-6 flex flex-col sm:flex-row sm:justify-between sm:items-end gap-4">
                    <div>
                        <h2 class="text-xl md:text-2xl font-bold theme-text-main tracking-tight flex items-center gap-2">Inbox Email Terpusat</h2>
                        <p class="text-xs md:text-sm theme-text-muted mt-1">Pusat penerimaan draft, review dokumen, dan notifikasi vendor.</p>
                    </div>
                </div>
                <div class="premium-card overflow-hidden w-full">
                    <div class="flex items-center justify-between px-4 md:px-6 py-4 border-b theme-border bg-black/10">
                        <span class="text-[10px] md:text-xs font-semibold theme-text-muted">Kotak Masuk (Gmail API Sync)</span>
                        <button class="text-[10px] md:text-xs text-blue-500 hover:underline font-medium">Tandai semua dibaca</button>
                    </div>
                    <div id="email-list-container" class="divide-y theme-border flex flex-col max-h-[600px] overflow-y-auto"></div>
                </div>
            </section>
        </main>
    </div>

    <!-- MODAL PREVIEW -->
    <div id="previewModal" class="fixed inset-0 z-50 flex items-center justify-center bg-black/80 backdrop-blur-sm hidden transition-all duration-300 opacity-0 z-[9999]">
        <div class="theme-bg-panel border theme-border rounded-xl w-11/12 md:w-4/5 h-[85vh] flex flex-col shadow-2xl transform scale-95 transition-transform duration-300" id="modalContent">
            <div class="flex justify-between items-center px-4 md:px-5 py-4 border-b theme-border">
                <h3 class="theme-text-main font-medium text-xs md:text-sm flex items-center gap-2">
                    <svg class="w-4 h-4 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path></svg> Live Document Viewer
                </h3>
                <div class="flex items-center space-x-3 md:space-x-4">
                    <a id="modalExternalLink" href="#" target="_blank" class="text-[10px] md:text-xs text-blue-400 hover:text-blue-300 font-medium transition-colors flex items-center gap-1.5">Open in Drive <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg></a>
                    <div class="w-px h-4 bg-gray-500"></div>
                    <button onclick="closePreview()" class="theme-text-muted hover:text-red-500 transition-colors"><svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg></button>
                </div>
            </div>
            <div class="flex-grow bg-white rounded-b-xl overflow-hidden"><iframe id="documentIframe" src="" class="w-full h-full border-none"></iframe></div>
        </div>
    </div>

    <!-- SCRIPT LOGIC -->
    <script>
        let rawData = <%- sheetData %> || {};
        let logsData = <%- logsData %> || []; 
        let emailsData = <%- emailsData %> || []; 
        
        const listSheets = ["REKAPITULASI", "Pivot Table", "Pembayaran Vendor", "Draft Surat Penugasan", "INPUT ASTA", "Acuan Nama Kebun", "Acuan Nama CRO & Region", "Perubahan CV ke PT", "Rekap Vendor"];
        const listEvaluasiSheets = ["Sumber/Source Data", "Kinerja Prod", "Rekap Kemitraan", "Rekapan", "Executive Summary"];
        
        let currentDataTable = null;
        let evaluasiDataTable = null;
        let isUnread = false; 
        
        // Tab aktif default untuk Rekap Kemitraan
        let activeKemitraanTab = 'tahap1-7';

        function toggleSidebar() {
            const sidebar = document.getElementById('mobile-sidebar');
            const overlay = document.getElementById('sidebar-overlay');
            if (sidebar.classList.contains('-translate-x-full')) {
                sidebar.classList.remove('-translate-x-full');
                overlay.classList.remove('hidden');
                setTimeout(() => overlay.classList.remove('opacity-0'), 10);
            } else {
                sidebar.classList.add('-translate-x-full');
                overlay.classList.add('opacity-0');
                setTimeout(() => overlay.classList.add('hidden'), 300);
            }
        }

        function toggleTheme() {
            document.body.classList.toggle('light-mode');
            const isLight = document.body.classList.contains('light-mode');
            localStorage.setItem('theme', isLight ? 'light' : 'dark');
            const themeIcon = document.getElementById('theme-icon');
            if (isLight) themeIcon.innerHTML = `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"></path>`;
            else themeIcon.innerHTML = `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path>`;
            updateChartTheme(isLight);
        }

        function updateChartTheme(isLight) {
            const textColor = isLight ? '#6b7280' : '#a1a1aa';
            const gridColor = isLight ? '#e5e7eb' : '#262626';
            const tooltipBg = isLight ? '#ffffff' : '#151515';
            const tooltipText = isLight ? '#1f2937' : '#f8fafc';
            Highcharts.charts.forEach(chart => {
                if (chart) {
                    chart.update({
                        xAxis: { labels: { style: { color: textColor } } },
                        yAxis: { labels: { style: { color: textColor } }, gridLineColor: gridColor },
                        legend: { itemStyle: { color: textColor } },
                        plotOptions: { pie: { dataLabels: { color: textColor } } },
                        tooltip: { backgroundColor: tooltipBg, style: { color: tooltipText }, borderColor: gridColor }
                    });
                }
            });
        }

        function switchView(viewId, elementId) {
            document.getElementById('view-dashboard').classList.add('hidden');
            document.getElementById('view-database').classList.add('hidden');
            document.getElementById('view-evaluasi').classList.add('hidden');
            document.getElementById('view-inbox').classList.add('hidden');
            
            document.getElementById(viewId).classList.remove('hidden');
            
            const headerTitle = document.getElementById('header-title');
            if(viewId === 'view-dashboard') headerTitle.innerText = "Executive On-Farm > Dashboard";
            else if(viewId === 'view-database') headerTitle.innerText = "Executive On-Farm > Master Data";
            else if(viewId === 'view-evaluasi') headerTitle.innerText = "Executive On-Farm > Evaluasi Kinerja";
            else if(viewId === 'view-inbox') {
                headerTitle.innerText = "Executive On-Farm > Inbox Email";
            }
            
            document.getElementById('nav-dashboard').classList.remove('active');
            document.getElementById('nav-database').classList.remove('active');
            document.getElementById('nav-evaluasi').classList.remove('active');
            document.getElementById('nav-inbox').classList.remove('active');
            document.getElementById(elementId).classList.add('active');
            
            if (window.innerWidth < 768) toggleSidebar();
            if(viewId === 'view-database' && currentDataTable) setTimeout(() => currentDataTable.columns.adjust(), 50);
            
            const activeEvalTab = document.querySelector('#evaluasi-tab-container .tab-active');
            if(viewId === 'view-evaluasi' && evaluasiDataTable && activeEvalTab && activeEvalTab.dataset.sheet !== "Rekap Kemitraan") { 
                setTimeout(() => evaluasiDataTable.columns.adjust(), 50);
            }
        }

        function markAsRead() { document.getElementById('notif-badge').classList.add('hidden'); isUnread = false; }

        function renderEmailsUI() {
            const container = document.getElementById('email-list-container');
            let html = '';
            if(emailsData && emailsData.length > 0) {
                emailsData.forEach(email => {
                    const bgClass = email.unread ? 'bg-blue-500/5' : 'hover:bg-[var(--hover-bg)]';
                    const textSenderClass = email.unread ? 'font-bold text-white' : 'font-medium theme-text-main';
                    const textSubjectClass = email.unread ? 'font-bold text-white' : 'font-medium theme-text-main';
                    const dotClass = email.unread ? '<div class="w-2 h-2 bg-blue-500 rounded-full mr-2 md:mr-3 shrink-0"></div>' : '<div class="w-2 h-2 mr-2 md:mr-3 shrink-0"></div>';
                    let badgeColor = email.label === "SUDAH DI CRO" ? "bg-emerald-500/10 text-emerald-400 border-emerald-500/20" : "bg-amber-500/10 text-amber-400 border-amber-500/20";
                    html += `<div class="email-row flex flex-col md:flex-row md:items-center justify-between px-4 md:px-6 py-4 cursor-pointer transition-colors border-b theme-border last:border-0 ${bgClass} gap-3 md:gap-0"><div class="flex items-center gap-3 md:gap-4 min-w-0 pr-0 md:pr-4">${dotClass}<div class="w-8 h-8 md:w-10 md:h-10 rounded-full bg-[var(--hover-bg)] border theme-border flex items-center justify-center text-xs font-bold theme-text-main shrink-0">${email.sender.charAt(0)}</div><div class="min-w-0"><div class="flex items-center gap-2 mb-0.5 md:mb-1"><span class="email-sender text-[11px] md:text-xs truncate ${textSenderClass}">${email.sender}</span><span class="text-[9px] md:text-[10px] theme-text-muted shrink-0">• ${email.time}</span></div><h4 class="email-subject text-xs md:text-sm truncate mb-0.5 ${textSubjectClass}">${email.subject}</h4><p class="text-[10px] md:text-xs theme-text-muted truncate">${email.snippet}</p></div></div><div class="shrink-0 flex items-center pl-10 md:pl-0"><span class="text-[10px] md:text-xs font-semibold px-2 py-1 md:px-3 md:py-1.5 rounded-lg border ${badgeColor}">${email.label}</span></div></div>`;
                });
            } else { html = `<div class="p-8 text-center text-sm theme-text-muted">Tidak ada email masuk.</div>`; }
            if(container) container.innerHTML = html;
        }

        function renderNotifications() {
            const listContainer = document.getElementById('notif-list');
            const badge = document.getElementById('notif-badge');
            if (logsData && logsData.length > 0) {
                if (isUnread && badge) badge.classList.remove('hidden'); 
                let html = '';
                logsData.forEach(log => {
                    html += `<div class="mb-3 pb-3 border-b theme-border last:border-0 last:mb-0 last:pb-0"><div class="flex justify-between items-center mb-1"><span class="text-[10px] font-semibold text-blue-500 uppercase tracking-wider">${log.sheet}</span><div class="flex items-center gap-1 text-[10px] theme-text-muted">${log.waktu}</div></div><div class="text-xs theme-text-muted mb-2">Row <span class="theme-text-main font-medium">${log.baris}</span>, Col <span class="theme-text-main font-medium">${log.kolom}</span></div><div class="text-xs theme-bg-main border theme-border rounded py-1.5 px-2"><div class="flex items-center gap-2 theme-text-muted line-through mb-1"><span class="truncate">${log.lama}</span></div><div class="flex items-center gap-2 text-emerald-500"><span class="truncate">${log.baru}</span></div></div></div>`;
                });
                if(listContainer) listContainer.innerHTML = html;
            } else {
                if(listContainer) listContainer.innerHTML = `<div class="flex flex-col items-center justify-center py-8 text-center"><p class="text-xs theme-text-muted font-medium">Belum ada perubahan data.</p></div>`;
            }
        }

        function renderPivotDashboard() {
            const filterDropdown = document.getElementById('cro-filter');
            const selectedCRO = filterDropdown ? filterDropdown.value : 'ALL';
            
            const rawRekapData = rawData["REKAPITULASI"] || [];
            let croList = new Set();
            let totalLuas = 0, totalLuasTM = 0, totalTarget = 0, totalPtCount = 0;
            let chartBarDataMap = {}, chartPieDataMap = {}, ptDataMap = {}; 

            const parseNum = (val) => {
                if (typeof val === 'number') return val;
                if (!val || val === '-' || String(val).trim() === '') return 0;
                let s = String(val).trim().replace(/Rp|\$|€| /gi, '');
                if (s.includes(',') && s.includes('.')) {
                    let lastComma = s.lastIndexOf(','); let lastDot = s.lastIndexOf('.');
                    if (lastComma > lastDot) s = s.replace(/\./g, '').replace(',', '.'); else s = s.replace(/,/g, '');
                } else if (s.includes(',')) {
                    if ((s.match(/,/g) || []).length > 1) s = s.replace(/,/g, ''); else if (s.length - s.lastIndexOf(',') <= 3) s = s.replace(',', '.'); else s = s.replace(/,/g, '');
                }
                return parseFloat(s) || 0;
            };

            let keyCRO = "CRO", keyPT = "Nama PT", keyLuas = "Luas Kebun (Ha)", keyLuasTM = "Luas TM (Ha)", keyTarget = "Target Produksi (Ton)";
            if (rawRekapData.length > 0) {
                const sampleKeys = Object.keys(rawRekapData[0]);
                keyCRO = sampleKeys.find(k => k.toLowerCase() === 'cro' || k.toLowerCase().includes('cro')) || "CRO";
                keyPT = sampleKeys.find(k => k.toLowerCase().includes('nama pt') || k.toLowerCase().includes('perusahaan')) || "Nama PT";
                keyLuas = sampleKeys.find(k => k.toLowerCase().includes('luas kebun')) || "Luas Kebun (Ha)";
                keyLuasTM = sampleKeys.find(k => k.toLowerCase().includes('luas tm')) || "Luas TM (Ha)";
                keyTarget = sampleKeys.find(k => k.toLowerCase().includes('target produksi') || k.toLowerCase().includes('target')) || "Target Produksi (Ton)";
            }

            rawRekapData.forEach(row => {
                let rowCRO = String(row[keyCRO] || "").replace(/^[+-]\s*/, '').trim();
                let namaPt = String(row[keyPT] || "").trim();

                if (!rowCRO || rowCRO === "-" || rowCRO.toLowerCase().includes("total") || rowCRO.toLowerCase().includes("summary")) return;
                if (!namaPt || namaPt === "-" || namaPt.toLowerCase().includes("total") || namaPt.toLowerCase().includes("summary")) return;

                croList.add(rowCRO);
                if (selectedCRO !== 'ALL' && rowCRO !== selectedCRO) return;

                let luasKebun = parseNum(row[keyLuas]); let luasTM = parseNum(row[keyLuasTM]); let targetProd = parseNum(row[keyTarget]);
                totalLuas += luasKebun; totalLuasTM += luasTM; totalTarget += targetProd; totalPtCount++; 

                if (!ptDataMap[namaPt]) ptDataMap[namaPt] = { cro: rowCRO, luas: 0, luasTM: 0, target: 0 };
                ptDataMap[namaPt].luas += luasKebun; ptDataMap[namaPt].luasTM += luasTM; ptDataMap[namaPt].target += targetProd;
                chartBarDataMap[rowCRO] = (chartBarDataMap[rowCRO] || 0) + targetProd;
                chartPieDataMap[rowCRO] = (chartPieDataMap[rowCRO] || 0) + luasKebun;
            });

            if (filterDropdown && filterDropdown.options.length <= 1) {
                [...croList].sort().forEach(c => {
                    let opt = document.createElement('option'); opt.value = c; opt.innerText = c; opt.className = "bg-[#111111] text-white"; filterDropdown.appendChild(opt);
                });
            }

            const kpiContainer = document.getElementById('pivot-kpi-container');
            if(kpiContainer) {
                kpiContainer.innerHTML = `
                    <div class="premium-card p-4 md:p-5 border-t-4 border-t-blue-500 relative group"><div class="text-[9px] md:text-[10px] theme-text-muted font-bold uppercase tracking-widest mb-1">Total Target Produksi</div><div class="text-2xl md:text-3xl font-bold theme-text-main mb-1">${totalTarget.toLocaleString('id-ID', {maximumFractionDigits: 2})} Ton</div><div class="text-[9px] md:text-[10px] theme-text-muted italic opacity-60">(Data Kalkulasi Akurat)</div></div>
                    <div class="premium-card p-4 md:p-5 border-t-4 border-t-purple-500 relative group"><div class="text-[9px] md:text-[10px] theme-text-muted font-bold uppercase tracking-widest mb-1">Total Luas Kebun / Luas TM</div><div class="flex items-baseline gap-1 md:gap-2 mb-1"><div class="text-2xl md:text-3xl font-bold theme-text-main">${totalLuas.toLocaleString('id-ID', {maximumFractionDigits: 2})} <span class="text-sm md:text-lg">Ha</span></div></div><div class="text-[9px] md:text-[10px] font-medium text-purple-400 italic">Luas TM: ${totalLuasTM.toLocaleString('id-ID', {maximumFractionDigits: 2})} Ha</div></div>
                    <div class="premium-card p-4 md:p-5 border-t-4 border-t-orange-500 relative group"><div class="text-[9px] md:text-[10px] theme-text-muted font-bold uppercase tracking-widest mb-1">Total Kemitraan PT</div><div class="text-2xl md:text-3xl font-bold theme-text-main mb-1">${totalPtCount} PT</div><div class="text-[9px] md:text-[10px] theme-text-muted italic opacity-60">(Data Kalkulasi Akurat)</div></div>
                `;
            }

            const titleSuffix = selectedCRO === 'ALL' ? 'per CRO' : `(Regional ${selectedCRO})`;
            if(document.getElementById('chart-title-bar')) document.getElementById('chart-title-bar').innerText = `Target Produksi (Ton) ${titleSuffix}`;
            if(document.getElementById('chart-title-pie')) document.getElementById('chart-title-pie').innerText = `Luas Kebun (Ha) ${titleSuffix}`;
            if(document.getElementById('pt-list-title')) document.getElementById('pt-list-title').innerText = `Daftar Perusahaan (PT) ${selectedCRO !== 'ALL' ? '- ' + selectedCRO : ''}`;

            if(document.getElementById('pivot-bar-chart')) {
                Highcharts.chart('pivot-bar-chart', {
                    chart: { type: 'column', backgroundColor: 'transparent' }, title: { text: null },
                    tooltip: { backgroundColor: 'var(--bg-card)', style: { color: 'var(--text-main)' }, borderWidth: 1, borderColor: 'var(--border-color)', borderRadius: 8 },
                    xAxis: { categories: Object.keys(chartBarDataMap), labels: { style: { color: 'var(--text-muted)' } }, lineWidth: 0, tickWidth: 0 },
                    yAxis: { title: { text: null }, gridLineColor: 'var(--border-color)', labels: { style: { color: 'var(--text-muted)' } } },
                    series: [{ name: 'Target Produksi (Ton)', data: Object.values(chartBarDataMap), color: '#3b82f6' }],
                    plotOptions: { column: { borderRadius: 4, borderWidth: 0 } }, credits: { enabled: false }
                });
            }

            if(document.getElementById('pivot-pie-chart')) {
                Highcharts.chart('pivot-pie-chart', {
                    chart: { type: 'pie', backgroundColor: 'transparent' }, title: { text: null },
                    tooltip: { backgroundColor: 'var(--bg-card)', style: { color: 'var(--text-main)' }, borderWidth: 1, borderColor: 'var(--border-color)', borderRadius: 8 },
                    plotOptions: { pie: { innerSize: '65%', borderWidth: 0, dataLabels: { enabled: true, color: 'var(--text-muted)', connectorColor: 'var(--border-color)', style: { textOutline: 'none', fontWeight: 'normal' } } } },
                    series: [{ name: 'Luas Kebun (Ha)', data: Object.keys(chartPieDataMap).map(k => [k, chartPieDataMap[k]]) }], credits: { enabled: false }
                });
            }
            
            let ptHtml = '';
            let sortedPTs = Object.keys(ptDataMap).map(k => ({name: k, ...ptDataMap[k]})).sort((a,b) => b.target - a.target);
            if (sortedPTs.length > 0) {
                sortedPTs.forEach(pt => {
                    ptHtml += `
                        <tr class="hover:bg-[var(--hover-bg)] transition-colors border-b theme-border last:border-0">
                            <td class="py-2 md:py-3 px-3 md:px-4 text-[11px] md:text-sm theme-text-main font-medium">${pt.name} ${selectedCRO === 'ALL' ? `<span class="ml-1 md:ml-2 text-[9px] md:text-[10px] theme-text-muted bg-[var(--bg-main)] px-1.5 md:px-2 py-0.5 rounded border theme-border whitespace-nowrap">${pt.cro}</span>` : ''}</td>
                            <td class="py-2 md:py-3 px-3 md:px-4 text-[11px] md:text-sm theme-text-main text-right">${pt.luas.toLocaleString('id-ID', {maximumFractionDigits: 2})}</td>
                            <td class="py-2 md:py-3 px-3 md:px-4 text-[11px] md:text-sm text-purple-400 text-right">${pt.luasTM.toLocaleString('id-ID', {maximumFractionDigits: 2})}</td>
                            <td class="py-2 md:py-3 px-3 md:px-4 text-[11px] md:text-sm theme-text-main text-right font-semibold">${pt.target.toLocaleString('id-ID', {maximumFractionDigits: 2})}</td>
                        </tr>`;
                });
            } else { ptHtml = `<tr><td colspan="4" class="py-6 text-center text-[11px] md:text-sm theme-text-muted">Tidak ada data perusahaan.</td></tr>`; }
            if(document.getElementById('pt-list-body')) document.getElementById('pt-list-body').innerHTML = ptHtml;
            const isLightNow = document.body.classList.contains('light-mode'); updateChartTheme(isLightNow);
        }

        // =========================================
        // FUNGSI KHUSUS: DASHBOARD REKAP KEMITRAAN DENGAN 4 BUTTON TABS
        // =========================================
        function setKemitraanTab(tabId) {
            activeKemitraanTab = tabId;
            
            // Update UI Button
            ['tahap1-5', 'tahap1-7', 'status-mitra', 'list-pt'].forEach(id => {
                const btn = document.getElementById('btn-' + id);
                if (btn) {
                    if (id === tabId) {
                        btn.className = 'sub-tab-btn sub-tab-active';
                    } else {
                        btn.className = 'sub-tab-btn sub-tab-inactive';
                    }
                }
            });
            
            renderKemitraanDashboard();
        }

        function renderKemitraanDashboard() {
            const kpiContainer = document.getElementById('kemitraan-kpi-container');
            const chartContainer = document.getElementById('kemitraan-chart-container');
            const tableTitle = document.getElementById('kemitraan-table-title');
            const tableHead = document.getElementById('kemitraan-list-head');
            const tableBody = document.getElementById('kemitraan-list-body');
            
            // Trik Ambil Nama Sheet Anti-Spasi
            let sheetName = Object.keys(rawData).find(k => k.trim() === "Rekap Kemitraan" || k.trim().includes("Rekap Kemitraan"));
            const rawRekapData = rawData[sheetName] || [];

            if (rawRekapData.length === 0) {
                if (kpiContainer) kpiContainer.innerHTML = `<div class="p-5 text-yellow-500 font-bold col-span-3">Sedang memproses data dari Server...</div>`;
                return;
            }

            // MENCARI INDEX POSISI TABEL YANG BENAR (Meskipun Header di Excel di Merge)
            let allKeys = Object.keys(rawRekapData[2] || rawRekapData[3] || rawRekapData[0]); 
            let regKeys = []; 

            // Cari tulisan 'Regional' di seluruh kolom yang ada
            for(let i=0; i<Math.min(15, rawRekapData.length); i++) {
                let rowKeys = Object.keys(rawRekapData[i]);
                let tempReg = [];
                rowKeys.forEach(k => {
                    if(String(rawRekapData[i][k]).toLowerCase().trim() === 'regional') tempReg.push(k);
                });
                if (tempReg.length > regKeys.length) {
                    regKeys = tempReg;
                    allKeys = rowKeys;
                }
                if(tempReg.length >= 4) break; // Kalo ketemu ke-4 tabelnya, stop.
            }

            // Tentukan target "Regional" berdasarkan Tab yg dipilih
            let baseRegionalKey = null;
            if (activeKemitraanTab === 'tahap1-5') baseRegionalKey = regKeys[0] || allKeys[1];
            if (activeKemitraanTab === 'tahap1-7') baseRegionalKey = regKeys[1] || allKeys[11];
            if (activeKemitraanTab === 'status-mitra') baseRegionalKey = regKeys[2] || allKeys[21];
            if (activeKemitraanTab === 'list-pt') baseRegionalKey = regKeys[3] || allKeys[32];

            let baseIdx = allKeys.indexOf(baseRegionalKey);
            if(baseIdx === -1 && regKeys.length > 0) baseIdx = allKeys.indexOf(regKeys[0]);

            let totalPT = 0, totalSudah = 0, totalBelum = 0;
            let totalCV = 0, totalKop = 0; 
            let chartBarMap = {}, chartPieMap = {};
            let summaryMap = {};
            let listPtArray = []; 

            let keyWil, keyJml, keySudah, keyBelum, keyPT, keyCV, keyKop, keyTahap, keyNamaPT, keyNamaMitra, keyStatus;
            
            // Scan 10 baris pertama untuk nyocokin headers spesifik di sekitar baseRegionalKey
            for(let i=0; i<Math.min(10, rawRekapData.length); i++) {
                let row = rawRekapData[i];
                for(let j=baseIdx; j < Math.min(baseIdx+12, allKeys.length); j++) {
                    let v = String(row[allKeys[j]]).trim().toLowerCase();
                    if(v === 'wilayah' && !keyWil) keyWil = allKeys[j];
                    if((v === 'jumlah pt' || v === 'jumlah') && !keyJml) keyJml = allKeys[j];
                    if(v === 'sudah dikelola' && !keySudah) keySudah = allKeys[j];
                    if(v === 'belum dikelola' && !keyBelum) keyBelum = allKeys[j];
                    if(v === 'pt' && !keyPT) keyPT = allKeys[j];
                    if(v === 'cv' && !keyCV) keyCV = allKeys[j];
                    if(v === 'koperasi' && !keyKop) keyKop = allKeys[j];
                    if(v === 'tahap' && !keyTahap) keyTahap = allKeys[j];
                    if(v === 'nama pt' && !keyNamaPT) keyNamaPT = allKeys[j];
                    if(v === 'nama mitra' && !keyNamaMitra) keyNamaMitra = allKeys[j];
                    if(v === 'status' && !keyStatus && j > baseIdx) keyStatus = allKeys[j]; 
                }
            }

            // ==========================================
            // LOOPING DATA UTAMA DARI BARIS KE-0 AGAR TIDAK ADA DATA YANG KE SKIP!
            // ==========================================
            for(let i=0; i<rawRekapData.length; i++) {
                let row = rawRekapData[i];
                let cro = String(row[baseRegionalKey] || "").replace(/^[+-]\s*/, '').trim();
                let wil = String(row[keyWil] || "").trim();

                // PERATURAN FILTER SUPER KETAT: Abaikan baris judul dan total.
                if(!cro || cro === "-" || cro.toLowerCase() === "regional" || cro.toLowerCase() === "no") continue;
                if(cro.toLowerCase().includes("total") || cro.toLowerCase().includes("summary") || cro.toLowerCase().includes("grand")) continue;

                if(cro.toLowerCase().startsWith('cro')) cro = cro.toUpperCase();
                else cro = "CRO " + cro.toUpperCase(); 

                // KALKULASI TAB TAHAP 1-5 & TAHAP 1-7
                if (activeKemitraanTab === 'tahap1-5' || activeKemitraanTab === 'tahap1-7') {
                    let jml = parseInt(String(row[keyJml]).replace(/[^0-9]/g,'')) || 0;
                    let sudah = parseInt(String(row[keySudah]).replace(/[^0-9]/g,'')) || 0;
                    let belum = parseInt(String(row[keyBelum]).replace(/[^0-9]/g,'')) || 0;

                    totalPT += jml; totalSudah += sudah; totalBelum += belum;
                    chartBarMap[cro] = (chartBarMap[cro] || 0) + jml;
                    
                    let k = cro + "_" + wil;
                    if(!summaryMap[k]) summaryMap[k] = {cro: cro, wil: wil, jml:0, sdh:0, blm:0};
                    summaryMap[k].jml += jml; summaryMap[k].sdh += sudah; summaryMap[k].blm += belum;
                }
                
                // KALKULASI TAB STATUS MITRA
                if (activeKemitraanTab === 'status-mitra') {
                    let jml = parseInt(String(row[keyJml]).replace(/[^0-9]/g,'')) || 0;
                    let pt = parseInt(String(row[keyPT]).replace(/[^0-9]/g,'')) || 0;
                    let cv = parseInt(String(row[keyCV]).replace(/[^0-9]/g,'')) || 0;
                    let kop = parseInt(String(row[keyKop]).replace(/[^0-9]/g,'')) || 0;

                    totalPT += jml; totalCV += cv; totalKop += kop;
                    chartBarMap[cro] = (chartBarMap[cro] || 0) + jml;

                    let k = cro + "_" + wil;
                    if(!summaryMap[k]) summaryMap[k] = {cro: cro, wil: wil, jml:0, pt:0, cv:0, kop:0};
                    summaryMap[k].jml += jml; summaryMap[k].pt += pt; summaryMap[k].cv += cv; summaryMap[k].kop += kop;
                }

                // TAB LIST NAMA PT
                if (activeKemitraanTab === 'list-pt') {
                    let tahap = String(row[keyTahap] || "").trim();
                    let npt = String(row[keyNamaPT] || "").trim();
                    let mitra = String(row[keyNamaMitra] || "").trim();
                    let stts = String(row[keyStatus] || "").trim();
                    if(npt && npt !== "-") {
                        listPtArray.push({ cro: cro, wil: wil, tahap: tahap, pt: npt, mitra: mitra, status: stts });
                    }
                }
            }

            // ==========================================
            // RENDERING UI BERDASARKAN TAB AKTIF
            // ==========================================
            if (activeKemitraanTab === 'tahap1-5' || activeKemitraanTab === 'tahap1-7') {
                chartContainer.classList.remove('hidden');
                document.getElementById('kemitraan-pie-card').classList.remove('hidden');
                
                let tabTtl = activeKemitraanTab === 'tahap1-5' ? "TAHAP 1 - 5" : "TAHAP 1 - 7";
                
                kpiContainer.innerHTML = `
                    <div class="premium-card p-4 md:p-5 border-t-4 border-t-yellow-500"><div class="text-[9px] md:text-[10px] theme-text-muted font-bold uppercase tracking-widest mb-1">Total Keseluruhan PT (${tabTtl})</div><div class="text-2xl md:text-3xl font-bold theme-text-main mb-1">${totalPT} PT</div></div>
                    <div class="premium-card p-4 md:p-5 border-t-4 border-t-blue-500"><div class="text-[9px] md:text-[10px] theme-text-muted font-bold uppercase tracking-widest mb-1">Total Sudah Dikelola</div><div class="text-2xl md:text-3xl font-bold text-blue-400 mb-1">${totalSudah} PT</div></div>
                    <div class="premium-card p-4 md:p-5 border-t-4 border-t-red-500"><div class="text-[9px] md:text-[10px] theme-text-muted font-bold uppercase tracking-widest mb-1">Total Belum Dikelola</div><div class="text-2xl md:text-3xl font-bold text-red-400 mb-1">${totalBelum} PT</div></div>
                `;

                tableTitle.innerText = `Rekap Kemitraan per Wilayah (${tabTtl})`;
                tableHead.innerHTML = `<tr><th class="border-b theme-border py-3 px-4 text-[10px] theme-text-muted uppercase text-center">No</th><th class="border-b theme-border py-3 px-4 text-[10px] theme-text-muted uppercase">Regional</th><th class="border-b theme-border py-3 px-4 text-[10px] theme-text-muted uppercase">Wilayah</th><th class="border-b theme-border py-3 px-4 text-[10px] theme-text-muted uppercase text-center">Jml PT</th><th class="border-b theme-border py-3 px-4 text-[10px] text-blue-500 font-bold uppercase text-center">Sudah</th><th class="border-b theme-border py-3 px-4 text-[10px] text-red-500 font-bold uppercase text-center">Belum</th><th class="border-b theme-border py-3 px-4 text-[10px] text-blue-500 font-bold uppercase text-center">% Sdh</th><th class="border-b theme-border py-3 px-4 text-[10px] text-red-500 font-bold uppercase text-center">% Blm</th></tr>`;
                
                let htm = '', no=1;
                Object.values(summaryMap).sort((a,b) => a.cro.localeCompare(b.cro) || a.wil.localeCompare(b.wil)).forEach(i => {
                    let ps = i.jml>0 ? Math.round((i.sdh/i.jml)*100) : 0;
                    let pb = i.jml>0 ? Math.round((i.blm/i.jml)*100) : 0;
                    htm += `<tr class="hover:bg-[var(--hover-bg)] border-b theme-border"><td class="py-2 px-4 text-xs text-center">${no++}</td><td class="py-2 px-4 text-xs font-semibold">${i.cro}</td><td class="py-2 px-4 text-xs">${i.wil}</td><td class="py-2 px-4 text-xs text-center font-bold">${i.jml}</td><td class="py-2 px-4 text-xs text-blue-400 text-center font-bold">${i.sdh}</td><td class="py-2 px-4 text-xs text-red-400 text-center font-bold">${i.blm}</td><td class="py-2 px-4 text-xs text-blue-400 text-center font-bold">${ps}%</td><td class="py-2 px-4 text-xs text-red-400 text-center font-bold">${pb}%</td></tr>`;
                });
                let psTot = totalPT>0 ? Math.round((totalSudah/totalPT)*100) : 0;
                let pbTot = totalPT>0 ? Math.round((totalBelum/totalPT)*100) : 0;
                htm += `<tr class="bg-[var(--hover-bg)] border-t border-[#83b765]"><td colspan="3" class="py-3 px-4 text-xs font-bold text-center uppercase">Grand Total</td><td class="py-3 px-4 text-xs text-center font-bold">${totalPT}</td><td class="py-3 px-4 text-xs text-blue-400 text-center font-bold">${totalSudah}</td><td class="py-3 px-4 text-xs text-red-400 text-center font-bold">${totalBelum}</td><td class="py-3 px-4 text-xs text-blue-400 text-center font-bold">${psTot}%</td><td class="py-3 px-4 text-xs text-red-400 text-center font-bold">${pbTot}%</td></tr>`;
                tableBody.innerHTML = htm;

                Highcharts.chart('kemitraan-bar-chart', { chart: { type: 'column', backgroundColor: 'transparent' }, title: { text: null }, xAxis: { categories: Object.keys(chartBarMap), labels: { style: { color: 'var(--text-muted)' } } }, yAxis: { title: { text: null }, gridLineColor: 'var(--border-color)', labels: { style: { color: 'var(--text-muted)' } } }, series: [{ name: 'Jumlah PT', data: Object.values(chartBarMap), color: '#8b5cf6' }], credits: { enabled: false } });
                Highcharts.chart('kemitraan-pie-chart', { chart: { type: 'pie', backgroundColor: 'transparent' }, title: { text: null }, plotOptions: { pie: { innerSize: '65%', borderWidth: 0, dataLabels: { color: 'var(--text-muted)' } } }, series: [{ name: 'Total PT', data: [{name: 'Sudah Dikelola', y: totalSudah, color: '#3b82f6'}, {name: 'Belum Dikelola', y: totalBelum, color: '#f43f5e'}] }], credits: { enabled: false } });

            } else if (activeKemitraanTab === 'status-mitra') {
                chartContainer.classList.remove('hidden');
                document.getElementById('kemitraan-pie-card').classList.add('hidden'); // Sembunyikan pie chart buat tab ini
                document.getElementById('kemitraan-bar-title').innerText = "Sebaran Jumlah PT per CRO (Status Mitra)";
                
                kpiContainer.innerHTML = `
                    <div class="premium-card p-4 md:p-5 border-t-4 border-t-yellow-500"><div class="text-[9px] md:text-[10px] theme-text-muted font-bold uppercase tracking-widest mb-1">Total Kemitraan PT</div><div class="text-2xl md:text-3xl font-bold theme-text-main mb-1">${totalPT} PT</div></div>
                    <div class="premium-card p-4 md:p-5 border-t-4 border-t-emerald-500"><div class="text-[9px] md:text-[10px] theme-text-muted font-bold uppercase tracking-widest mb-1">Total Mitra Berbentuk PT</div><div class="text-2xl md:text-3xl font-bold text-emerald-400 mb-1">${totalCV} PT</div></div>
                    <div class="premium-card p-4 md:p-5 border-t-4 border-t-indigo-500"><div class="text-[9px] md:text-[10px] theme-text-muted font-bold uppercase tracking-widest mb-1">Total Mitra Koperasi</div><div class="text-2xl md:text-3xl font-bold text-indigo-400 mb-1">${totalKop} Kop</div></div>
                `;

                tableTitle.innerText = "Rincian Status Mitra Pengelola";
                tableHead.innerHTML = `<tr><th class="border-b theme-border py-3 px-4 text-[10px] theme-text-muted uppercase text-center">No</th><th class="border-b theme-border py-3 px-4 text-[10px] theme-text-muted uppercase">Regional</th><th class="border-b theme-border py-3 px-4 text-[10px] theme-text-muted uppercase">Wilayah</th><th class="border-b theme-border py-3 px-4 text-[10px] theme-text-muted uppercase text-center">Jml PT</th><th class="border-b theme-border py-3 px-4 text-[10px] text-emerald-500 font-bold uppercase text-center">Bentuk PT</th><th class="border-b theme-border py-3 px-4 text-[10px] text-orange-500 font-bold uppercase text-center">Bentuk CV</th><th class="border-b theme-border py-3 px-4 text-[10px] text-indigo-500 font-bold uppercase text-center">Koperasi</th></tr>`;
                
                let htm = '', no=1, sumCvReal=0;
                Object.values(summaryMap).sort((a,b) => a.cro.localeCompare(b.cro) || a.wil.localeCompare(b.wil)).forEach(i => {
                    sumCvReal += i.cv;
                    htm += `<tr class="hover:bg-[var(--hover-bg)] border-b theme-border"><td class="py-2 px-4 text-xs text-center">${no++}</td><td class="py-2 px-4 text-xs font-semibold">${i.cro}</td><td class="py-2 px-4 text-xs">${i.wil}</td><td class="py-2 px-4 text-xs text-center font-bold">${i.jml}</td><td class="py-2 px-4 text-xs text-emerald-400 text-center font-bold">${i.pt}</td><td class="py-2 px-4 text-xs text-orange-400 text-center font-bold">${i.cv}</td><td class="py-2 px-4 text-xs text-indigo-400 text-center font-bold">${i.kop}</td></tr>`;
                });
                htm += `<tr class="bg-[var(--hover-bg)] border-t border-[#83b765]"><td colspan="3" class="py-3 px-4 text-xs font-bold text-center uppercase">Grand Total</td><td class="py-3 px-4 text-xs text-center font-bold">${totalPT}</td><td class="py-3 px-4 text-xs text-emerald-400 text-center font-bold">${totalCV}</td><td class="py-3 px-4 text-xs text-orange-400 text-center font-bold">${sumCvReal}</td><td class="py-3 px-4 text-xs text-indigo-400 text-center font-bold">${totalKop}</td></tr>`;
                tableBody.innerHTML = htm;

                Highcharts.chart('kemitraan-bar-chart', { chart: { type: 'column', backgroundColor: 'transparent' }, title: { text: null }, xAxis: { categories: Object.keys(chartBarMap), labels: { style: { color: 'var(--text-muted)' } } }, yAxis: { title: { text: null }, gridLineColor: 'var(--border-color)', labels: { style: { color: 'var(--text-muted)' } } }, series: [{ name: 'Jumlah PT', data: Object.values(chartBarMap), color: '#10b981' }], credits: { enabled: false } });

            } else if (activeKemitraanTab === 'list-pt') {
                chartContainer.classList.add('hidden'); // Gak butuh chart
                kpiContainer.innerHTML = `<div class="premium-card p-4 md:p-5 border-t-4 border-t-blue-500 col-span-3"><div class="text-[9px] md:text-[10px] theme-text-muted font-bold uppercase tracking-widest mb-1">Total Entri Nama PT</div><div class="text-2xl md:text-3xl font-bold text-blue-400 mb-1">${listPtArray.length} PT</div></div>`;
                
                tableTitle.innerText = "Database Lengkap List Nama PT";
                tableHead.innerHTML = `<tr><th class="border-b theme-border py-3 px-4 text-[10px] theme-text-muted uppercase text-center">No</th><th class="border-b theme-border py-3 px-4 text-[10px] theme-text-muted uppercase">Regional</th><th class="border-b theme-border py-3 px-4 text-[10px] theme-text-muted uppercase">Wilayah</th><th class="border-b theme-border py-3 px-4 text-[10px] theme-text-muted uppercase">Tahap</th><th class="border-b theme-border py-3 px-4 text-[10px] theme-text-muted uppercase">Nama PT</th><th class="border-b theme-border py-3 px-4 text-[10px] theme-text-muted uppercase">Nama Mitra</th><th class="border-b theme-border py-3 px-4 text-[10px] theme-text-muted uppercase">Status</th></tr>`;
                
                let htm = '', no=1;
                listPtArray.forEach(i => {
                    let stc = i.status.toLowerCase().includes('sudah') ? 'text-blue-400 font-bold' : 'text-red-400 font-bold';
                    htm += `<tr class="hover:bg-[var(--hover-bg)] border-b theme-border"><td class="py-2 px-4 text-xs text-center">${no++}</td><td class="py-2 px-4 text-xs font-semibold whitespace-nowrap">${i.cro}</td><td class="py-2 px-4 text-xs whitespace-nowrap">${i.wil}</td><td class="py-2 px-4 text-xs whitespace-nowrap">${i.tahap}</td><td class="py-2 px-4 text-xs font-semibold">${i.pt}</td><td class="py-2 px-4 text-xs">${i.mitra}</td><td class="py-2 px-4 text-xs ${stc}">${i.status}</td></tr>`;
                });
                tableBody.innerHTML = htm;
            }
            
            const isLightNow = document.body.classList.contains('light-mode'); updateChartTheme(isLightNow);
        }

        // FUNGSI MENDAPATKAN IKON FILE
        function getFileIcon(fileName) {
            const ext = fileName.toLowerCase();
            if (ext.includes('.pdf')) return `<svg class="w-4 h-4 text-red-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"></path></svg>`; 
            else if (ext.includes('.doc') || ext.includes('.docx')) return `<svg class="w-4 h-4 text-blue-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>`; 
            else return `<svg class="w-4 h-4 theme-text-muted shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"></path></svg>`; 
        }

        // BUKA MODAL PREVIEW
        function openPreview(rawUrl) {
            let previewUrl = rawUrl.trim();
            if (previewUrl.includes("drive.google.com/file/d/")) previewUrl = previewUrl.replace(/\/view.*/, '/preview'); 
            else if (previewUrl.includes("docs.google.com/document/d/") || previewUrl.includes("docs.google.com/spreadsheets/d/")) previewUrl = previewUrl.replace(/\/edit.*/, '/preview'); 
            
            document.getElementById('documentIframe').src = previewUrl;
            document.getElementById('modalExternalLink').href = rawUrl;
            
            const modal = document.getElementById('previewModal');
            const content = document.getElementById('modalContent');
            
            modal.classList.remove('hidden');
            setTimeout(() => { modal.classList.remove('opacity-0'); content.classList.remove('scale-95'); }, 10);
        }

        function closePreview() {
            const modal = document.getElementById('previewModal');
            const content = document.getElementById('modalContent');
            modal.classList.add('opacity-0'); content.classList.add('scale-95');
            setTimeout(() => { modal.classList.add('hidden'); document.getElementById('documentIframe').src = ""; }, 300);
        }

        // =========================================
        // RENDER TABEL MASTER DATA KEBUN
        // =========================================
        function loadTable(sheetName) {
            document.querySelectorAll('#tab-container .tab-btn').forEach(btn => { 
                btn.className = btn.dataset.sheet === sheetName ? 'tab-btn tab-active' : 'tab-btn tab-inactive'; 
            });
            
            const filterContainer = document.getElementById('custom-filter-container');
            if (sheetName === 'INPUT ASTA' && filterContainer) {
                filterContainer.classList.remove('hidden');
                filterContainer.innerHTML = `
                    <span class="text-[10px] md:text-[11px] font-bold theme-text-muted uppercase tracking-widest">Filter Status:</span>
                    <select id="asta-status-filter" class="bg-transparent theme-text-main text-xs md:text-sm font-semibold outline-none cursor-pointer">
                        <option value="" class="bg-[#111111] text-white">Semua Status</option>
                        <option value="Batal" class="bg-[#111111] text-white">Batal</option>
                        <option value="Input Asta" class="bg-[#111111] text-white">Input Asta</option>
                        <option value="TTD" class="bg-[#111111] text-white">TTD</option>
                    </select>
                `;
            } else if(filterContainer) {
                filterContainer.classList.add('hidden');
                filterContainer.innerHTML = '';
            }

            if (sheetName === "Pivot Table") {
                document.getElementById('table-area').classList.add('hidden');
                document.getElementById('pivot-area').classList.remove('hidden');
                return; 
            } 
            
            document.getElementById('table-area').classList.remove('hidden');
            document.getElementById('pivot-area').classList.add('hidden');

            const data = rawData[sheetName] || [];
            if ($.fn.DataTable.isDataTable('#mainTable')) { $('#mainTable').DataTable().destroy(); $('#mainTable').empty(); }
            
            if (data.length === 0) { 
                $('#mainTable').html(`<tbody><tr><td class="text-center py-12 theme-text-muted text-sm">Tidak ada data tersedia pada sheet ini.</td></tr></tbody>`); 
                return; 
            }

            const columns = Object.keys(data[0]).map(key => {
                return { title: key, data: key, defaultContent: "-", render: function(val) {
                    if (typeof val === 'string' && val.includes('|||')) {
                        const parts = val.split('|||');
                        return `<a href="javascript:void(0)" onclick="openPreview('${parts[1]}')" class="inline-flex items-center gap-2 theme-text-muted hover:text-blue-500 group transition-colors">${getFileIcon(parts[0])} <span class="group-hover:underline truncate max-w-[200px]" title="${parts[0]}">${parts[0]}</span></a>`;
                    }
                    else if(typeof val === 'string' && (val.includes('http://') || val.includes('https://'))) {
                        return `<a href="javascript:void(0)" onclick="openPreview('${val}')" class="inline-flex items-center gap-2 text-blue-500 hover:text-blue-400 group transition-colors"><svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg><span class="group-hover:underline">Buka Link</span></a>`;
                    }
                    if (typeof val === 'string' && val.includes('\n')) return val.replace(/\n/g, ' <span class="theme-text-muted opacity-50 mx-2">/</span> '); 
                    return val;
                }};
            });

            currentDataTable = $('#mainTable').DataTable({
                data: data, columns: columns, scrollX: true, pageLength: 10, ordering: false,
                language: { search: "", searchPlaceholder: "Cari Data...", lengthMenu: "Tampil _MENU_ baris", info: "Menampilkan _START_ - _END_ dari _TOTAL_ data", paginate: { previous: "Prev", next: "Next" } }
            });

            if (sheetName === 'INPUT ASTA') {
                $('#asta-status-filter').on('change', function() {
                    let val = $(this).val();
                    currentDataTable.search(val).draw();
                });
            }
        }

        // =========================================
        // FUNGSI RENDER EVALUASI KINERJA
        // =========================================
        function loadEvaluasiTable(sheetName) {
            document.querySelectorAll('#evaluasi-tab-container .tab-btn').forEach(btn => { 
                btn.className = btn.dataset.sheet === sheetName ? 'tab-btn tab-active' : 'tab-btn tab-inactive'; 
            });

            if (sheetName === "Rekap Kemitraan") {
                document.getElementById('evaluasi-table-area').classList.add('hidden');
                document.getElementById('evaluasi-dashboard-area').classList.remove('hidden');
                renderKemitraanDashboard(); 
                return; 
            } 
            
            document.getElementById('evaluasi-table-area').classList.remove('hidden');
            document.getElementById('evaluasi-dashboard-area').classList.add('hidden');

            // FITUR PENCARIAN NAMA SHEET DINAMIS (ANTI SPASI)
            let exactKey = Object.keys(rawData).find(k => k.trim().toLowerCase() === sheetName.trim().toLowerCase());
            const data = rawData[exactKey] || [];
            
            if ($.fn.DataTable.isDataTable('#evaluasiTable')) { 
                $('#evaluasiTable').DataTable().destroy(); 
                $('#evaluasiTable').empty(); 
            }
            
            if (data.length === 0) { 
                $('#evaluasiTable').html(`<tbody><tr><td class="text-center py-12 theme-text-muted text-sm">Sedang sinkronisasi data Viewer... Jika kosong, pastikan koneksi lancar.</td></tr></tbody>`); 
                return; 
            }

            const columns = Object.keys(data[0]).map(key => {
                let title = key;
                if (title.includes('__EMPTY')) title = ''; 
                return { 
                    title: title, data: key, defaultContent: "-", 
                    render: function(val) {
                        if (typeof val === 'number') {
                            if (val % 1 !== 0) return val.toLocaleString('id-ID', {maximumFractionDigits: 2});
                            return val.toLocaleString('id-ID');
                        }
                        if (typeof val === 'string' && val.includes('|||')) {
                            const parts = val.split('|||');
                            return `<a href="javascript:void(0)" onclick="openPreview('${parts[1]}')" class="inline-flex items-center gap-2 theme-text-muted hover:text-blue-500 group transition-colors">${getFileIcon(parts[0])} <span class="group-hover:underline truncate max-w-[200px]" title="${parts[0]}">${parts[0]}</span></a>`;
                        }
                        else if(typeof val === 'string' && (val.includes('http://') || val.includes('https://'))) {
                            return `<a href="javascript:void(0)" onclick="openPreview('${val}')" class="inline-flex items-center gap-2 text-blue-500 hover:text-blue-400 group transition-colors"><svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg><span class="group-hover:underline">Buka Link</span></a>`;
                        }
                        if (typeof val === 'string' && val.includes('\n')) return val.replace(/\n/g, ' <span class="theme-text-muted opacity-50 mx-2">/</span> '); 
                        return val;
                    }
                };
            });

            evaluasiDataTable = $('#evaluasiTable').DataTable({
                data: data, columns: columns, scrollX: true, pageLength: 15, ordering: false,
                language: { search: "", searchPlaceholder: "Cari Analisis...", lengthMenu: "Tampil _MENU_ baris", info: "Menampilkan _START_ - _END_ dari _TOTAL_ data", paginate: { previous: "Prev", next: "Next" } }
            });
        }

        // =========================================
        // INIT SAAT WEB DIBUKA
        // =========================================
        document.addEventListener("DOMContentLoaded", function() {
            
            if (localStorage.getItem('theme') === 'light') {
                document.body.classList.add('light-mode');
                const themeIcon = document.getElementById('theme-icon');
                if(themeIcon) {
                    themeIcon.innerHTML = `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"></path>`;
                }
            }

            renderNotifications();
            renderEmailsUI(); 

            // Bangun tombol Tab Master Data
            const tabContainer = document.getElementById('tab-container');
            if(tabContainer) {
                listSheets.forEach(sheet => {
                    const btn = document.createElement('button'); 
                    btn.dataset.sheet = sheet; 
                    btn.innerText = sheet; 
                    btn.className = 'tab-btn tab-inactive';
                    btn.onclick = () => loadTable(sheet);
                    tabContainer.appendChild(btn);
                });
            }

            // Bangun tombol Tab Evaluasi Kinerja
            const evaluasiTabContainer = document.getElementById('evaluasi-tab-container');
            if(evaluasiTabContainer) {
                listEvaluasiSheets.forEach(sheet => {
                    const btn = document.createElement('button'); 
                    btn.dataset.sheet = sheet; 
                    btn.innerText = sheet; 
                    btn.className = 'tab-btn tab-inactive';
                    btn.onclick = () => loadEvaluasiTable(sheet);
                    evaluasiTabContainer.appendChild(btn);
                });
            }

            const isLightInit = document.body.classList.contains('light-mode');
            Highcharts.setOptions({ 
                colors: ['#3b82f6', '#8b5cf6', '#f97316', '#10b981', '#f43f5e', '#6366f1'], 
                credits: { enabled: false }, 
                chart: { style: { fontFamily: 'Inter' } } 
            });
            updateChartTheme(isLightInit);

            // Tampilkan Dashboard & Tabel Awal
            renderPivotDashboard();
            loadTable("REKAPITULASI");
            loadEvaluasiTable("Sumber/Source Data");
            
            window.addEventListener('resize', () => {
                if(currentDataTable) setTimeout(() => currentDataTable.columns.adjust(), 200);
                if(evaluasiDataTable) setTimeout(() => evaluasiDataTable.columns.adjust(), 200);
            });

            // ==========================================
            // LOGIKA POLLING BACKGROUND INSTANT
            // ==========================================
            async function syncData() {
                const syncText = document.getElementById('sync-text');
                const syncDot = document.getElementById('sync-dot');

                try {
                    const response = await fetch('/api/check-updates?t=' + new Date().getTime());
                    const result = await response.json();
                    
                    if (result.rawData && Object.keys(result.rawData).length > 0 && JSON.stringify(rawData) !== JSON.stringify(result.rawData)) {
                        
                        if (Object.keys(rawData).length > 0) {
                            let detectedChanges = [];
                            const allSheetNames = [...listSheets, ...listEvaluasiSheets];
                            
                            allSheetNames.forEach(sheet => {
                                let oldSheet = rawData[sheet] || [];
                                let newSheet = result.rawData[sheet] || [];
                                let maxRows = Math.max(oldSheet.length, newSheet.length);

                                for (let i = 0; i < maxRows; i++) {
                                    let oldRow = oldSheet[i] || {};
                                    let newRow = newSheet[i] || {};
                                    let allKeys = new Set([...Object.keys(oldRow), ...Object.keys(newRow)]);

                                    allKeys.forEach(key => {
                                        if(key.startsWith('!') || key.startsWith('__EMPTY')) return;

                                        let oldVal = String(oldRow[key] || "").trim();
                                        let newVal = String(newRow[key] || "").trim();

                                        if(oldVal.includes('|||')) oldVal = oldVal.split('|||')[0];
                                        if(newVal.includes('|||')) newVal = newVal.split('|||')[0];

                                        if (oldVal !== newVal) {
                                            detectedChanges.push({
                                                sheet: sheet, 
                                                waktu: new Date().toLocaleTimeString('id-ID', { hour12: false }), 
                                                baris: i + 2, 
                                                kolom: key, 
                                                lama: oldVal === "" ? "(Kosong)" : oldVal, 
                                                baru: newVal === "" ? "(Kosong)" : newVal
                                            });
                                        }
                                    });
                                }
                            });

                            if(detectedChanges.length > 0) {
                                logsData = [...detectedChanges, ...logsData];
                                if (logsData.length > 50) logsData = logsData.slice(0, 50); 
                            }
                            isUnread = true; 
                        }

                        rawData = result.rawData;
                        renderNotifications();
                        renderPivotDashboard(); 
                        
                        const activeTab = document.querySelector('#tab-container .tab-active');
                        if (activeTab && activeTab.dataset.sheet !== "Pivot Table") {
                            let currentFilter = '';
                            if (activeTab.dataset.sheet === 'INPUT ASTA') currentFilter = $('#asta-status-filter').val() || '';
                            loadTable(activeTab.dataset.sheet);
                            if (activeTab.dataset.sheet === 'INPUT ASTA' && currentFilter !== '') {
                                $('#asta-status-filter').val(currentFilter);
                                currentDataTable.search(currentFilter).draw();
                            }
                        }

                        const activeEvalTab = document.querySelector('#evaluasi-tab-container .tab-active');
                        if (activeEvalTab && activeEvalTab.dataset.sheet !== "Rekap Kemitraan") {
                            loadEvaluasiTable(activeEvalTab.dataset.sheet);
                        }
                        
                        if (activeEvalTab && activeEvalTab.dataset.sheet === "Rekap Kemitraan") {
                            renderKemitraanDashboard();
                        }

                        if(syncText && syncDot) {
                            syncText.innerText = "UPDATING...";
                            syncText.classList.remove('text-emerald-500', 'text-red-500'); 
                            syncText.classList.add('text-blue-500');
                            syncDot.innerHTML = `<span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-blue-400 opacity-75"></span><span class="relative inline-flex rounded-full h-1.5 w-1.5 bg-blue-500"></span>`;
                            
                            setTimeout(() => { 
                                syncText.innerText = "LIVE SYSTEM"; 
                                syncText.classList.add('text-emerald-500'); 
                                syncText.classList.remove('text-blue-500');
                                syncDot.innerHTML = `<span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span><span class="relative inline-flex rounded-full h-1.5 w-1.5 bg-emerald-500"></span>`;
                            }, 3000);
                        }
                    }
                } catch (err) { 
                    console.error("Gagal sinkronisasi background:", err); 
                    if(syncText && syncDot) {
                        syncText.innerText = "KONEKSI LAMBAT"; 
                        syncText.classList.remove('text-blue-500', 'text-emerald-500'); 
                        syncText.classList.add('text-red-500');
                        syncDot.innerHTML = `<span class="relative inline-flex rounded-full h-1.5 w-1.5 bg-red-500"></span>`;
                    }
                }
            }

            // Panggil API Vercel langsung kalau data kosong
            if (Object.keys(rawData).length === 0) {
                syncData();
            }

            setInterval(syncData, 10000); 

            // Cek Email Baru Tiap 5 Detik
            setInterval(async () => {
                try {
                    const response = await fetch('/api/check-emails?t=' + new Date().getTime());
                    const result = await response.json();
                    
                    if (JSON.stringify(emailsData) !== JSON.stringify(result.emails)) {
                        emailsData = result.emails;
                        renderEmailsUI();
                        
                        const badge = document.getElementById('sidebar-email-badge');
                        if (result.unreadCount > 0 && badge) {
                            badge.innerText = result.unreadCount;
                            badge.classList.remove('hidden');
                            badge.classList.remove('badge-pop');
                            void badge.offsetWidth; 
                            badge.classList.add('badge-pop');
                        }
                    }
                } catch (err) {}
            }, 5000); 
        });
    </script>
</body>
</html>
