        // =========================================
        // GRAFIK PEMBATALAN DARI SHEET "REKAPITULASI PEMBATALAN"
        // =========================================
        function renderPembatalanChart(pembatalanData) {
            let pembatalanCountMap = {};
            let totalSuratBatal = 0;

            if (pembatalanData.length > 0) {
                let pCols = Object.keys(pembatalanData[0] || {});
                let pCroCol = pCols.find(k => k.toLowerCase() === 'cro') || pCols[4];
                let pNoSuratBatal = pCols.find(k => k.toLowerCase().includes('no surat pembatalan')) || pCols[1];

                pembatalanData.forEach(row => {
                    let rawCro = String(row[pCroCol] || "").replace(/^[+-]\s*/, '').trim();
                    let croBatal = rawCro.toUpperCase();
                    let noSurat = String(row[pNoSuratBatal] || "").trim();

                    if (noSurat && noSurat !== "-" && !noSurat.toLowerCase().includes("no surat")) {
                        if (croBatal && !croBatal.startsWith("CRO") && croBatal !== "-" && croBatal !== "CRO") {
                            croBatal = "CRO " + croBatal;
                        }
                        pembatalanCountMap[croBatal] = (pembatalanCountMap[croBatal] || 0) + 1;
                        totalSuratBatal++;
                    }
                });
            }

            document.getElementById('total-batal-badge').innerText = `Total: ${totalSuratBatal} Surat`;

            let categories = Object.keys(pembatalanCountMap).sort();
            let chartData = categories.map(c => pembatalanCountMap[c]);

            Highcharts.chart('chart-pembatalan', {
                chart: { type: 'column', backgroundColor: 'transparent', marginTop: 30 },
                title: { text: null },
                legend: { enabled: false },
                tooltip: { backgroundColor: 'rgba(21, 21, 21, 0.95)', style: { color: '#ffffff' }, borderWidth: 1, borderColor: '#333333', borderRadius: 8, padding: 12 },
                xAxis: { categories: categories, labels: { style: { color: '#e5e7eb', fontWeight: '600', fontSize: '11px' } }, lineWidth: 0, tickWidth: 0 },
                yAxis: { title: { text: null }, gridLineColor: 'rgba(255,255,255,0.05)', gridLineDashStyle: 'Dash', labels: { style: { color: '#a1a1aa' } } },
                series: [{ 
                    name: 'Jumlah Surat Batal', 
                    data: chartData, 
                    color: { linearGradient: { x1: 0, x2: 0, y1: 0, y2: 1 }, stops: [ [0, '#ef4444'], [1, '#7f1d1d'] ] }
                }],
                plotOptions: { 
                    column: { 
                        borderRadius: 6, borderWidth: 0, pointPadding: 0.15, groupPadding: 0.1, maxPointWidth: 70, 
                        dataLabels: { enabled: true, color: '#ffffff', style: { textOutline: 'none', fontWeight: 'bold', fontSize: '14px' }, y: -5 } 
                    } 
                },
                credits: { enabled: false }
            });
            
            const isLightNow = document.body.classList.contains('light-mode'); 
            updateChartTheme(isLightNow);
        }

        function getFileIcon(fileName) {
            const ext = fileName.toLowerCase();
            if (ext.includes('.pdf')) return `<svg class="w-4 h-4 text-red-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"></path></svg>`; 
            else if (ext.includes('.doc') || ext.includes('.docx')) return `<svg class="w-4 h-4 text-blue-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>`; 
            else return `<svg class="w-4 h-4 theme-text-muted shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"></path></svg>`; 
        }

        function openPreview(rawUrl) {
            let previewUrl = rawUrl.trim();
            if (previewUrl.includes("drive.google.com/file/d/")) previewUrl = previewUrl.replace(/\/view.*/, '/preview'); 
            else if (previewUrl.includes("docs.google.com/document/d/") || previewUrl.includes("docs.google.com/spreadsheets/d/")) previewUrl = previewUrl.replace(/\/edit.*/, '/preview'); 
            
            document.getElementById('documentIframe').src = previewUrl;
            document.getElementById('modalExternalLink').href = rawUrl;
            
            const modal = document.getElementById('previewModal');
            const content = document.getElementById('modalContent');
            modal.classList.remove('hidden');
            setTimeout(() => { modal.classList.remove('opacity-0'); content.classList.remove('scale-95'); }, 10);
        }

        function closePreview() {
            const modal = document.getElementById('previewModal');
            const content = document.getElementById('modalContent');
            modal.classList.add('opacity-0'); content.classList.add('scale-95');
            setTimeout(() => { modal.classList.add('hidden'); document.getElementById('documentIframe').src = ""; }, 300);
        }

        $(document).on('click', '.hide-col-btn', function(e) {
            e.stopPropagation(); 
            e.preventDefault();
            let th = $(this).closest('th');
            let wrapper = $(this).closest('.dataTables_wrapper');
            let mainTable = wrapper.find('.dataTables_scrollBody table');
            if(mainTable.length > 0) {
                let tableId = mainTable.attr('id');
                let table = $('#' + tableId).DataTable();
                let colIdx = table.column(th).index();
                table.column(colIdx).visible(false);
                setTimeout(() => { table.columns.adjust(); }, 50);
            }
        });

        function loadTable(sheetName) {
            document.getElementById('table-area').classList.remove('hidden');
            
            // TAMPILKAN CHART KALAU LAGI DI MENU SURAT PEMBATALAN YANG BARU
            const pembatalanContainer = document.getElementById('pembatalan-chart-container');
            if (sheetName.toLowerCase() === 'rekapitulasi pembatalan') {
                pembatalanContainer.classList.remove('hidden');
                renderPembatalanChart(rawData[sheetName] || []);
            } else {
                pembatalanContainer.classList.add('hidden');
            }

            const data = rawData[sheetName] || [];
            if ($.fn.DataTable.isDataTable('#mainTable')) { $('#mainTable').DataTable().destroy(); $('#mainTable').empty(); }
            
            if (data.length === 0) { 
                $('#mainTable').html(`<tbody><tr><td class="text-center py-12 theme-text-muted text-sm">Tidak ada data tersedia pada sheet ini.</td></tr></tbody>`); 
                return; 
            }

            const validKeys = [];
            let allKeysSet = new Set();
            data.forEach(row => Object.keys(row).forEach(k => allKeysSet.add(k)));
            let allKeys = Array.from(allKeysSet);

            allKeys.forEach(key => {
                let title = key.trim();
                let isGhost = true;
                for(let i=0; i < data.length; i++) {
                    let v = data[i][key];
                    if (v !== undefined && v !== null && String(v).trim() !== '' && String(v).trim() !== '-') {
                        isGhost = false;
                        break;
                    }
                }
                if (isGhost) return;
                validKeys.push(key);
            });

            const columns = validKeys.map(key => {
                let displayTitle = key;
                if (displayTitle.startsWith('__EMPTY')) {
                    displayTitle = "-"; 
                } else {
                    displayTitle = displayTitle.replace(/_\d+$/, '').trim(); 
                }

                let numTitle = parseFloat(displayTitle);
                if (!isNaN(numTitle) && numTitle > 40000 && numTitle < 50000) {
                    let d = new Date(Math.round((numTitle - 25569) * 86400000));
                    displayTitle = d.getUTCDate() + '/' + (d.getUTCMonth() + 1);
                }

                let isDateCol = displayTitle.toLowerCase().includes('tgl') || displayTitle.toLowerCase().includes('tanggal') || displayTitle.toLowerCase().includes('waktu');
                
                return { 
                    title: `<div class="flex justify-between items-center group"><span class="whitespace-nowrap">${displayTitle}</span><button type="button" class="hide-col-btn opacity-0 group-hover:opacity-100 text-red-500 hover:text-red-300 ml-2 px-1 rounded transition-opacity" title="Hapus Kolom">✖</button></div>`, 
                    data: key, 
                    defaultContent: "-", 
                    render: function(val) {
                        if (isDateCol && typeof val === 'number') {
                            let d = new Date(Math.round((val - 25569) * 86400000));
                            let dd = d.getUTCDate().toString().padStart(2, '0');
                            let mm = (d.getUTCMonth() + 1).toString().padStart(2, '0');
                            let yy = d.getUTCFullYear();
                            return `${dd}/${mm}/${yy}`;
                        }
                        if (typeof val === 'number') {
                            if (val % 1 !== 0) return val.toLocaleString('id-ID', {maximumFractionDigits: 2});
                            return val.toLocaleString('id-ID');
                        }
                        if (typeof val === 'string' && val.includes('|||')) {
                            const parts = val.split('|||');
                            return `<a href="javascript:void(0)" onclick="openPreview('${parts[1]}')" class="inline-flex items-center gap-2 theme-text-muted hover:text-blue-500 group transition-colors">${getFileIcon(parts[0])} <span class="group-hover:underline truncate max-w-[200px]" title="${parts[0]}">${parts[0]}</span></a>`;
                        }
                        else if(typeof val === 'string' && (val.includes('http://') || val.includes('https://'))) {
                            return `<a href="javascript:void(0)" onclick="openPreview('${val}')" class="inline-flex items-center gap-2 text-blue-500 hover:text-blue-400 group transition-colors"><svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg><span class="group-hover:underline">Buka Link</span></a>`;
                        }
                        if (typeof val === 'string' && val.includes('\n')) return val.replace(/\n/g, '<br>'); 
                        return val;
                    }
                };
            });

            currentDataTable = $('#mainTable').DataTable({
                data: data, columns: columns, scrollX: true, pageLength: 10, ordering: false,
                colReorder: true, 
                language: { search: "", searchPlaceholder: "Cari Data...", lengthMenu: "Tampil _MENU_ baris", info: "Menampilkan _START_ - _END_ dari _TOTAL_ data", paginate: { previous: "Prev", next: "Next" } }
            });
        }

        document.addEventListener("DOMContentLoaded", function() {
            checkLoginState();

            if (localStorage.getItem('theme') === 'light') {
                document.body.classList.add('light-mode');
                const themeIcon = document.getElementById('theme-icon');
                if(themeIcon) themeIcon.innerHTML = `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"></path>`;
            }

            renderNotifications();
            renderEmailsUI(); 

            const sidebarMaster = document.getElementById('sidebar-master-data');
            if(sidebarMaster) {
                listSheets.forEach((sheet, idx) => {
                    const btn = document.createElement('button'); 
                    btn.id = 'nav-md-' + idx; 
                    btn.className = 'w-full sidebar-child-link text-left'; 
                    btn.innerHTML = `<svg class="w-3.5 h-3.5 mr-2.5 opacity-70" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg> <span class="truncate tracking-wide">${sheet}</span>`;
                    btn.onclick = () => switchView('view-database', btn.id, sheet);
                    sidebarMaster.appendChild(btn);
                });
            }

            const isLightInit = document.body.classList.contains('light-mode');
            Highcharts.setOptions({ colors: ['#3b82f6', '#8b5cf6', '#f97316', '#10b981', '#f43f5e', '#6366f1'], credits: { enabled: false }, chart: { style: { fontFamily: 'Inter' } } });
            updateChartTheme(isLightInit);

            switchView('view-dashboard', 'nav-dashboard'); 
            
            window.addEventListener('resize', () => {
                if(currentDataTable) setTimeout(() => currentDataTable.columns.adjust(), 200);
            });

            async function syncData() {
                const syncText = document.getElementById('sync-text');
                const syncDot = document.getElementById('sync-dot');

                try {
                    const response = await fetch('/api/check-updates?t=' + new Date().getTime());
                    const result = await response.json();
                    
                    if (result.rawData && Object.keys(result.rawData).length > 0 && JSON.stringify(rawData) !== JSON.stringify(result.rawData)) {
                        
                        if (Object.keys(rawData).length > 0) {
                            let detectedChanges = [];
                            const allSheetNames = [...listSheets]; 
                            
                            allSheetNames.forEach(sheet => {
                                let pivotKey = Object.keys(result.rawData).find(k => k.trim().toLowerCase() === sheet.toLowerCase()) || sheet;
                                let oldSheet = rawData[sheet] || [];
                                let newSheet = result.rawData[pivotKey] || [];
                                let maxRows = Math.max(oldSheet.length, newSheet.length);

                                for (let i = 0; i < maxRows; i++) {
                                    let oldRow = oldSheet[i] || {};
                                    let newRow = newSheet[i] || {};
                                    let allKeys = new Set([...Object.keys(oldRow), ...Object.keys(newRow)]);

                                    allKeys.forEach(key => {
                                        if(key.startsWith('!') || key.startsWith('__EMPTY')) return;

                                        let oldVal = String(oldRow[key] || "").trim();
                                        let newVal = String(newRow[key] || "").trim();

                                        if(oldVal.includes('|||')) oldVal = oldVal.split('|||')[0];
                                        if(newVal.includes('|||')) newVal = newVal.split('|||')[0];

                                        if (oldVal !== newVal) {
                                            detectedChanges.push({ sheet: sheet, waktu: new Date().toLocaleTimeString('id-ID', { hour12: false }), baris: i + 2, kolom: key, lama: oldVal === "" ? "(Kosong)" : oldVal, baru: newVal === "" ? "(Kosong)" : newVal });
                                        }
                                    });
                                }
                            });

                            if(detectedChanges.length > 0) {
                                logsData = [...detectedChanges, ...logsData];
                                if (logsData.length > 50) logsData = logsData.slice(0, 50); 
                            }
                            isUnread = true; 
                        }

                        rawData = result.rawData;
                        renderNotifications();
                        
                        if (currentActiveSheet === 'dashboard' || currentActiveSheet === null) {
                            renderPivotDashboard(); 
                        }
                        else if (listSheets.includes(currentActiveSheet)) {
                            let sheetRealKey = Object.keys(rawData).find(k => k.trim().toLowerCase() === currentActiveSheet.toLowerCase()) || currentActiveSheet;
                            loadTable(sheetRealKey);
                        }

                        if(syncText && syncDot) {
                            syncText.innerText = "UPDATING...";
                            syncText.classList.remove('text-emerald-500', 'text-red-500'); syncText.classList.add('text-blue-500');
                            syncDot.innerHTML = `<span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-blue-400 opacity-75"></span><span class="relative inline-flex rounded-full h-1.5 w-1.5 bg-blue-500"></span>`;
                            
                            setTimeout(() => { 
                                syncText.innerText = "LIVE SYSTEM"; syncText.classList.add('text-emerald-500'); syncText.classList.remove('text-blue-500');
                                syncDot.innerHTML = `<span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span><span class="relative inline-flex rounded-full h-1.5 w-1.5 bg-emerald-500"></span>`;
                            }, 3000);
                        }
                    }
                } catch (err) { 
                    console.error("Gagal sinkronisasi background:", err); 
                    if(syncText && syncDot) {
                        syncText.innerText = "KONEKSI LAMBAT"; syncText.classList.remove('text-blue-500', 'text-emerald-500'); syncText.classList.add('text-red-500');
                        syncDot.innerHTML = `<span class="relative inline-flex rounded-full h-1.5 w-1.5 bg-red-500"></span>`;
                    }
                }
            }

            setInterval(syncData, 10000); 

            setInterval(async () => {
                try {
                    const response = await fetch('/api/check-emails?t=' + new Date().getTime());
                    const result = await response.json();
                    if (JSON.stringify(emailsData) !== JSON.stringify(result.emails)) {
                        emailsData = result.emails;
                        renderEmailsUI();
                        const badge = document.getElementById('sidebar-email-badge');
                        if (result.unreadCount > 0 && badge) {
                            badge.innerText = result.unreadCount; badge.classList.remove('hidden'); badge.classList.remove('badge-pop'); void badge.offsetWidth; badge.classList.add('badge-pop');
                        }
                    }
                } catch (err) {}
            }, 5000); 
        });
    </script>
</body>
</html>
