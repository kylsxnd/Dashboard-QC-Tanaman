                        <div class="text-[10px] md:text-xs text-gray-300 font-bold uppercase tracking-widest mb-2">TOTAL SURAT PEMBATALAN</div>
                        <div class="text-3xl md:text-4xl font-extrabold text-white mb-1 tracking-tight" id="kpi-total-batal">0 <span class="text-lg text-gray-400 font-medium tracking-normal">Surat</span></div>
                        <div class="text-[10px] text-red-400 font-semibold mt-2 bg-red-500/20 inline-block px-2 py-0.5 rounded border border-red-500/30">Arsip Terpusat</div>
                    </div>
                    
                    <div class="relative overflow-hidden premium-card p-6 bg-gradient-to-br from-[rgba(17,17,17,0.8)] to-[rgba(21,21,21,0.9)] border-t-[3px] border-t-amber-500 shadow-[0_4px_15px_-4px_rgba(245,158,11,0.2)] group transition-all duration-300 hover:shadow-[0_0_25px_rgba(245,158,11,0.6)] cursor-default">
                        <div class="text-[10px] md:text-xs text-gray-300 font-bold uppercase tracking-widest mb-2">REGIONAL TERDAMPAK</div>
                        <div class="text-3xl md:text-4xl font-extrabold text-white mb-1 tracking-tight" id="kpi-cro-batal">0 <span class="text-lg text-gray-400 font-medium tracking-normal">CRO</span></div>
                        <div class="text-[10px] text-amber-400 font-semibold mt-2 bg-amber-500/20 inline-block px-2 py-0.5 rounded border border-amber-500/30">Monitoring Aktif</div>
                    </div>

                    <div class="relative overflow-hidden premium-card p-6 bg-gradient-to-br from-[rgba(17,17,17,0.8)] to-[rgba(21,21,21,0.9)] border-t-[3px] border-t-orange-500 shadow-[0_4px_15px_-4px_rgba(249,115,22,0.2)] group transition-all duration-300 hover:shadow-[0_0_25px_rgba(249,115,22,0.6)] cursor-default">
                        <div class="text-[10px] md:text-xs text-gray-300 font-bold uppercase tracking-widest mb-2">DOKUMEN PROSES TTD</div>
                        <div class="text-3xl md:text-4xl font-extrabold text-white mb-1 tracking-tight" id="kpi-ttd-batal">0 <span class="text-lg text-gray-400 font-medium tracking-normal">Berkas</span></div>
                        <div class="text-[10px] text-orange-400 font-semibold mt-2 bg-orange-500/20 inline-block px-2 py-0.5 rounded border border-orange-500/30">Menunggu Tanda Tangan</div>
                    </div>
                </div>

                <div class="premium-card p-5 md:p-8 w-full relative overflow-hidden mb-8">
                    <h3 class="text-[10px] font-bold theme-text-muted uppercase tracking-widest mb-4 flex items-center gap-2">
                        <svg class="w-4 h-4 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                        STATISTIK SURAT PEMBATALAN PER CRO
                    </h3>
                    <div id="dash-chart-pembatalan" style="height: 350px; width: 100%;"></div>
                </div>

                <div class="premium-card p-4 md:p-6 mt-5 w-full mb-8">
                    <h3 class="text-[10px] font-bold theme-text-muted uppercase tracking-widest mb-4">DAFTAR PERUSAHAAN PEMBATALAN</h3>
                    <div class="overflow-x-auto">
                        <table class="w-full text-left border-collapse min-w-[600px]">
                            <thead>
                                <tr>
                                    <th class="border-b border-gray-600/30 py-3 px-4 text-[10px] theme-text-muted uppercase">NAMA PERUSAHAAN / MITRA</th>
                                    <th class="border-b border-gray-600/30 py-3 px-4 text-[10px] theme-text-muted uppercase text-center">CRO</th>
                                    <th class="border-b border-gray-600/30 py-3 px-4 text-[10px] theme-text-muted uppercase text-right">LUAS TM (HA)</th>
                                    <th class="border-b border-gray-600/30 py-3 px-4 text-[10px] theme-text-muted uppercase text-center">STATUS DOKUMEN</th>
                                </tr>
                            </thead>
                            <tbody id="pembatalan-pt-list-body" class="divide-y divide-gray-600/30"></tbody>
                        </table>
                    </div>
                </div>
            </section>

            <!-- 3. MASTER DATA REPOSITORY -->
            <section id="view-database" class="fade-in hidden">
                <div class="mb-6">
                    <h2 class="text-xl md:text-2xl font-bold theme-text-main tracking-tight" id="database-title">Master Data Repository</h2>
                    <p class="text-xs md:text-sm theme-text-muted mt-1">Eksplorasi arsip dokumen dan database terpusat.</p>
                </div>
                
                <div class="premium-card p-4 md:p-6 w-full">
                    <div class="w-full overflow-hidden" id="data-wrapper">
                        <div id="table-area" class="w-full">
                            <table id="mainTable" class="w-full text-left"></table>
