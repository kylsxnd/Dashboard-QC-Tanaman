    <!-- MODAL PREVIEW -->
    <div id="previewModal" class="fixed inset-0 z-50 flex items-center justify-center bg-black/80 backdrop-blur-sm hidden transition-all duration-300 opacity-0 z-[9999]">
        <div class="theme-bg-panel border theme-border rounded-xl w-11/12 md:w-4/5 h-[85vh] flex flex-col shadow-2xl transform scale-95 transition-transform duration-300" id="modalContent">
            <div class="flex justify-between items-center px-4 md:px-5 py-4 border-b theme-border">
                <h3 class="theme-text-main font-medium text-xs md:text-sm flex items-center gap-2">
                    <svg class="w-4 h-4 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path></svg> Live Document Viewer
                </h3>
                <div class="flex items-center space-x-3 md:space-x-4">
                    <a id="modalExternalLink" href="#" target="_blank" class="text-[10px] md:text-xs text-blue-400 hover:text-blue-300 font-medium transition-colors flex items-center gap-1.5">Open in Drive <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg></a>
                    <div class="w-px h-4 bg-gray-500"></div>
                    <button onclick="closePreview()" class="theme-text-muted hover:text-red-500 transition-colors"><svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg></button>
                </div>
            </div>
            <div class="flex-grow bg-white rounded-b-xl overflow-hidden"><iframe id="documentIframe" src="" class="w-full h-full border-none"></iframe></div>
        </div>
    </div>

    <!-- SCRIPT LOGIC -->
    <script>
        function logout() {
            if(confirm("Apakah Anda yakin ingin memuat ulang sesi ini?")) {
                window.location.reload();
            }
        }

        let rawData = <%- sheetData %> || {};
        let logsData = <%- logsData %> || []; 
        
        let currentDataTable = null;
        let currentActiveSheet = null; 

        function toggleSidebar() {
            const sidebar = document.getElementById('mobile-sidebar');
            const overlay = document.getElementById('sidebar-overlay');
            if (sidebar.classList.contains('-translate-x-full')) {
                sidebar.classList.remove('-translate-x-full');
                overlay.classList.remove('hidden');
                setTimeout(() => overlay.classList.remove('opacity-0'), 10);
            } else {
                sidebar.classList.add('-translate-x-full');
                overlay.classList.add('opacity-0');
                setTimeout(() => overlay.classList.add('hidden'), 300);
            }
        }

        function toggleTheme() {
            document.body.classList.toggle('light-mode');
            const isLight = document.body.classList.contains('light-mode');
            localStorage.setItem('theme', isLight ? 'light' : 'dark');
            const themeIcon = document.getElementById('theme-icon');
            if (isLight) themeIcon.innerHTML = `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"></path>`;
            else themeIcon.innerHTML = `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path>`;
            updateChartTheme(isLight);
        }

        function updateChartTheme(isLight) {
            const textColor = isLight ? '#6b7280' : '#a1a1aa';
            const gridColor = isLight ? 'rgba(0,0,0,0.1)' : 'rgba(255,255,255,0.05)';
            const tooltipBg = isLight ? '#ffffff' : '#151515';
            const tooltipText = isLight ? '#1f2937' : '#f8fafc';
            Highcharts.charts.forEach(chart => {
                if (chart) {
                    chart.update({
                        xAxis: { labels: { style: { color: textColor } } },
                        yAxis: { labels: { style: { color: textColor } }, gridLineColor: gridColor },
                        legend: { itemStyle: { color: textColor } },
                        plotOptions: { pie: { dataLabels: { color: textColor } } },
                        tooltip: { backgroundColor: tooltipBg, style: { color: tooltipText }, borderColor: gridColor }
                    });
                }
            });
        }

        function switchView(viewId, elementId, paramName = null) {
            document.getElementById('view-pivot').classList.add('hidden');
            document.getElementById('view-dashboard').classList.add('hidden');
            document.getElementById('view-pembatalan').classList.add('hidden');
            document.getElementById('view-database').classList.add('hidden');
            
            document.getElementById(viewId).classList.remove('hidden');
            
            const headerTitle = document.getElementById('header-title');
            if(viewId === 'view-pivot') {
                headerTitle.innerText = "Dashboard Pivot";
                currentActiveSheet = 'pivot';
                renderPivotTables(); 
            }
            else if(viewId === 'view-dashboard') {
                headerTitle.innerText = "Dashboard Rekapitulasi";
                currentActiveSheet = 'dashboard';
                renderDashboardCharts(); 
            }
            else if(viewId === 'view-pembatalan') {
                headerTitle.innerText = "Dashboard Pembatalan";
                currentActiveSheet = 'pembatalan';
                renderPembatalanDashboard();
            }
            else if(viewId === 'view-database') {
                headerTitle.innerText = "Master Data > " + paramName;
                currentActiveSheet = paramName;
                loadTable(paramName);
            }
            
            document.querySelectorAll('.sidebar-link').forEach(el => el.classList.remove('active'));
            document.querySelectorAll('.sidebar-child-link').forEach(el => el.classList.remove('active'));
            
            if (elementId && document.getElementById(elementId)) {
                document.getElementById(elementId).classList.add('active');
            }
            
            if (window.innerWidth < 768) toggleSidebar();
            if(viewId === 'view-database' && currentDataTable) setTimeout(() => currentDataTable.columns.adjust(), 50);
        }

        const parseNum = (val) => {
            if (typeof val === 'number') return val;
            if (val === null || val === undefined) return 0;
            let s = String(val).trim().replace(/Rp|\$|€| /gi, '');
            if (s === '-' || s === '') return 0;

            if (s.includes(',')) {
                s = s.replace(/\./g, '').replace(',', '.');
            } else {
                let lastDot = s.lastIndexOf('.');
                if (lastDot !== -1 && s.indexOf('.') !== lastDot) {
                    s = s.substring(0, lastDot).replace(/\./g, '') + s.substring(lastDot);
                }
            }
            let res = parseFloat(s);
            return isNaN(res) ? 0 : res;
        };

        // =========================================
        // DASHBOARD 0: PIVOT TABLES (Sesuai Gambar Excel)
        // =========================================
        function renderPivotTables() {
            // Kalkulasi Tabel 1: Rekapitulasi Surat Penugasan (Batas Baris 207)
            let rekapKey = Object.keys(rawData).find(k => k.trim().toUpperCase() === "REKAPITULASI") || "REKAPITULASI";
            let rekapData = (rawData[rekapKey] || []).slice(0, 206); 
            
            let pivotMap = {};
            let grandTotalLuas = 0;
            let grandTotalPT = 0;

            if (rekapData.length > 0) {
                let rCols = Object.keys(rekapData[0] || {});
                let cCro = rCols.find(k => k.toLowerCase() === 'cro' || k.toLowerCase().includes('regional')) || rCols[0];
                let cTahap = rCols.find(k => k.toLowerCase() === 'tahap') || rCols[4];
                let cLuasTM = rCols.find(k => k.toLowerCase().includes('luas tm')) || rCols[3];
                let cPt = rCols.find(k => k.toLowerCase().includes('nama pt') || k.toLowerCase().includes('perusahaan') || k.toLowerCase().includes('koperasi') || k.toLowerCase().includes('vendor')) || rCols[1];
                let cNoSurat = rCols.find(k => k.toLowerCase().includes('no surat')) || rCols.find(k => k.toLowerCase().includes('surat'));
                let cLink = rCols.find(k => k.toLowerCase().includes('link surat')) || rCols.find(k => k.toLowerCase().includes('link'));

                rekapData.forEach(row => {
                    let rawCro = String(row[cCro] || "").replace(/^[+-]\s*/, '').trim();
                    let cro = rawCro.toUpperCase();
                    let pt = String(row[cPt] || "").trim();
                    let tahap = String(row[cTahap] || "").trim() || "Tahap ?";
                    
                    let noSurat = cNoSurat ? String(row[cNoSurat] || "").trim() : "ADA"; 
                    let linkSurat = cLink ? String(row[cLink] || "").trim() : "";
                    
                    let isProsesTTD = noSurat.toLowerCase().includes("proses ttd") || linkSurat.toLowerCase().includes("proses ttd");
                    let isSelesai = noSurat && noSurat !== "-" && !noSurat.toLowerCase().includes("no surat");

                    if (!cro || cro === "-" || cro === "CRO" || cro.includes("TOTAL") || cro.includes("SUMMARY") || cro.includes("TAHAP")) return;
                    if (!pt || pt === "-" || pt.toLowerCase() === "nama pt") return;

                    if (isProsesTTD || isSelesai) {
                        let luasTM = parseNum(row[cLuasTM]);
                        
                        if (!pivotMap[cro]) pivotMap[cro] = {};
                        if (!pivotMap[cro][tahap]) pivotMap[cro][tahap] = { luasTM: 0, countPT: 0 };
                        
                        pivotMap[cro][tahap].luasTM += luasTM;
                        pivotMap[cro][tahap].countPT += 1;
                        
                        grandTotalLuas += luasTM;
                        grandTotalPT += 1;
                    }
                });
            }

            let pivotHtml = '';
            let sortedCros = Object.keys(pivotMap).sort((a,b) => {
                let numA = parseInt(a.replace(/[^\d]/g, '')) || 0;
                let numB = parseInt(b.replace(/[^\d]/g, '')) || 0;
                if(numA !== numB) return numA - numB;
                return a.localeCompare(b);
            });

            sortedCros.forEach(cro => {
                let croTotalLuas = 0;
                let croTotalPT = 0;
                let tahaps = Object.keys(pivotMap[cro]).sort();
                
                tahaps.forEach((tahap, idx) => {
                    let luas = pivotMap[cro][tahap].luasTM;
                    let count = pivotMap[cro][tahap].countPT;
                    croTotalLuas += luas;
                    croTotalPT += count;
                    
                    let croCell = idx === 0 ? `<td class="py-2 px-4 theme-text-main font-semibold border-r border-gray-600/30 w-32 align-top" rowspan="${tahaps.length}"><span class="mr-1 text-gray-500">[-]</span> ${cro}</td>` : '';
                    
                    pivotHtml += `
                        <tr class="hover:bg-white/5 border-b border-gray-600/30">
                            ${croCell}
                            <td class="py-2 px-4 theme-text-muted border-r border-gray-600/30">${tahap}</td>
                            <td class="py-2 px-4 theme-text-main text-right border-r border-gray-600/30">${luas.toLocaleString('id-ID', {maximumFractionDigits: 2})}</td>
                            <td class="py-2 px-4 theme-text-main text-center">${count}</td>
                        </tr>
                    `;
                });
                
                // Subtotal Row
                pivotHtml += `
                    <tr class="pivot-total-row border-b border-gray-600/30">
                        <td class="py-2 px-4 border-r border-gray-600/30">${cro} Total</td>
                        <td class="py-2 px-4 border-r border-gray-600/30"></td>
                        <td class="py-2 px-4 text-right border-r border-gray-600/30">${croTotalLuas.toLocaleString('id-ID', {maximumFractionDigits: 2})}</td>
                        <td class="py-2 px-4 text-center">${croTotalPT}</td>
                    </tr>
                `;
            });
            
            // Grand Total Row
            pivotHtml += `
                <tr class="pivot-grand-total">
                    <td class="py-3 px-4 border-r border-gray-600/30">Total Keseluruhan</td>
                    <td class="py-3 px-4 border-r border-gray-600/30"></td>
                    <td class="py-3 px-4 text-right border-r border-gray-600/30">${grandTotalLuas.toLocaleString('id-ID', {maximumFractionDigits: 2})}</td>
                    <td class="py-3 px-4 text-center">${grandTotalPT}</td>
                </tr>
            `;
            
            document.getElementById('pivot-penugasan-body').innerHTML = pivotHtml;


            // Kalkulasi Tabel 2: Rekapitulasi Surat Pembatalan (Batas Baris 97)
            let batalKey = Object.keys(rawData).find(k => k.trim().toUpperCase() === "REKAPITULASI PEMBATALAN") || "REKAPITULASI PEMBATALAN";
            let pembatalanData = (rawData[batalKey] || []).slice(0, 96); 
            
            let pivotBatalMap = {};
            let grandBatalLuas = 0;
            let grandBatalCount = 0;

            if (pembatalanData.length > 0) {
                let pCols = Object.keys(pembatalanData[0] || {});
                let pCroCol = pCols.find(k => k.toLowerCase() === 'cro' || k.toLowerCase().includes('cro') || k.toLowerCase().includes('regional')) || pCols[4];
                let pTahapCol = pCols.find(k => k.toLowerCase() === 'tahap') || pCols[6];
                let pNoSuratBatal = pCols.find(k => k.toLowerCase().includes('surat pembatalan') || k.toLowerCase().includes('no surat pembatalan')) || pCols[1];

                pembatalanData.forEach(row => {
                    let rawCro = String(row[pCroCol] || "").replace(/^[+-]\s*/, '').trim();
                    let croBatal = rawCro.toUpperCase();
                    let tahapBatal = String(row[pTahapCol] || "").trim() || "Tahap ?";
                    
                    let noSurat = String(row[pNoSuratBatal] || "").trim();
                    let linkSurat = String(row['Link Surat Pembatalan'] || row['Status Kirim Dokumen'] || "").trim();
                    let luas = parseNum(row['Luas TM (Ha)']);
                    
                    let isProsesTTD = noSurat.toLowerCase().includes("proses ttd") || linkSurat.toLowerCase().includes("proses ttd");
                    let isSelesai = noSurat && noSurat !== "-" && !noSurat.toLowerCase().includes("no surat");

                    if (isProsesTTD || isSelesai) {
                        if (croBatal && !croBatal.startsWith("CRO") && croBatal !== "-" && croBatal !== "CRO") {
                            croBatal = "CRO " + croBatal;
                        }
                        
                        if (!pivotBatalMap[croBatal]) pivotBatalMap[croBatal] = {};
                        if (!pivotBatalMap[croBatal][tahapBatal]) pivotBatalMap[croBatal][tahapBatal] = { luasTM: 0, countBatal: 0 };
                        
                        pivotBatalMap[croBatal][tahapBatal].luasTM += luas;
                        pivotBatalMap[croBatal][tahapBatal].countBatal += 1;
                        
                        grandBatalLuas += luas;
                        grandBatalCount += 1;
                    }
                });
            }

            let pivotBatalHtml = '';
            let sortedBatalCros = Object.keys(pivotBatalMap).sort((a,b) => {
                let numA = parseInt(a.replace(/[^\d]/g, '')) || 0;
                let numB = parseInt(b.replace(/[^\d]/g, '')) || 0;
                if(numA !== numB) return numA - numB;
                return a.localeCompare(b);
            });

            sortedBatalCros.forEach(cro => {
                let croTotalLuas = 0;
                let croTotalCount = 0;
                let tahaps = Object.keys(pivotBatalMap[cro]).sort();
                
                tahaps.forEach((tahap, idx) => {
                    let luas = pivotBatalMap[cro][tahap].luasTM;
                    let count = pivotBatalMap[cro][tahap].countBatal;
                    croTotalLuas += luas;
                    croTotalCount += count;
                    
                    let croCell = idx === 0 ? `<td class="py-2 px-4 theme-text-main font-semibold border-r border-gray-600/30 w-32 align-top" rowspan="${tahaps.length}"><span class="mr-1 text-gray-500">[-]</span> ${cro}</td>` : '';
                    
                    pivotBatalHtml += `
                        <tr class="hover:bg-white/5 border-b border-gray-600/30">
                            ${croCell}
                            <td class="py-2 px-4 theme-text-muted border-r border-gray-600/30">${tahap}</td>
                            <td class="py-2 px-4 theme-text-main text-center border-r border-gray-600/30">${count}</td>
                            <td class="py-2 px-4 theme-text-main text-right">${luas.toLocaleString('id-ID', {maximumFractionDigits: 2})}</td>
                        </tr>
                    `;
                });
                
                // Subtotal Row
                pivotBatalHtml += `
                    <tr class="pivot-total-row border-b border-gray-600/30">
                        <td class="py-2 px-4 border-r border-gray-600/30">${cro} Total</td>
                        <td class="py-2 px-4 border-r border-gray-600/30"></td>
                        <td class="py-2 px-4 text-center border-r border-gray-600/30">${croTotalCount}</td>
                        <td class="py-2 px-4 text-right">${croTotalLuas.toLocaleString('id-ID', {maximumFractionDigits: 2})}</td>
                    </tr>
                `;
            });

            // Grand Total Row
            pivotBatalHtml += `
                <tr class="pivot-grand-total">
                    <td class="py-3 px-4 border-r border-gray-600/30">Total Keseluruhan</td>
                    <td class="py-3 px-4 border-r border-gray-600/30"></td>
                    <td class="py-3 px-4 text-center border-r border-gray-600/30">${grandBatalCount}</td>
                    <td class="py-3 px-4 text-right">${grandBatalLuas.toLocaleString('id-ID', {maximumFractionDigits: 2})}</td>
                </tr>
            `;

