                </div>

            </div>
        </header>

        <!-- KONTEN UTAMA (Yang Bisa Di-Scroll) -->
        <main class="flex-1 overflow-y-auto p-4 md:p-6 lg:p-8">
            
            <!-- 1. HALAMAN DASHBOARD UTAMA PIVOT (DIKEMBALIKAN DAFTAR NAMA PT) -->
            <section id="view-dashboard" class="fade-in block">
                
                <!-- HEADER DASHBOARD DENGAN FILTER CRO -->
                <div class="mb-6 flex flex-col sm:flex-row sm:justify-between sm:items-end gap-4">
                    <div>
                        <h2 class="text-xl md:text-2xl font-bold theme-text-main tracking-tight">Dashboard Summary</h2>
                        <p class="text-[10px] md:text-[11px] theme-text-muted mt-1 flex items-center gap-1">
                            <svg class="w-3 h-3 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
