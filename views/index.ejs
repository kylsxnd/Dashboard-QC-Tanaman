<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Executive Portal - Agrinas</title>
    
    <!-- Library CSS & Framework -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <script src="https://code.highcharts.com/highcharts.js"></script>
    
    <!-- DataTables Extension -->
    <link href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css" rel="stylesheet">
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>

    <!-- Google Fonts Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <style>
        :root {
            --bg-main: #0a0a0a; --bg-panel: #111111; --bg-card: #151515;
            --border-color: #262626; --text-main: #ffffff; --text-muted: #a1a1aa;
            --hover-bg: #27272a;
        }
        body.light-mode {
            --bg-main: #f3f4f6; --bg-panel: #ffffff; --bg-card: #ffffff;
            --border-color: #e5e7eb; --text-main: #1f2937; --text-muted: #6b7280;
            --hover-bg: #f8fafc;
        }
        body { background-color: var(--bg-main); color: var(--text-main); font-family: 'Inter', sans-serif; overflow: hidden; }
        
        .premium-card { background: rgba(21, 21, 21, 0.72); backdrop-filter: blur(10px); border: 1px solid rgba(255,255,255,0.08); border-radius: 12px; box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.4); transition: all 0.3s ease; }
        body.light-mode .premium-card { background: rgba(255, 255, 255, 0.88); border: 1px solid var(--border-color); box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1); }

        .sidebar-link { padding: 11px 16px; font-size: 13px; font-weight: 500; color: var(--text-muted); border-radius: 10px; display: flex; align-items: center; margin-bottom: 6px; border: 1px solid transparent; transition: all 0.2s;}
        .sidebar-link:hover { color: var(--text-main); background: rgba(255,255,255,0.04); transform: translateX(4px); }
        .sidebar-link.active { color: #ffffff; background: linear-gradient(90deg, rgba(131,183,101,0.2) 0%, transparent 100%); border-left: 3px solid #83b765; font-weight: 600; }
        .sidebar-link.active svg { color: #83b765; filter: drop-shadow(0 0 8px rgba(131,183,101,0.5)); }

        .sidebar-child-link { padding: 9px 16px 9px 36px; font-size: 12.5px; font-weight: 500; color: var(--text-muted); border-radius: 8px; transition: all 0.2s ease; display: flex; align-items: center; margin-bottom: 3px; }
        .sidebar-child-link:hover { color: var(--text-main); background: var(--hover-bg); }

        table.dataTable { border-collapse: collapse !important; width: 100% !important; border-bottom: 1px solid rgba(255,255,255,0.05) !important; }
        table.dataTable thead th { background-color: rgba(21, 21, 21, 0.5) !important; color: var(--text-muted) !important; font-size: 11px; padding: 14px 18px !important; white-space: nowrap !important; }
        table.dataTable tbody td { border-bottom: 1px solid rgba(255,255,255,0.05) !important; font-size: 13px; padding: 12px 18px !important; color: var(--text-main) !important; }
        .dataTables_wrapper select, .dataTables_wrapper .dataTables_filter input { background-color: rgba(21, 21, 21, 0.8) !important; border: 1px solid rgba(255,255,255,0.1) !important; color: var(--text-main) !important; padding: 6px 12px !important; border-radius: 6px !important; outline: none !important; }
        body.light-mode .dataTables_wrapper select, body.light-mode .dataTables_wrapper .dataTables_filter input { background-color: #ffffff !important; border: 1px solid var(--border-color) !important; }

        .fade-in { animation: fadeIn 0.4s ease forwards; }
        @keyframes fadeIn { from { opacity: 0; transform: translateY(4px); } to { opacity: 1; transform: translateY(0); } }

        ::-webkit-scrollbar { width: 6px; height: 8px; }
        ::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.2); border-radius: 4px; }
        .bg-overlay { position: absolute; inset: 0; background-color: rgba(10, 10, 10, 0.65); z-index: 0; }
        body.light-mode .bg-overlay { background-color: rgba(243, 244, 246, 0.82); }
    </style>
</head>
<body class="flex h-screen w-full relative bg-black">

    <div id="sidebar-overlay" onclick="toggleSidebar()" class="fixed inset-0 bg-black/60 z-40 hidden md:hidden backdrop-blur-sm transition-opacity opacity-0 duration-300"></div>

    <aside id="mobile-sidebar" class="w-64 bg-[var(--bg-panel)] border-r border-[var(--border-color)] flex flex-col h-full flex-shrink-0 z-50 fixed md:relative transform -translate-x-full md:translate-x-0 transition-transform duration-300">
        <div class="h-16 flex items-center px-6 border-b border-[var(--border-color)]">
            <div class="flex items-center gap-3">
                <svg class="w-6 h-6 text-[#83b765]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path></svg>
                <div class="flex flex-col">
                    <h1 class="text-sm font-bold text-[var(--text-main)] tracking-wide leading-tight">AGRINAS OPS</h1>
                    <span class="text-[10px] text-[var(--text-muted)]">PT Agrinas Nusantara</span>
                </div>
            </div>
            <button onclick="toggleSidebar()" class="ml-auto md:hidden text-gray-400 hover:text-white focus:outline-none">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
            </button>
        </div>

        <div class="flex-1 overflow-y-auto py-5 px-3">
            <div class="text-[10px] font-bold text-[var(--text-muted)] uppercase tracking-[0.1em] mb-3 px-3">Menu Utama</div>
            
            <button onclick="switchView('view-dashboard', 'nav-dashboard')" class="w-full sidebar-link active" id="nav-dashboard">
                <svg class="w-4 h-4 mr-3 opacity-80" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"></path></svg> Dashboard Rekapitulasi
            </button>
            
            <button onclick="switchView('view-pembatalan', 'nav-pembatalan')" class="w-full sidebar-link" id="nav-pembatalan">
                <svg class="w-4 h-4 mr-3 opacity-80" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg> Dashboard Pembatalan
            </button>

            <div class="text-[10px] font-bold text-[var(--text-muted)] uppercase tracking-[0.1em] mb-2 px-3 mt-6 flex items-center">
                <svg class="w-3.5 h-3.5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4"></path></svg> Master Data Kebun
            </div>
            <div id="sidebar-master-data" class="mb-2"></div>
        </div>

        <div class="p-4 border-t border-[var(--border-color)] cursor-pointer hover:bg-white/5" onclick="logout()">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-3">
                    <div class="w-8 h-8 rounded-full border border-[#83b765]/30 flex items-center justify-center text-xs font-bold text-white bg-gradient-to-br from-[#83b765] to-emerald-700 shadow-sm">PIC</div>
                    <span class="text-xs font-semibold text-[var(--text-main)] truncate">Staf PIC HO</span>
                </div>
                <svg class="w-4 h-4 text-red-500 opacity-50 transition-opacity" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path></svg>
            </div>
        </div>
    </aside>

    <div class="flex-1 flex flex-col h-full overflow-hidden transition-colors duration-300 relative bg-black">
        <div class="absolute inset-0 z-0 bg-cover bg-center bg-no-repeat transition-all duration-500" style="background-image: url('https://raw.githubusercontent.com/kylsxnd/Dashboard-QC-Tanaman/main/public/bgkelapasawit.jpeg'); opacity: 0.55;"></div>
        <div class="bg-overlay"></div>

        <header class="h-16 border-b border-gray-600/30 flex items-center justify-between px-4 md:px-6 z-10 flex-shrink-0 transition-colors duration-300 relative" style="background: rgba(17,17,17,0.7); backdrop-filter: blur(10px);">
            <div class="flex items-center text-sm font-medium text-[var(--text-muted)] min-w-0">
                <button onclick="toggleSidebar()" class="md:hidden mr-3 p-2 -ml-2 rounded-lg hover:bg-[var(--hover-bg)] focus:outline-none shrink-0">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
                </button>
                <svg class="w-4 h-4 mr-2 shrink-0 hidden sm:block" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
                <span id="header-title" class="text-[var(--text-main)] truncate max-w-[130px] sm:max-w-xs md:max-w-md">Dashboard Rekapitulasi</span>
            </div>

            <div class="flex items-center gap-2 md:gap-4 shrink-0">
                <button onclick="toggleTheme()" class="relative p-2 text-[var(--text-muted)] hover:text-[var(--text-main)] transition-colors focus:outline-none">
                    <svg id="theme-icon" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
                </button>
                <div class="w-px h-5 border-l border-[var(--border-color)]"></div>
                <div class="flex items-center gap-2 text-[10px] font-semibold text-emerald-500 bg-emerald-500/10 px-2.5 py-1.5 md:px-3 rounded-full border border-emerald-500/20">
                    <span id="sync-dot" class="relative flex h-1.5 w-1.5"><span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span><span class="relative inline-flex rounded-full h-1.5 w-1.5 bg-emerald-500"></span></span>
                    <span id="sync-text" class="hidden sm:inline">LIVE SYSTEM</span>
                </div>
            </div>
        </header>

        <main class="flex-1 overflow-y-auto p-4 md:p-6 lg:p-8 relative z-10 text-[var(--text-main)]">
            
            <!-- ============================================== -->
            <!-- 1. DASHBOARD REKAPITULASI PENUGASAN -->
            <!-- ============================================== -->
            <section id="view-dashboard" class="fade-in block">
                <div class="mb-6 flex flex-col sm:flex-row sm:justify-between sm:items-end gap-4">
                    <div>
                        <h2 class="text-xl md:text-2xl font-bold tracking-tight">Dashboard Rekapitulasi (Penugasan)</h2>
                        <p class="text-[10px] md:text-[11px] text-[var(--text-muted)] mt-1 flex items-center gap-1">
                            <svg class="w-3 h-3 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg> Data Akurat tersinkronisasi dari Sheet PIVOT.
                        </p>
                    </div>
                    <div class="flex items-center justify-between sm:justify-start gap-3 premium-card border border-[var(--border-color)] px-4 py-2 rounded-lg shadow-sm">
                        <span class="text-[10px] md:text-[11px] font-bold text-[var(--text-muted)] uppercase tracking-widest">FILTER CRO:</span>
                        <select id="cro-filter" onchange="renderDashboardCharts()" class="bg-transparent text-[var(--text-main)] text-xs md:text-sm font-semibold outline-none cursor-pointer border-none !p-0"></select>
                    </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 md:gap-5 mb-8">
                    <div class="relative overflow-hidden premium-card p-6 bg-gradient-to-br from-[rgba(17,17,17,0.8)] to-[rgba(21,21,21,0.9)] border-t-[3px] border-t-blue-500 shadow-[0_4px_15px_-4px_rgba(59,130,246,0.2)]">
                        <div class="text-[10px] md:text-xs text-gray-300 font-bold uppercase tracking-widest mb-2">TOTAL JUMLAH PT (KEBUN)</div>
                        <div class="text-3xl md:text-4xl font-extrabold text-white mb-1 tracking-tight" id="dash-kpi-pt">0 <span class="text-lg text-gray-400 font-medium tracking-normal">PT</span></div>
                    </div>
                    <div class="relative overflow-hidden premium-card p-6 bg-gradient-to-br from-[rgba(17,17,17,0.8)] to-[rgba(21,21,21,0.9)] border-t-[3px] border-t-purple-500 shadow-[0_4px_15px_-4px_rgba(168,85,247,0.2)]">
                        <div class="text-[10px] md:text-xs text-gray-300 font-bold uppercase tracking-widest mb-2">TOTAL LUAS TM (HA)</div>
                        <div class="text-3xl md:text-3xl lg:text-4xl font-extrabold text-white mb-1 tracking-tight" id="dash-kpi-luas">0 <span class="text-lg text-gray-400 font-medium tracking-normal">Ha</span></div>
                    </div>
                </div>

                <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 md:gap-5 mb-8">
                    <div class="premium-card p-4 md:p-6 w-full relative overflow-hidden">
                        <h3 id="chart-title-bar" class="text-[10px] font-bold text-[var(--text-muted)] uppercase tracking-widest mb-4">JUMLAH PT (KEBUN) PER CRO</h3>
                        <div id="dash-bar-chart" style="height: 300px; width: 100%;"></div>
                    </div>
                    <div class="premium-card p-4 md:p-6 w-full relative overflow-hidden">
                        <h3 id="chart-title-pie" class="text-[10px] font-bold text-[var(--text-muted)] uppercase tracking-widest mb-4">LUAS TM (HA) PER CRO</h3>
                        <div id="dash-pie-chart" style="height: 300px; width: 100%;"></div>
                    </div>
                </div>

                <div class="premium-card p-4 md:p-6 mt-5 w-full mb-8">
                    <h3 id="pt-list-title" class="text-[10px] font-bold text-[var(--text-muted)] uppercase tracking-widest mb-4">REKAPITULASI PIVOT PENUGASAN</h3>
                    <div class="overflow-x-auto">
                        <table class="w-full text-left border-collapse min-w-[500px]">
                            <thead>
                                <tr>
                                    <th class="border-b border-gray-600/30 py-3 px-4 text-[10px] text-gray-400 uppercase bg-blue-500/10 rounded-tl-lg">CRO / TAHAP</th>
                                    <th class="border-b border-gray-600/30 py-3 px-4 text-[10px] text-gray-400 uppercase text-right bg-blue-500/10">TOTAL LUAS TM (HA)</th>
                                    <th class="border-b border-gray-600/30 py-3 px-4 text-[10px] text-gray-400 uppercase text-center bg-blue-500/10 rounded-tr-lg">JUMLAH PT (KEBUN)</th>
                                </tr>
                            </thead>
                            <tbody id="pivot-penugasan-body" class="divide-y divide-gray-600/30"></tbody>
                        </table>
                    </div>
                </div>

                <!-- TABEL KATEGORI MITRA BARU (DINAMIS & BISA FILTER) -->
                <div class="premium-card p-4 md:p-6 mt-5 w-full mb-8">
                    <h3 class="text-[10px] font-bold text-[var(--text-muted)] uppercase tracking-widest mb-4">REKAPITULASI JUMLAH KEBUN DAN PT/CV/KOPERASI</h3>
                    <div class="overflow-x-auto">
                        <table class="w-full text-left border-collapse min-w-[500px]">
                            <thead>
                                <tr>
                                    <th class="border-b border-gray-600/30 py-3 px-4 text-[10px] text-gray-400 uppercase bg-emerald-500/10 rounded-tl-lg">KATEGORI</th>
                                    <th class="border-b border-gray-600/30 py-3 px-4 text-[10px] text-gray-400 uppercase text-center bg-emerald-500/10">JUMLAH KEBUN</th>
                                    <th class="border-b border-gray-600/30 py-3 px-4 text-[10px] text-gray-400 uppercase text-center bg-emerald-500/10 rounded-tr-lg">JUMLAH PT/CV/KOP</th>
                                </tr>
                            </thead>
                            <tbody id="rekap-kategori-body" class="divide-y divide-gray-600/30"></tbody>
                        </table>
                    </div>
                </div>
            </section>

            <!-- ============================================== -->
            <!-- 2. DASHBOARD PEMBATALAN -->
            <!-- ============================================== -->
            <section id="view-pembatalan" class="fade-in hidden">
                <div class="mb-6 flex flex-col sm:flex-row sm:justify-between sm:items-end gap-4">
                    <div>
                        <h2 class="text-xl md:text-2xl font-bold tracking-tight">Dashboard Pembatalan</h2>
                        <p class="text-[10px] md:text-[11px] text-[var(--text-muted)] mt-1 flex items-center gap-1">
                            <svg class="w-3 h-3 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg> Data Akurat tersinkronisasi dari Sheet PIVOT Pembatalan.
                        </p>
                    </div>
                    <div class="flex items-center justify-between sm:justify-start gap-3 premium-card border border-[var(--border-color)] px-4 py-2 rounded-lg shadow-sm">
                        <span class="text-[10px] md:text-[11px] font-bold text-[var(--text-muted)] uppercase tracking-widest">FILTER KATEGORI:</span>
                        <select id="pembatalan-cro-filter" onchange="renderPembatalanDashboard()" class="bg-transparent text-[var(--text-main)] text-xs md:text-sm font-semibold outline-none cursor-pointer border-none !p-0"></select>
                    </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 md:gap-5 mb-8">
                    <div class="relative overflow-hidden premium-card p-6 bg-gradient-to-br from-[rgba(17,17,17,0.8)] to-[rgba(21,21,21,0.9)] border-t-[3px] border-t-red-600 shadow-[0_4px_15px_-4px_rgba(220,38,38,0.2)]">
                        <div class="text-[10px] md:text-xs text-gray-300 font-bold uppercase tracking-widest mb-2">TOTAL SURAT PEMBATALAN</div>
                        <div class="text-3xl md:text-4xl font-extrabold text-white mb-1 tracking-tight" id="kpi-total-batal">0 <span class="text-lg text-gray-400 font-medium tracking-normal">Surat</span></div>
                    </div>
                    <div class="relative overflow-hidden premium-card p-6 bg-gradient-to-br from-[rgba(17,17,17,0.8)] to-[rgba(21,21,21,0.9)] border-t-[3px] border-t-amber-500 shadow-[0_4px_15px_-4px_rgba(245,158,11,0.2)]">
                        <div class="text-[10px] md:text-xs text-gray-300 font-bold uppercase tracking-widest mb-2">TOTAL LUAS TM BATAL</div>
                        <div class="text-3xl md:text-4xl font-extrabold text-white mb-1 tracking-tight" id="kpi-luas-batal">0 <span class="text-lg text-gray-400 font-medium tracking-normal">Ha</span></div>
                    </div>
                </div>

                <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 md:gap-5 mb-8">
                    <div class="premium-card p-4 md:p-6 w-full relative overflow-hidden">
                        <h3 id="pembatalan-chart-title-bar" class="text-[10px] font-bold text-[var(--text-muted)] uppercase tracking-widest mb-4">JUMLAH SURAT PEMBATALAN PER KATEGORI</h3>
                        <div id="dash-chart-pembatalan" style="height: 300px; width: 100%;"></div>
                    </div>
                    <div class="premium-card p-4 md:p-6 w-full relative overflow-hidden">
                        <h3 id="pembatalan-chart-title-pie" class="text-[10px] font-bold text-[var(--text-muted)] uppercase tracking-widest mb-4">LUAS TM (HA) PEMBATALAN PER KATEGORI</h3>
                        <div id="dash-pie-pembatalan" style="height: 300px; width: 100%;"></div>
                    </div>
                </div>

                <div class="premium-card p-4 md:p-6 mt-5 w-full mb-8">
                    <h3 id="pembatalan-list-title" class="text-[10px] font-bold text-[var(--text-muted)] uppercase tracking-widest mb-4">REKAPITULASI PIVOT (PEMBATALAN)</h3>
                    <div class="overflow-x-auto">
                        <table class="w-full text-left border-collapse min-w-[500px]">
                            <thead>
                                <tr>
                                    <th class="border-b border-gray-600/30 py-3 px-4 text-[10px] text-gray-400 uppercase bg-red-500/10 rounded-tl-lg">KATEGORI (CRO / TAHAP)</th>
                                    <th class="border-b border-gray-600/30 py-3 px-4 text-[10px] text-gray-400 uppercase text-center bg-red-500/10">JUMLAH SURAT PEMBATALAN</th>
                                    <th class="border-b border-gray-600/30 py-3 px-4 text-[10px] text-gray-400 uppercase text-right bg-red-500/10 rounded-tr-lg">TOTAL LUAS TM (HA)</th>
                                </tr>
                            </thead>
                            <tbody id="pivot-pembatalan-body" class="divide-y divide-gray-600/30"></tbody>
                        </table>
                    </div>
                </div>
            </section>

            <!-- ============================================== -->
            <!-- 3. MASTER DATA REPOSITORY -->
            <!-- ============================================== -->
            <section id="view-database" class="fade-in hidden">
                <div class="mb-6">
                    <h2 class="text-xl md:text-2xl font-bold tracking-tight" id="database-title">Master Data Repository</h2>
                    <p class="text-xs md:text-sm text-[var(--text-muted)] mt-1">Eksplorasi arsip dokumen dan database terpusat.</p>
                </div>
                
                <div class="premium-card p-4 md:p-6 w-full">
                    <div class="w-full overflow-hidden" id="data-wrapper">
                        <div id="table-area" class="w-full">
                            <table id="mainTable" class="w-full text-left"></table>
                        </div>
                    </div>
                </div>
            </section>
        </main>
    </div>

    <!-- SCRIPT LOGIC -->
    <script>
        function logout() {
            if(confirm("Apakah Anda yakin ingin memuat ulang sesi ini?")) window.location.reload();
        }

        let rawData = <%- sheetData %> || {};
        let currentDataTable = null;
        let currentActiveSheet = null; 

        function toggleSidebar() {
            const sidebar = document.getElementById('mobile-sidebar');
            const overlay = document.getElementById('sidebar-overlay');
            if (sidebar.classList.contains('-translate-x-full')) {
                sidebar.classList.remove('-translate-x-full'); overlay.classList.remove('hidden');
            } else {
                sidebar.classList.add('-translate-x-full'); overlay.classList.add('hidden');
            }
        }

        function toggleTheme() {
            document.body.classList.toggle('light-mode');
            const isLight = document.body.classList.contains('light-mode');
            localStorage.setItem('theme', isLight ? 'light' : 'dark');
            updateChartTheme(isLight);
        }

        function updateChartTheme(isLight) {
            const textColor = isLight ? '#6b7280' : '#a1a1aa';
            const gridColor = isLight ? 'rgba(0,0,0,0.1)' : 'rgba(255,255,255,0.05)';
            const tooltipBg = isLight ? '#ffffff' : '#151515';
            const tooltipText = isLight ? '#1f2937' : '#f8fafc';
            Highcharts.charts.forEach(chart => {
                if (chart) {
                    chart.update({
                        xAxis: { labels: { style: { color: textColor } } },
                        yAxis: { labels: { style: { color: textColor } }, gridLineColor: gridColor },
                        legend: { itemStyle: { color: textColor } },
                        plotOptions: { pie: { dataLabels: { color: textColor } } },
                        tooltip: { backgroundColor: tooltipBg, style: { color: tooltipText }, borderColor: gridColor }
                    });
                }
            });
        }

        function switchView(viewId, elementId, paramName = null) {
            document.getElementById('view-dashboard').classList.add('hidden');
            document.getElementById('view-pembatalan').classList.add('hidden');
            document.getElementById('view-database').classList.add('hidden');
            
            document.getElementById(viewId).classList.remove('hidden');
            
            const headerTitle = document.getElementById('header-title');
            if(viewId === 'view-dashboard') {
                headerTitle.innerText = "Dashboard Rekapitulasi"; currentActiveSheet = 'dashboard'; renderDashboardCharts(); 
            }
            else if(viewId === 'view-pembatalan') {
                headerTitle.innerText = "Dashboard Pembatalan"; currentActiveSheet = 'pembatalan'; renderPembatalanDashboard();
            }
            else if(viewId === 'view-database') {
                headerTitle.innerText = "Master Data > " + paramName; currentActiveSheet = paramName; loadTable(paramName);
            }
            
            document.querySelectorAll('.sidebar-link, .sidebar-child-link').forEach(el => el.classList.remove('active'));
            if (elementId && document.getElementById(elementId)) document.getElementById(elementId).classList.add('active');
            
            if (window.innerWidth < 768) toggleSidebar();
            if(viewId === 'view-database' && currentDataTable) setTimeout(() => currentDataTable.columns.adjust(), 50);
        }

        // PARSER ANGKA
        const parseNum = (val) => {
            if (typeof val === 'number') return val;
            if (!val) return 0;
            let s = String(val).replace(/Rp|\$|€|\s/gi, '').replace(/\./g, '').replace(',', '.');
            let res = parseFloat(s);
            return isNaN(res) ? 0 : res;
        };

        // =========================================
        // MESIN EKSTRAKTOR PIVOT (DEWA LEVEL)
        // =========================================
        function getPivotData() {
            let pivotSheetKey = Object.keys(rawData).find(k => k.trim().toUpperCase() === 'API_PIVOT') || Object.keys(rawData).find(k => k.toUpperCase().includes('PIVOT') && !k.toUpperCase().includes('TABLE'));
            if (!pivotSheetKey) {
                pivotSheetKey = Object.keys(rawData).find(k => {
                    let sheet = rawData[k]; if(!Array.isArray(sheet)) return false;
                    return sheet.some(r => Object.values(r).join(" ").toLowerCase().includes("total keseluruhan"));
                });
            }

            let pivotData = rawData[pivotSheetKey] || [];
            let penugasan = { totalLuas: 0, totalPT: 0, detailsMap: {} };
            let pembatalan = { totalLuas: 0, totalSurat: 0, detailsMap: {} };
            let currentSection = 'PENUGASAN'; 

            const extractNumbers = (rowObj) => {
                let numbers = [];
                Object.values(rowObj).forEach(val => {
                    if (typeof val === 'number') { if (val > 0) numbers.push(val); } 
                    else if (typeof val === 'string') {
                        let s = val.trim();
                        if (s === '-' || s === '' || /[a-zA-Z]/.test(s.replace(/[eE]/g, ''))) return;
                        let parsed = parseNum(s);
                        if (!isNaN(parsed) && parsed > 0) numbers.push(parsed);
                    }
                });
                numbers.sort((a, b) => b - a); 
                return numbers;
            };

            for(let i=0; i < pivotData.length; i++) {
                let row = pivotData[i];
                let vals = Object.values(row).map(v => String(v).trim());
                let rowStr = vals.join(" ").toLowerCase();

                if(rowStr.includes("counta dari na") || rowStr.includes("plang satgas") || rowStr.includes("pembatalan")) {
                    currentSection = 'PEMBATALAN';
                }

                if (rowStr.includes("total keseluruhan")) {
                    let nums = extractNumbers(row);
                    if (nums.length >= 2) {
                        if (currentSection === 'PENUGASAN') { penugasan.totalLuas = nums[0]; penugasan.totalPT = nums[1]; } 
                        else { pembatalan.totalLuas = nums[0]; pembatalan.totalSurat = nums[1]; }
                    }
                    continue;
                }

                let possibleName = vals.find(v => v !== '' && isNaN(parseNum(v)) && !v.toLowerCase().includes("sum dari") && !v.toLowerCase().includes("jumlah pt") && !v.toLowerCase().includes("counta"));
                
                if (possibleName && !rowStr.includes("keseluruhan") && !rowStr.includes("tahap") && rowStr.includes("total")) {
                    let cleanName = possibleName.replace(/Total/ig, '').trim().toUpperCase();
                    let nums = extractNumbers(row);
                    if (nums.length >= 2) {
                        if (currentSection === 'PENUGASAN') { penugasan.detailsMap[cleanName] = { luas: nums[0], item: nums[1] }; }
                    }
                } 
                else if (possibleName && currentSection === 'PEMBATALAN' && !rowStr.includes("total") && !rowStr.includes("cro")) {
                    let cleanName = possibleName.trim();
                    cleanName = cleanName.charAt(0).toUpperCase() + cleanName.slice(1);
                    
                    let nums = extractNumbers(row);
                    if (nums.length >= 2) {
                        pembatalan.detailsMap[cleanName] = { luas: nums[0], item: nums[1] };
                    }
                }
            }
            
            if (penugasan.totalPT === 0) Object.values(penugasan.detailsMap).forEach(v => { penugasan.totalLuas += v.luas; penugasan.totalPT += v.item; });
            if (pembatalan.totalSurat === 0) Object.values(pembatalan.detailsMap).forEach(v => { pembatalan.totalLuas += v.luas; pembatalan.totalSurat += v.item; });

            return { penugasan, pembatalan };
        }

        // =========================================
        // DASHBOARD 1: RENDER PENUGASAN (DENGAN TABEL KATEGORI BARU)
        // =========================================
        function renderDashboardCharts() {
            const pivot = getPivotData().penugasan;
            const filterDropdown = document.getElementById('cro-filter');
            
            let dataList = Object.keys(pivot.detailsMap).sort();
            
            // SETUP DROPDOWN
            if (filterDropdown && filterDropdown.options.length <= 1 && dataList.length > 0) {
                filterDropdown.innerHTML = '<option value="ALL" class="bg-[#111111] text-white">Semua CRO</option>';
                dataList.forEach(c => {
                    let opt = document.createElement('option'); opt.value = c; opt.innerText = c; opt.className = "bg-[#111111] text-white"; filterDropdown.appendChild(opt);
                });
                filterDropdown.value = "ALL";
            }
            const selectedItem = filterDropdown ? filterDropdown.value : 'ALL';

            let dispLuas = 0, dispPT = 0;
            let chartBarDataMap = {}, chartPieDataMap = {}, tableDataMap = {};

            if (selectedItem === 'ALL') {
                dispLuas = pivot.totalLuas; dispPT = pivot.totalPT; tableDataMap = pivot.detailsMap;
                for(let c in pivot.detailsMap) { chartBarDataMap[c] = pivot.detailsMap[c].item; chartPieDataMap[c] = pivot.detailsMap[c].luas; }
            } else {
                if (pivot.detailsMap[selectedItem]) {
                    dispLuas = pivot.detailsMap[selectedItem].luas; dispPT = pivot.detailsMap[selectedItem].item;
                    chartBarDataMap[selectedItem] = pivot.detailsMap[selectedItem].item; chartPieDataMap[selectedItem] = pivot.detailsMap[selectedItem].luas;
                    tableDataMap = { [selectedItem]: pivot.detailsMap[selectedItem] };
                }
            }

            // 1. UPDATE KPI
            document.getElementById('dash-kpi-pt').innerHTML = `${dispPT.toLocaleString('id-ID')} <span class="text-lg text-gray-400 font-medium tracking-normal">PT</span>`;
            document.getElementById('dash-kpi-luas').innerHTML = `${dispLuas.toLocaleString('id-ID', {minimumFractionDigits: 2, maximumFractionDigits: 2})} <span class="text-lg text-gray-400 font-medium tracking-normal">Ha</span>`;

            // 2. UPDATE TEXT TITLES
            const titleSuffix = selectedItem === 'ALL' ? 'SE-INDONESIA' : `(KATEGORI ${selectedItem})`;
            if(document.getElementById('chart-title-bar')) document.getElementById('chart-title-bar').innerText = `JUMLAH PT (KEBUN) ${titleSuffix}`;
            if(document.getElementById('chart-title-pie')) document.getElementById('chart-title-pie').innerText = `LUAS TM (HA) ${titleSuffix}`;

            // 3. RENDER CHARTS
            if(document.getElementById('dash-bar-chart')) {
                Highcharts.chart('dash-bar-chart', {
                    chart: { type: 'column', backgroundColor: 'transparent', marginTop: 30 }, title: { text: null },
                    tooltip: { backgroundColor: 'rgba(21, 21, 21, 0.95)', style: { color: '#ffffff' }, borderWidth: 1, borderColor: '#333333', borderRadius: 8, padding: 12 },
                    xAxis: { categories: Object.keys(chartBarDataMap), labels: { style: { color: '#a1a1aa', fontWeight: '500' } }, lineWidth: 0, tickWidth: 0 },
                    yAxis: { title: { text: null }, gridLineColor: 'rgba(255,255,255,0.05)', labels: { style: { color: '#a1a1aa' } } },
                    series: [{ name: 'Jumlah PT (Kebun)', data: Object.values(chartBarDataMap), color: { linearGradient: { x1: 0, x2: 0, y1: 0, y2: 1 }, stops: [ [0, '#3b82f6'], [1, 'rgba(59, 130, 246, 0.2)'] ] } }],
                    plotOptions: { column: { borderRadius: 6, borderWidth: 0, dataLabels: { enabled: true, color: '#ffffff', style: { textOutline: 'none', fontWeight: 'bold' }, y: -5 } } },
                    credits: { enabled: false }
                });
            }

            if(document.getElementById('dash-pie-chart')) {
                Highcharts.chart('dash-pie-chart', {
                    chart: { type: 'pie', backgroundColor: 'transparent' },
                    title: { text: `<span style="font-size: 10px; color: #a1a1aa;">TOTAL LUAS TM</span><br><span style="font-size: 18px; font-weight: bold; color: #ffffff;">${dispLuas.toLocaleString('id-ID', {maximumFractionDigits:0})}</span>`, align: 'center', verticalAlign: 'middle', y: 10, useHTML: true },
                    tooltip: { backgroundColor: 'rgba(21, 21, 21, 0.95)', style: { color: '#ffffff' }, borderWidth: 1, borderColor: '#333333', borderRadius: 8 },
                    plotOptions: { pie: { innerSize: '75%', borderWidth: 0, dataLabels: { enabled: true, color: '#e5e7eb', style: { textOutline: 'none', fontWeight: '500' }, connectorColor: 'rgba(255,255,255,0.2)' } } },
                    colors: ['#8b5cf6', '#3b82f6', '#10b981', '#f59e0b', '#f43f5e', '#06b6d4', '#6366f1', '#14b8a6', '#f97316', '#84cc16'],
                    series: [{ name: 'Luas TM (Ha)', data: Object.keys(chartPieDataMap).map(k => [k, chartPieDataMap[k]]) }],
                    credits: { enabled: false }
                });
            }

            // 4. RENDER TABEL PIVOT SUMMARY LAMA
            let ptHtml = '';
            for(let name in tableDataMap) {
                let data = tableDataMap[name];
                ptHtml += `
                    <tr class="hover:bg-white/5 transition-colors border-b border-gray-600/30 last:border-0">
                        <td class="py-3 px-4 text-xs md:text-sm text-[var(--text-main)] font-bold">${name}</td>
                        <td class="py-3 px-4 text-xs md:text-sm text-purple-400 text-right font-semibold">${data.luas.toLocaleString('id-ID', {minimumFractionDigits: 2, maximumFractionDigits: 2})}</td>
                        <td class="py-3 px-4 text-xs md:text-sm text-[var(--text-main)] text-center font-semibold">${data.item.toLocaleString('id-ID')}</td>
                    </tr>`;
            }
            if (Object.keys(tableDataMap).length > 0) {
                 ptHtml += `
                    <tr class="bg-blue-500/10 border-t-2 border-blue-500/50">
                        <td class="py-3 px-4 text-xs md:text-sm text-blue-300 font-extrabold uppercase">TOTAL KESELURUHAN</td>
                        <td class="py-3 px-4 text-xs md:text-sm text-blue-300 text-right font-extrabold">${dispLuas.toLocaleString('id-ID', {minimumFractionDigits: 2, maximumFractionDigits: 2})}</td>
                        <td class="py-3 px-4 text-xs md:text-sm text-blue-300 text-center font-extrabold">${dispPT.toLocaleString('id-ID')}</td>
                    </tr>`;
            } else { ptHtml = `<tr><td colspan="3" class="py-6 text-center text-xs md:text-sm text-[var(--text-muted)]">Data Pivot kosong.</td></tr>`; }

            if(document.getElementById('pivot-penugasan-body')) document.getElementById('pivot-penugasan-body').innerHTML = ptHtml;


            // ========================================================
            // 5. RENDER TABEL BARU (KATEGORI MITRA) SECARA DINAMIS
            // ========================================================
            // Baca data raw dari sheet REKAPITULASI buat ngitung dinamis
            let rekapKey = Object.keys(rawData).find(k => k.trim().toUpperCase() === "REKAPITULASI PENUGASAN") || Object.keys(rawData).find(k => k.trim().toUpperCase() === "REKAPITULASI") || Object.keys(rawData)[0];
            let rekapDataRaw = rawData[rekapKey] || [];
            
            let filteredPtList = [];
            
            if (rekapDataRaw.length > 0) {
                let rCols = Object.keys(rekapDataRaw[0] || {});
                let cCro = rCols.find(k => k.toLowerCase() === 'cro' || k.toLowerCase().includes('regional')) || rCols[2] || rCols[0];
                let cPt = rCols.find(k => k.toLowerCase() === 'nama pt' || k.toLowerCase().includes('perusahaan') || k.toLowerCase().includes('koperasi')) || rCols[5] || rCols[1];
                let cMitra = rCols.find(k => k.toLowerCase().includes('nama mitra')) || cPt;

                for (let i = 0; i < rekapDataRaw.length; i++) {
                    let row = rekapDataRaw[i];
                    let rawCro = String(row[cCro] || "").replace(/^[+-]\s*/, '').trim().toUpperCase();
                    let pt = String(row[cPt] || "").trim();
                    let mitra = String(row[cMitra] || pt).trim();

                    if (pt.toLowerCase().includes("total") || rawCro.includes("TOTAL")) break; 
                    if (!rawCro || rawCro === "-" || rawCro === "CRO" || !pt || pt === "-") continue;

                    if (selectedItem === 'ALL' || selectedItem === rawCro) {
                        filteredPtList.push({ name: pt, mitra: mitra, cro: rawCro });
                    }
                }
            }

            // Object buat nampung hitungan Kategori
            let catSummary = {
                "PT": { kebun: 0, unique: new Set() },
                "CV": { kebun: 0, unique: new Set() },
                "Koperasi": { kebun: 0, unique: new Set() },
                "Kelompok Tani": { kebun: 0, unique: new Set() },
                "Bumdes": { kebun: 0, unique: new Set() },
                "Perkumpulan": { kebun: 0, unique: new Set() }
            };

            let totalKebun = 0;
            let allUnique = new Set();

            // Klasifikasi berdasarkan "Nama Mitra"
            filteredPtList.forEach(p => {
                let mName = (p.mitra || p.name).toUpperCase();
                let cat = "PT"; // Default
                
                if (mName.includes("CV ") || mName.startsWith("CV")) cat = "CV";
                else if (mName.includes("KOPERASI") || mName.includes("KUD ") || mName.includes("KOP ")) cat = "Koperasi";
                else if (mName.includes("KELOMPOK TANI") || mName.includes("POKTAN") || mName.includes("KTNA")) cat = "Kelompok Tani";
                else if (mName.includes("BUMDES")) cat = "Bumdes";
                else if (mName.includes("PERKUMPULAN")) cat = "Perkumpulan";

                catSummary[cat].kebun++;
                catSummary[cat].unique.add(mName);
                totalKebun++;
                allUnique.add(mName);
            });

            // Susun HTML untuk tabel Kategori Baru
            let catHtml = '';
            const catOrder = ["PT", "CV", "Koperasi", "Kelompok Tani", "Bumdes", "Perkumpulan"];
            
            catOrder.forEach(c => {
                let item = catSummary[c];
                // Tampilkan semua baris agar layout konsisten (seperti foto Excel lu)
                catHtml += `
                    <tr class="hover:bg-white/5 transition-colors border-b border-gray-600/30 last:border-0">
                        <td class="py-3 px-4 text-xs md:text-sm text-[var(--text-main)] font-semibold">${c}</td>
                        <td class="py-3 px-4 text-xs md:text-sm text-[var(--text-main)] text-center font-semibold">${item.kebun.toLocaleString('id-ID')}</td>
                        <td class="py-3 px-4 text-xs md:text-sm text-[var(--text-main)] text-center font-semibold">${item.unique.size.toLocaleString('id-ID')}</td>
                    </tr>
                `;
            });

            // Baris Total Penugasan
            catHtml += `
                <tr class="bg-emerald-500/10 border-t-2 border-emerald-500/50">
                    <td class="py-3 px-4 text-xs md:text-sm text-emerald-400 font-extrabold uppercase">Total Penugasan</td>
                    <td class="py-3 px-4 text-xs md:text-sm text-emerald-400 text-center font-extrabold">${totalKebun.toLocaleString('id-ID')}</td>
                    <td class="py-3 px-4 text-xs md:text-sm text-emerald-400 text-center font-extrabold">${allUnique.size.toLocaleString('id-ID')}</td>
                </tr>
            `;

            if(document.getElementById('rekap-kategori-body')) {
                document.getElementById('rekap-kategori-body').innerHTML = catHtml;
            }

            updateChartTheme(document.body.classList.contains('light-mode'));
        }

        // =========================================
        // DASHBOARD 2: RENDER PEMBATALAN
        // =========================================
        function renderPembatalanDashboard() {
            const pivot = getPivotData().pembatalan;
            const filterDropdown = document.getElementById('pembatalan-cro-filter');
            
            let dataList = Object.keys(pivot.detailsMap).sort();

            if (filterDropdown && filterDropdown.options.length <= 1 && dataList.length > 0) {
                filterDropdown.innerHTML = '<option value="ALL" class="bg-[#111111] text-white">Semua Kategori</option>';
                dataList.forEach(c => {
                    let opt = document.createElement('option'); opt.value = c; opt.innerText = c; opt.className = "bg-[#111111] text-white"; filterDropdown.appendChild(opt);
                });
                filterDropdown.value = "ALL";
            }
            const selectedItem = filterDropdown ? filterDropdown.value : 'ALL';

            let dispLuas = 0, dispSurat = 0;
            let chartBarDataMap = {}, chartPieDataMap = {}, tableDataMap = {};

            if (selectedItem === 'ALL') {
                dispLuas = pivot.totalLuas; dispSurat = pivot.totalSurat; tableDataMap = pivot.detailsMap;
                for(let c in pivot.detailsMap) { chartBarDataMap[c] = pivot.detailsMap[c].item; chartPieDataMap[c] = pivot.detailsMap[c].luas; }
            } else {
                if (pivot.detailsMap[selectedItem]) {
                    dispLuas = pivot.detailsMap[selectedItem].luas; dispSurat = pivot.detailsMap[selectedItem].item;
                    chartBarDataMap[selectedItem] = pivot.detailsMap[selectedItem].item; chartPieDataMap[selectedItem] = pivot.detailsMap[selectedItem].luas;
                    tableDataMap = { [selectedItem]: pivot.detailsMap[selectedItem] };
                }
            }

            document.getElementById('kpi-total-batal').innerHTML = `${dispSurat.toLocaleString('id-ID')} <span class="text-lg text-gray-400 font-medium tracking-normal">Surat</span>`;
            document.getElementById('kpi-luas-batal').innerHTML = `${dispLuas.toLocaleString('id-ID', {minimumFractionDigits: 2, maximumFractionDigits: 2})} <span class="text-lg text-gray-400 font-medium tracking-normal">Ha</span>`;

            const titleSuffix = selectedItem === 'ALL' ? 'SE-INDONESIA' : `(KATEGORI ${selectedItem})`;
            if(document.getElementById('pembatalan-chart-title-bar')) document.getElementById('pembatalan-chart-title-bar').innerText = `JUMLAH SURAT PEMBATALAN ${titleSuffix}`;
            if(document.getElementById('pembatalan-chart-title-pie')) document.getElementById('pembatalan-chart-title-pie').innerText = `LUAS TM (HA) PEMBATALAN ${titleSuffix}`;

            if(document.getElementById('dash-chart-pembatalan')) {
                Highcharts.chart('dash-chart-pembatalan', {
                    chart: { type: 'column', backgroundColor: 'transparent', marginTop: 30 }, title: { text: null },
                    tooltip: { backgroundColor: 'rgba(21, 21, 21, 0.95)', style: { color: '#ffffff' }, borderWidth: 1, borderColor: '#333333', borderRadius: 8, padding: 12 },
                    xAxis: { categories: Object.keys(chartBarDataMap), labels: { style: { color: '#a1a1aa', fontWeight: '500' } }, lineWidth: 0, tickWidth: 0 },
                    yAxis: { title: { text: null }, gridLineColor: 'rgba(255,255,255,0.05)', labels: { style: { color: '#a1a1aa' } } },
                    series: [{ name: 'Jumlah Surat Selesai', data: Object.values(chartBarDataMap), color: { linearGradient: { x1: 0, x2: 0, y1: 0, y2: 1 }, stops: [ [0, '#ef4444'], [1, '#7f1d1d'] ] } }],
                    plotOptions: { column: { borderRadius: 6, borderWidth: 0, dataLabels: { enabled: true, color: '#ffffff', style: { textOutline: 'none', fontWeight: 'bold' }, y: -5 } } },
                    credits: { enabled: false }
                });
            }

            if(document.getElementById('dash-pie-pembatalan')) {
                Highcharts.chart('dash-pie-pembatalan', {
                    chart: { type: 'pie', backgroundColor: 'transparent' },
                    title: { text: `<span style="font-size: 10px; color: #a1a1aa;">TOTAL LUAS (HA)</span><br><span style="font-size: 18px; font-weight: bold; color: #ffffff;">${dispLuas.toLocaleString('id-ID', {maximumFractionDigits:0})}</span>`, align: 'center', verticalAlign: 'middle', y: 10, useHTML: true },
                    tooltip: { backgroundColor: 'rgba(21, 21, 21, 0.95)', style: { color: '#ffffff' }, borderWidth: 1, borderColor: '#333333', borderRadius: 8 },
                    plotOptions: { pie: { innerSize: '75%', borderWidth: 0, dataLabels: { enabled: true, color: '#e5e7eb', style: { textOutline: 'none', fontWeight: '500' }, connectorColor: 'rgba(255,255,255,0.2)' } } },
                    colors: ['#ef4444', '#f59e0b', '#8b5cf6', '#3b82f6', '#10b981', '#f43f5e', '#06b6d4', '#6366f1', '#14b8a6', '#f97316'],
                    series: [{ name: 'Luas TM Batal (Ha)', data: Object.keys(chartPieDataMap).map(k => [k, chartPieDataMap[k]]) }],
                    credits: { enabled: false }
                });
            }

            let ptBatalHtml = '';
            for(let name in tableDataMap) {
                let data = tableDataMap[name];
                ptBatalHtml += `
                    <tr class="hover:bg-white/5 transition-colors border-b border-gray-600/30 last:border-0">
                        <td class="py-3 px-4 text-xs md:text-sm text-[var(--text-main)] font-bold">${name}</td>
                        <td class="py-3 px-4 text-xs md:text-sm text-[var(--text-main)] text-center font-semibold">${data.item.toLocaleString('id-ID')}</td>
                        <td class="py-3 px-4 text-xs md:text-sm text-red-400 text-right font-semibold">${data.luas.toLocaleString('id-ID', {minimumFractionDigits: 2, maximumFractionDigits: 2})}</td>
                    </tr>`;
            }

            if (Object.keys(tableDataMap).length > 0) {
                 ptBatalHtml += `
                    <tr class="bg-red-500/10 border-t-2 border-red-500/50">
                        <td class="py-3 px-4 text-xs md:text-sm text-red-300 font-extrabold uppercase">TOTAL KESELURUHAN</td>
                        <td class="py-3 px-4 text-xs md:text-sm text-red-300 text-center font-extrabold">${dispSurat.toLocaleString('id-ID')}</td>
                        <td class="py-3 px-4 text-xs md:text-sm text-red-300 text-right font-extrabold">${dispLuas.toLocaleString('id-ID', {minimumFractionDigits: 2, maximumFractionDigits: 2})}</td>
                    </tr>`;
            } else { ptBatalHtml = `<tr><td colspan="3" class="text-center py-6 text-xs md:text-sm text-[var(--text-muted)]">Data Pivot kosong.</td></tr>`; }

            if(document.getElementById('pivot-pembatalan-body')) document.getElementById('pivot-pembatalan-body').innerHTML = ptBatalHtml;
            updateChartTheme(document.body.classList.contains('light-mode'));
        }

        // =========================================
        // TOOLS MASTER DATA 
        // =========================================
        $(document).on('click', '.hide-col-btn', function(e) {
            e.stopPropagation(); e.preventDefault();
            let th = $(this).closest('th');
            let wrapper = $(this).closest('.dataTables_wrapper');
            let mainTable = wrapper.find('.dataTables_scrollBody table');
            if(mainTable.length > 0) {
                let table = $('#' + mainTable.attr('id')).DataTable();
                table.column(table.column(th).index()).visible(false);
                setTimeout(() => { table.columns.adjust(); }, 50);
            }
        });

        function loadTable(sheetName) {
            document.getElementById('table-area').classList.remove('hidden');
            let actualKey = sheetName;
            
            if (sheetName === "REKAPITULASI") {
                actualKey = Object.keys(rawData).find(k => k.trim().toUpperCase().includes("REKAPITULASI PENUGASAN")) || Object.keys(rawData).find(k => k.trim().toUpperCase() === "REKAPITULASI") || "REKAPITULASI PENUGASAN";
            } else if (sheetName === "REKAPITULASI PEMBATALAN") {
                actualKey = Object.keys(rawData).find(k => k.trim().toUpperCase() === "REKAPITULASI PEMBATALAN") || "REKAPITULASI PEMBATALAN";
            }

            const dataFull = rawData[actualKey] || [];
            let data = [];
            for(let i=0; i<dataFull.length; i++) {
                let rowStr = JSON.stringify(dataFull[i]).toLowerCase();
                if(rowStr.includes('"nama pt":"total"') || rowStr.includes('"cro":"total"')) continue;
                data.push(dataFull[i]);
            }

            if ($.fn.DataTable.isDataTable('#mainTable')) { $('#mainTable').DataTable().destroy(); $('#mainTable').empty(); }
            if (data.length === 0) { $('#mainTable').html(`<tbody><tr><td class="text-center py-12 text-[var(--text-muted)] text-sm">Tidak ada data tersedia pada sheet ini.</td></tr></tbody>`); return; }

            const validKeys = []; let allKeysSet = new Set();
            data.forEach(row => Object.keys(row).forEach(k => allKeysSet.add(k)));
            let allKeys = Array.from(allKeysSet);

            allKeys.forEach(key => {
                let isGhost = true;
                for(let i=0; i < data.length; i++) {
                    let v = data[i][key];
                    if (v !== undefined && v !== null && String(v).trim() !== '' && String(v).trim() !== '-') { isGhost = false; break; }
                }
                if (!isGhost) validKeys.push(key);
            });

            const columns = validKeys.map(key => {
                let displayTitle = key.startsWith('__EMPTY') ? "-" : key.replace(/_\d+$/, '').trim();
                let numTitle = parseFloat(displayTitle);
                if (!isNaN(numTitle) && numTitle > 40000 && numTitle < 50000) {
                    let d = new Date(Math.round((numTitle - 25569) * 86400000));
                    displayTitle = d.getUTCDate() + '/' + (d.getUTCMonth() + 1);
                }
                let isDateCol = displayTitle.toLowerCase().includes('tgl') || displayTitle.toLowerCase().includes('tanggal') || displayTitle.toLowerCase().includes('waktu');
                
                return { 
                    title: `<div class="flex justify-between items-center group"><span class="whitespace-nowrap">${displayTitle}</span><button type="button" class="hide-col-btn opacity-0 group-hover:opacity-100 text-red-500 hover:text-red-300 ml-2 px-1 rounded transition-opacity" title="Hapus Kolom">✖</button></div>`, 
                    data: key, defaultContent: "-", 
                    render: function(val) {
                        if (isDateCol && typeof val === 'number') {
                            let d = new Date(Math.round((val - 25569) * 86400000));
                            return `${d.getUTCDate().toString().padStart(2, '0')}/${(d.getUTCMonth() + 1).toString().padStart(2, '0')}/${d.getUTCFullYear()}`;
                        }
                        if (typeof val === 'number') { return val % 1 !== 0 ? val.toLocaleString('id-ID', {maximumFractionDigits: 2}) : val.toLocaleString('id-ID'); }
                        if (typeof val === 'string' && (val.includes('http://') || val.includes('https://'))) { return `<a href="${val}" target="_blank" class="text-blue-500 hover:underline">Buka Link</a>`; }
                        return val;
                    }
                };
            });

            currentDataTable = $('#mainTable').DataTable({
                data: data, columns: columns, scrollX: true, pageLength: 10, ordering: false, colReorder: true, 
                language: { search: "", searchPlaceholder: "Cari Data...", lengthMenu: "Tampil _MENU_ baris", info: "Menampilkan _START_ - _END_ dari _TOTAL_ data", paginate: { previous: "Prev", next: "Next" } }
            });
        }

        document.addEventListener("DOMContentLoaded", function() {
            if (localStorage.getItem('theme') === 'light') { document.body.classList.add('light-mode'); const themeIcon = document.getElementById('theme-icon'); if(themeIcon) themeIcon.innerHTML = `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"></path>`; }
            
            const sidebarMaster = document.getElementById('sidebar-master-data');
            if(sidebarMaster) {
                const masterItems = [ { id: "REKAPITULASI", display: "REKAPITULASI" }, { id: "REKAPITULASI PEMBATALAN", display: "REKAPITULASI PEMBATALAN" } ];
                masterItems.forEach((item, idx) => {
                    const btn = document.createElement('button'); btn.id = 'nav-md-' + idx; btn.className = 'w-full sidebar-child-link text-left group'; 
                    btn.innerHTML = `<svg class="w-4 h-4 mr-3 opacity-50 group-hover:opacity-100 transition-opacity shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg> <span class="whitespace-normal leading-snug tracking-wide">${item.display}</span>`;
                    btn.onclick = () => switchView('view-database', btn.id, item.id); sidebarMaster.appendChild(btn);
                });
            }

            const isLightInit = document.body.classList.contains('light-mode');
            Highcharts.setOptions({ colors: ['#3b82f6', '#8b5cf6', '#f97316', '#10b981', '#f43f5e', '#06b6d4'], credits: { enabled: false }, chart: { style: { fontFamily: 'Inter' } } });
            updateChartTheme(isLightInit);
            switchView('view-dashboard', 'nav-dashboard'); 
            
            window.addEventListener('resize', () => { if(currentDataTable) setTimeout(() => currentDataTable.columns.adjust(), 200); });
            
            async function syncData() {
                const syncText = document.getElementById('sync-text'); const syncDot = document.getElementById('sync-dot');
                try {
                    const response = await fetch('/api/check-updates?t=' + new Date().getTime()); const result = await response.json();
                    if (result.rawData && Object.keys(result.rawData).length > 0 && JSON.stringify(rawData) !== JSON.stringify(result.rawData)) {
                        rawData = result.rawData;
                        if (currentActiveSheet === 'dashboard') renderDashboardCharts(); else if (currentActiveSheet === 'pembatalan') renderPembatalanDashboard(); else loadTable(currentActiveSheet);
                        if(syncText && syncDot) {
                            syncText.innerText = "UPDATING..."; syncText.classList.remove('text-emerald-500', 'text-red-500'); syncText.classList.add('text-blue-500');
                            syncDot.innerHTML = `<span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-blue-400 opacity-75"></span><span class="relative inline-flex rounded-full h-1.5 w-1.5 bg-blue-500"></span>`;
                            setTimeout(() => { syncText.innerText = "LIVE SYSTEM"; syncText.classList.add('text-emerald-500'); syncText.classList.remove('text-blue-500'); syncDot.innerHTML = `<span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span><span class="relative inline-flex rounded-full h-1.5 w-1.5 bg-emerald-500"></span>`; }, 3000);
                        }
                    }
                } catch (err) { 
                    if(syncText && syncDot) { syncText.innerText = "KONEKSI LAMBAT"; syncText.classList.remove('text-blue-500', 'text-emerald-500'); syncText.classList.add('text-red-500'); syncDot.innerHTML = `<span class="relative inline-flex rounded-full h-1.5 w-1.5 bg-red-500"></span>`; }
                }
            }
            setInterval(syncData, 10000); 
        });
    </script>
</body>
</html>
