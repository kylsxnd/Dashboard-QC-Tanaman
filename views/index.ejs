    <!-- =========================================
         JAVASCRIPT LOGIC
         ========================================= -->
    <script>
        // Data dari backend server.js
        let rawData = <%- sheetData %> || {};
        let logsData = <%- logsData %> || []; 
        let emailsData = <%- emailsData %> || []; 
        
        // Daftar Sheet untuk Halaman "Master Data Kebun" (Sheet 1)
        const listSheets = [
            "REKAPITULASI", 
            "Pivot Table", 
            "Pembayaran Vendor", 
            "Draft Surat Penugasan", 
            "INPUT ASTA", 
            "Acuan Nama Kebun", 
            "Acuan Nama CRO & Region", 
            "Perubahan CV ke PT", 
            "Rekap Vendor"
        ];
        
        // Daftar Sheet untuk Halaman "Evaluasi Kinerja" (Sheet 2)
        const listEvaluasiSheets = [
            "Sumber/Source Data", 
            "Kinerja Prod", 
            "Rekap Kemitraan", 
            "Rekapan", 
            "Executive Summary"
        ];
        
        let currentDataTable = null;
        let evaluasiDataTable = null;
        let isUnread = false; 

        // =========================================
        // FUNGSI TOGGLE SIDEBAR UNTUK HP
        // =========================================
        function toggleSidebar() {
            const sidebar = document.getElementById('mobile-sidebar');
            const overlay = document.getElementById('sidebar-overlay');
            
            if (sidebar.classList.contains('-translate-x-full')) {
                // Buka Sidebar
                sidebar.classList.remove('-translate-x-full');
                overlay.classList.remove('hidden');
                setTimeout(() => overlay.classList.remove('opacity-0'), 10);
            } else {
                // Tutup Sidebar
                sidebar.classList.add('-translate-x-full');
                overlay.classList.add('opacity-0');
                setTimeout(() => overlay.classList.add('hidden'), 300);
            }
        }

        // =========================================
        // FUNGSI GANTI TEMA (LIGHT / DARK)
        // =========================================
        function toggleTheme() {
            document.body.classList.toggle('light-mode');
            const isLight = document.body.classList.contains('light-mode');
            
            localStorage.setItem('theme', isLight ? 'light' : 'dark');
            
            const themeIcon = document.getElementById('theme-icon');
            if (isLight) {
                themeIcon.innerHTML = `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"></path>`;
            } else {
                themeIcon.innerHTML = `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path>`;
            }
            
            updateChartTheme(isLight);
        }

        function updateChartTheme(isLight) {
            const textColor = isLight ? '#6b7280' : '#a1a1aa';
            const gridColor = isLight ? '#e5e7eb' : '#262626';
            const tooltipBg = isLight ? '#ffffff' : '#151515';
            const tooltipText = isLight ? '#1f2937' : '#f8fafc';
            
            Highcharts.charts.forEach(chart => {
                if (chart) {
                    chart.update({
                        xAxis: { labels: { style: { color: textColor } } },
                        yAxis: { labels: { style: { color: textColor } }, gridLineColor: gridColor },
                        legend: { itemStyle: { color: textColor } },
                        plotOptions: { pie: { dataLabels: { color: textColor } } },
                        tooltip: { backgroundColor: tooltipBg, style: { color: tooltipText }, borderColor: gridColor }
                    });
                }
            });
        }

        // =========================================
        // FUNGSI NAVIGASI MENU SIDEBAR KIRI
        // =========================================
        function switchView(viewId, elementId) {
            // Sembunyikan semua halaman
            document.getElementById('view-dashboard').classList.add('hidden');
            document.getElementById('view-database').classList.add('hidden');
            document.getElementById('view-evaluasi').classList.add('hidden');
            document.getElementById('view-inbox').classList.add('hidden');
            
            // Tampilkan halaman yang dipilih
            document.getElementById(viewId).classList.remove('hidden');
            
            const headerTitle = document.getElementById('header-title');
            if(viewId === 'view-dashboard') {
                headerTitle.innerText = "Executive On-Farm > Dashboard";
            } else if(viewId === 'view-database') {
                headerTitle.innerText = "Executive On-Farm > Master Data";
            } else if(viewId === 'view-evaluasi') {
                headerTitle.innerText = "Executive On-Farm > Evaluasi Kinerja";
            } else if(viewId === 'view-inbox') {
                headerTitle.innerText = "Executive On-Farm > Inbox Email";
                
                fetch('/api/read-emails?t=' + new Date().getTime(), { method: 'POST' }).then(() => {
                    const badge = document.getElementById('sidebar-email-badge');
                    if(badge) { 
                        badge.classList.add('hidden'); 
                        badge.classList.remove('badge-pop'); 
                    }
                    
                    document.querySelectorAll('.email-row.bg-blue-500\\/5').forEach(el => {
                        el.classList.remove('bg-blue-500/5');
                        el.querySelector('.email-sender').classList.remove('font-bold', 'text-white');
                        el.querySelector('.email-subject').classList.remove('font-bold', 'text-white');
                    });
                });
            }
            
            document.getElementById('nav-dashboard').classList.remove('active');
            document.getElementById('nav-database').classList.remove('active');
            document.getElementById('nav-evaluasi').classList.remove('active');
            document.getElementById('nav-inbox').classList.remove('active');
            document.getElementById(elementId).classList.add('active');
            
            // Auto close sidebar if on mobile screen
            if (window.innerWidth < 768) {
                toggleSidebar();
            }
            
            if(viewId === 'view-database' && currentDataTable) { 
                setTimeout(() => {
                    currentDataTable.columns.adjust(); 
                }, 50);
            }
            
            // Atur tabel evaluasi jika yang dibuka bukan tab khusus Rekap Kemitraan
            const activeEvalTab = document.querySelector('#evaluasi-tab-container .tab-active');
            if(viewId === 'view-evaluasi' && evaluasiDataTable && activeEvalTab && activeEvalTab.dataset.sheet !== "Rekap Kemitraan") { 
                setTimeout(() => {
                    evaluasiDataTable.columns.adjust(); 
                }, 50);
            }
        }

        function markAsRead() { 
            document.getElementById('notif-badge').classList.add('hidden'); 
            isUnread = false; 
        }

        // =========================================
        // FUNGSI UPDATE LABEL EMAIL
        // =========================================
        async function changeEmailLabel(id, newLabel) {
            try {
                const res = await fetch('/api/update-email-label?t=' + new Date().getTime(), {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ id: id, label: newLabel })
                });
                const data = await res.json();
                if(data.success) { 
                    emailsData = data.emails; 
                    renderEmailsUI(); 
                }
            } catch (err) { 
                console.error(err); 
            }
        }

        // =========================================
        // FUNGSI RENDER EMAIL UI KE HALAMAN INBOX
        // =========================================
        function renderEmailsUI() {
            const container = document.getElementById('email-list-container');
            let html = '';
            
            if(emailsData && emailsData.length > 0) {
                emailsData.forEach(email => {
                    const bgClass = email.unread ? 'bg-blue-500/5' : 'hover:bg-[var(--hover-bg)]';
                    const textSenderClass = email.unread ? 'font-bold text-white' : 'font-medium theme-text-main';
                    const textSubjectClass = email.unread ? 'font-bold text-white' : 'font-medium theme-text-main';
                    const dotClass = email.unread ? '<div class="w-2 h-2 bg-blue-500 rounded-full mr-2 md:mr-3 shrink-0"></div>' : '<div class="w-2 h-2 mr-2 md:mr-3 shrink-0"></div>';
                    
                    let badgeColor = email.label === "SUDAH DI CRO" 
                        ? "bg-emerald-500/10 text-emerald-400 border-emerald-500/20" 
                        : "bg-amber-500/10 text-amber-400 border-amber-500/20";

                    html += `
                        <div class="email-row flex flex-col md:flex-row md:items-center justify-between px-4 md:px-6 py-4 cursor-pointer transition-colors border-b theme-border last:border-0 ${bgClass} gap-3 md:gap-0">
                            <div class="flex items-center gap-3 md:gap-4 min-w-0 pr-0 md:pr-4">
                                ${dotClass}
                                <div class="w-8 h-8 md:w-10 md:h-10 rounded-full bg-[var(--hover-bg)] border theme-border flex items-center justify-center text-xs font-bold theme-text-main shrink-0">
                                    ${email.sender.charAt(0)}
                                </div>
                                <div class="min-w-0">
                                    <div class="flex items-center gap-2 mb-0.5 md:mb-1">
                                        <span class="email-sender text-[11px] md:text-xs truncate ${textSenderClass}">${email.sender}</span>
                                        <span class="text-[9px] md:text-[10px] theme-text-muted shrink-0">• ${email.time}</span>
                                    </div>
                                    <h4 class="email-subject text-xs md:text-sm truncate mb-0.5 ${textSubjectClass}">${email.subject}</h4>
                                    <p class="text-[10px] md:text-xs theme-text-muted truncate">${email.snippet}</p>
                                </div>
                            </div>
                            
                            <div class="shrink-0 flex items-center pl-10 md:pl-0">
                                <select onchange="changeEmailLabel(${email.id}, this.value)" class="text-[10px] md:text-xs font-semibold px-2 py-1 md:px-3 md:py-1.5 rounded-lg border cursor-pointer outline-none transition-all ${badgeColor}">
                                    <option value="BELUM DI CRO" ${email.label === 'BELUM DI CRO' ? 'selected' : ''}>BELUM DI CRO</option>
                                    <option value="SUDAH DI CRO" ${email.label === 'SUDAH DI CRO' ? 'selected' : ''}>SUDAH DI CRO</option>
                                </select>
                            </div>
                        </div>
                    `;
                });
            } else {
                html = `<div class="p-8 text-center text-sm theme-text-muted">Tidak ada email masuk.</div>`;
            }
            if(container) {
                container.innerHTML = html;
            }
        }

        // =========================================
        // FUNGSI RENDER NOTIFIKASI LOG PERUBAHAN
        // =========================================
        function renderNotifications() {
            const listContainer = document.getElementById('notif-list');
            const badge = document.getElementById('notif-badge');
            
            if (logsData && logsData.length > 0) {
                if (isUnread && badge) {
                    badge.classList.remove('hidden'); 
                }
                
                let html = '';
                logsData.forEach(log => {
                    html += `
                        <div class="mb-3 pb-3 border-b theme-border last:border-0 last:mb-0 last:pb-0">
                            <div class="flex justify-between items-center mb-1">
                                <span class="text-[10px] font-semibold text-blue-500 uppercase tracking-wider">${log.sheet}</span>
                                <div class="flex items-center gap-1 text-[10px] theme-text-muted">
                                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                                    ${log.waktu}
                                </div>
                            </div>
                            <div class="text-xs theme-text-muted mb-2">
                                Row <span class="theme-text-main font-medium">${log.baris}</span>, Col <span class="theme-text-main font-medium">${log.kolom}</span>
                            </div>
                            <div class="text-xs theme-bg-main border theme-border rounded py-1.5 px-2">
                                <div class="flex items-center gap-2 theme-text-muted line-through mb-1">
                                    <svg class="w-3 h-3 text-red-500/70" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 12H4"></path></svg>
                                    <span class="truncate">${log.lama}</span>
                                </div>
                                <div class="flex items-center gap-2 text-emerald-500">
                                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
                                    <span class="truncate">${log.baru}</span>
                                </div>
                            </div>
                        </div>
                    `;
                });
                if(listContainer) {
                    listContainer.innerHTML = html;
                }
            } else {
                if(listContainer) {
                    listContainer.innerHTML = `
                        <div class="flex flex-col items-center justify-center py-8 text-center">
                            <svg class="w-8 h-8 theme-text-muted mb-3 opacity-50" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
                            <p class="text-xs theme-text-muted font-medium">Belum ada perubahan data.</p>
                        </div>
                    `;
                }
            }
        }

        // =========================================
        // PENGATURAN DASHBOARD PIVOT UTAMA (TAMPILAN NAMA PT DIKEMBALIKAN)
        // =========================================
        function renderPivotDashboard() {
            const filterDropdown = document.getElementById('cro-filter');
            const selectedCRO = filterDropdown ? filterDropdown.value : 'ALL';
            
            // Mengambil langsung dari sumber mentah (REKAPITULASI)
            const rawRekapData = rawData["REKAPITULASI"] || [];
            
            let croList = new Set();
            let totalLuas = 0;
            let totalLuasTM = 0;
            let totalTarget = 0;
            let totalPtCount = 0;
            
            let chartBarDataMap = {};
            let chartPieDataMap = {};
            let ptDataMap = {}; 

            // Fungsi helper pembersih format angka dari Excel
            const parseNum = (val) => {
                if (typeof val === 'number') return val;
                if (!val || val === '-' || String(val).trim() === '') return 0;
                let s = String(val).trim().replace(/Rp|\$|€| /gi, '');

                if (s.includes(',') && s.includes('.')) {
                    let lastComma = s.lastIndexOf(',');
                    let lastDot = s.lastIndexOf('.');
                    if (lastComma > lastDot) {
                        s = s.replace(/\./g, '').replace(',', '.'); 
                    } else {
                        s = s.replace(/,/g, ''); 
                    }
                } else if (s.includes(',')) {
                    if ((s.match(/,/g) || []).length > 1) {
                        s = s.replace(/,/g, ''); 
                    } else if (s.length - s.lastIndexOf(',') <= 3) {
                        s = s.replace(',', '.'); 
                    } else {
                        s = s.replace(/,/g, '');
                    }
                }
                return parseFloat(s) || 0;
            };

            // Pelacak Kolom Otomatis (Dynamic Header Detection)
            let keyCRO = "CRO", keyPT = "Nama PT", keyLuas = "Luas Kebun (Ha)", keyLuasTM = "Luas TM (Ha)", keyTarget = "Target Produksi (Ton)";
            if (rawRekapData.length > 0) {
                const sampleKeys = Object.keys(rawRekapData[0]);
                keyCRO = sampleKeys.find(k => k.toLowerCase() === 'cro' || k.toLowerCase().includes('cro')) || "CRO";
                keyPT = sampleKeys.find(k => k.toLowerCase().includes('nama pt') || k.toLowerCase().includes('perusahaan')) || "Nama PT";
                keyLuas = sampleKeys.find(k => k.toLowerCase().includes('luas kebun')) || "Luas Kebun (Ha)";
                keyLuasTM = sampleKeys.find(k => k.toLowerCase().includes('luas tm')) || "Luas TM (Ha)";
                keyTarget = sampleKeys.find(k => k.toLowerCase().includes('target produksi') || k.toLowerCase().includes('target')) || "Target Produksi (Ton)";
            }

            // Loop untuk kalkulasi data
            rawRekapData.forEach(row => {
                let rowCRO = String(row[keyCRO] || "").replace(/^[+-]\s*/, '').trim();
                let namaPt = String(row[keyPT] || "").trim();

                // Skip baris kosong atau baris "Total" bawaan dari pivot/rekap agar tidak dobel hitung
                if (!rowCRO || rowCRO === "-" || rowCRO.toLowerCase().includes("total") || rowCRO.toLowerCase().includes("summary")) return;
                if (!namaPt || namaPt === "-" || namaPt.toLowerCase().includes("total") || namaPt.toLowerCase().includes("summary")) return;

                croList.add(rowCRO);

                // Filter CRO Dropdown
                if (selectedCRO !== 'ALL' && rowCRO !== selectedCRO) return;

                let luasKebun = parseNum(row[keyLuas]);
                let luasTM = parseNum(row[keyLuasTM]);
                let targetProd = parseNum(row[keyTarget]);

                totalLuas += luasKebun;
                totalLuasTM += luasTM;
                totalTarget += targetProd;
                
                totalPtCount++; 

                // Agregasi per PT untuk ditampilkan di Tabel Daftar Perusahaan
                if (!ptDataMap[namaPt]) {
                    ptDataMap[namaPt] = { cro: rowCRO, luas: 0, luasTM: 0, target: 0 };
                }
                ptDataMap[namaPt].luas += luasKebun;
                ptDataMap[namaPt].luasTM += luasTM;
                ptDataMap[namaPt].target += targetProd;

                // Agregasi untuk Grafik 
                chartBarDataMap[rowCRO] = (chartBarDataMap[rowCRO] || 0) + targetProd;
                chartPieDataMap[rowCRO] = (chartPieDataMap[rowCRO] || 0) + luasKebun;
            });

            // Update List Dropdown Kalau Masih Kosong
            if (filterDropdown && filterDropdown.options.length <= 1) {
                [...croList].sort().forEach(c => {
                    let opt = document.createElement('option');
                    opt.value = c;
                    opt.innerText = c;
                    opt.className = "bg-[#111111] text-white";
                    filterDropdown.appendChild(opt);
                });
            }

            // Render KPI Boxes
            const kpiContainer = document.getElementById('pivot-kpi-container');
            if(kpiContainer) {
                kpiContainer.innerHTML = `
                    <div class="premium-card p-4 md:p-5 border-t-4 border-t-blue-500 relative group">
                        <div class="text-[9px] md:text-[10px] theme-text-muted font-bold uppercase tracking-widest mb-1">Total Target Produksi</div>
                        <div class="text-2xl md:text-3xl font-bold theme-text-main mb-1">${totalTarget.toLocaleString('id-ID', {maximumFractionDigits: 2})} Ton</div>
                        <div class="text-[9px] md:text-[10px] theme-text-muted italic opacity-60">(Data Kalkulasi Akurat)</div>
                    </div>
                    
                    <div class="premium-card p-4 md:p-5 border-t-4 border-t-purple-500 relative group">
                        <div class="text-[9px] md:text-[10px] theme-text-muted font-bold uppercase tracking-widest mb-1">Total Luas Kebun / Luas TM</div>
                        <div class="flex items-baseline gap-1 md:gap-2 mb-1">
                            <div class="text-2xl md:text-3xl font-bold theme-text-main">${totalLuas.toLocaleString('id-ID', {maximumFractionDigits: 2})} <span class="text-sm md:text-lg">Ha</span></div>
                        </div>
                        <div class="text-[9px] md:text-[10px] font-medium text-purple-400 italic">Luas TM: ${totalLuasTM.toLocaleString('id-ID', {maximumFractionDigits: 2})} Ha</div>
                    </div>
                    
                    <div class="premium-card p-4 md:p-5 border-t-4 border-t-orange-500 relative group">
                        <div class="text-[9px] md:text-[10px] theme-text-muted font-bold uppercase tracking-widest mb-1">Total Kemitraan PT</div>
                        <div class="text-2xl md:text-3xl font-bold theme-text-main mb-1">${totalPtCount} PT</div>
                        <div class="text-[9px] md:text-[10px] theme-text-muted italic opacity-60">(Data Kalkulasi Akurat)</div>
                    </div>
                `;
            }

            // Atur Judul Grafik berdasarkan filter
            const titleSuffix = selectedCRO === 'ALL' ? 'per CRO' : `(Regional ${selectedCRO})`;
            if(document.getElementById('chart-title-bar')) {
                document.getElementById('chart-title-bar').innerText = `Target Produksi (Ton) ${titleSuffix}`;
            }
            if(document.getElementById('chart-title-pie')) {
                document.getElementById('chart-title-pie').innerText = `Luas Kebun (Ha) ${titleSuffix}`;
            }
            if(document.getElementById('pt-list-title')) {
                document.getElementById('pt-list-title').innerText = `Daftar Perusahaan (PT) ${selectedCRO !== 'ALL' ? '- ' + selectedCRO : ''}`;
            }

            // Render Bar Chart
            if(document.getElementById('pivot-bar-chart')) {
                Highcharts.chart('pivot-bar-chart', {
                    chart: { type: 'column', backgroundColor: 'transparent' },
                    title: { text: null },
                    tooltip: { backgroundColor: 'var(--bg-card)', style: { color: 'var(--text-main)' }, borderWidth: 1, borderColor: 'var(--border-color)', borderRadius: 8 },
                    xAxis: { categories: Object.keys(chartBarDataMap), labels: { style: { color: 'var(--text-muted)' } }, lineWidth: 0, tickWidth: 0 },
                    yAxis: { title: { text: null }, gridLineColor: 'var(--border-color)', labels: { style: { color: 'var(--text-muted)' } } },
                    series: [{ name: 'Target Produksi (Ton)', data: Object.values(chartBarDataMap), color: '#3b82f6' }],
                    plotOptions: { column: { borderRadius: 4, borderWidth: 0 } },
                    credits: { enabled: false }
                });
            }

            // Render Pie Chart
            if(document.getElementById('pivot-pie-chart')) {
                Highcharts.chart('pivot-pie-chart', {
                    chart: { type: 'pie', backgroundColor: 'transparent' },
                    title: { text: null },
                    tooltip: { backgroundColor: 'var(--bg-card)', style: { color: 'var(--text-main)' }, borderWidth: 1, borderColor: 'var(--border-color)', borderRadius: 8 },
                    plotOptions: { pie: { innerSize: '65%', borderWidth: 0, dataLabels: { enabled: true, color: 'var(--text-muted)', connectorColor: 'var(--border-color)', style: { textOutline: 'none', fontWeight: 'normal' } } } },
                    series: [{ name: 'Luas Kebun (Ha)', data: Object.keys(chartPieDataMap).map(k => [k, chartPieDataMap[k]]) }],
                    credits: { enabled: false }
                });
            }
            
            // RENDER TABEL RINCIAN NAMA PT (KEMBALI KE NAMA PT SEPERTI SEMULA)
            let ptHtml = '';
            let sortedPTs = Object.keys(ptDataMap).map(k => ({name: k, ...ptDataMap[k]})).sort((a,b) => b.target - a.target);
            
            if (sortedPTs.length > 0) {
                sortedPTs.forEach(pt => {
                    ptHtml += `
                        <tr class="hover:bg-[var(--hover-bg)] transition-colors border-b theme-border last:border-0">
                            <td class="py-2 md:py-3 px-3 md:px-4 text-[11px] md:text-sm theme-text-main font-medium">
                                ${pt.name}
                                ${selectedCRO === 'ALL' ? `<span class="ml-1 md:ml-2 text-[9px] md:text-[10px] theme-text-muted bg-[var(--bg-main)] px-1.5 md:px-2 py-0.5 rounded border theme-border whitespace-nowrap">${pt.cro}</span>` : ''}
                            </td>
                            <td class="py-2 md:py-3 px-3 md:px-4 text-[11px] md:text-sm theme-text-main text-right">${pt.luas.toLocaleString('id-ID', {maximumFractionDigits: 2})}</td>
                            <td class="py-2 md:py-3 px-3 md:px-4 text-[11px] md:text-sm text-purple-400 text-right">${pt.luasTM.toLocaleString('id-ID', {maximumFractionDigits: 2})}</td>
                            <td class="py-2 md:py-3 px-3 md:px-4 text-[11px] md:text-sm theme-text-main text-right font-semibold">${pt.target.toLocaleString('id-ID', {maximumFractionDigits: 2})}</td>
                        </tr>
                    `;
                });
            } else {
                ptHtml = `<tr><td colspan="4" class="py-6 text-center text-[11px] md:text-sm theme-text-muted">Tidak ada data perusahaan untuk pilihan ini.</td></tr>`;
            }
            
            if(document.getElementById('pt-list-body')) {
                document.getElementById('pt-list-body').innerHTML = ptHtml;
            }
            
            const isLightNow = document.body.classList.contains('light-mode');
            updateChartTheme(isLightNow);
        }

        // =========================================
        // FUNGSI BARU KHUSUS: DASHBOARD REKAP KEMITRAAN DI HALAMAN EVALUASI
        // =========================================
        async function renderKemitraanDashboard() {
            try {
                // Gunakan PapaParse untuk menarik data murni dari Google Sheets Evaluasi (Bebas dari limit server)
                const res = await fetch('https://docs.google.com/spreadsheets/d/1bbVifsoYTxQFc0t80_tGEU1KyUtFlGsD5kH6opjshQg/gviz/tq?tqx=out:csv&sheet=Rekap+Kemitraan');
                const csvText = await res.text();
                
                Papa.parse(csvText, {
                    skipEmptyLines: true,
                    complete: function(results) {
                        const rows = results.data;
                        let totalSudah = 0;
                        let totalBelum = 0;
                        let totalPtCount = 0;
                        
                        let chartBarDataMap = {};
                        let summaryMap = {}; 

                        let colRegional = -1, colWilayah = -1, colJumlah = -1, colSudah = -1, colBelum = -1;
                        let startRow = -1;

                        // Scan 15 baris pertama untuk mencari Header Tahap 1 - 7
                        for (let i = 0; i < Math.min(15, rows.length); i++) {
                            let row = rows[i];
                            let regionalIndexes = [];
                            
                            row.forEach((val, idx) => {
                                if(String(val).trim().toLowerCase() === 'regional') regionalIndexes.push(idx);
                            });

                            // Tabel Tahap 1-7 adalah tabel kedua (index ke-1)
                            if (regionalIndexes.length >= 2) {
                                colRegional = regionalIndexes[1];
                                
                                for(let j = colRegional; j < row.length; j++) {
                                    let v = String(row[j]).toLowerCase().trim();
                                    if (v === 'wilayah' && colWilayah === -1) colWilayah = j;
                                    if ((v === 'jumlah pt' || v === 'jumlah') && colJumlah === -1) colJumlah = j;
                                    if (v === 'sudah dikelola' && colSudah === -1) colSudah = j;
                                    if (v === 'belum dikelola' && colBelum === -1) colBelum = j;
                                }
                                
                                if(colRegional !== -1 && colSudah !== -1) {
                                    startRow = i + 1; // Baris setelah header
                                    break;
                                }
                            }
                        }

                        if (startRow !== -1) {
                            for (let i = startRow; i < rows.length; i++) {
                                let row = rows[i];
                                let rowCRO = String(row[colRegional] || "").replace(/^[+-]\s*/, '').trim();
                                let rowWilayah = String(row[colWilayah] || "").trim();
                                
                                // Bersihin angka dari text
                                let rowJumlah = parseInt(String(row[colJumlah]).replace(/[^0-9]/g,'')) || 0;
                                let rowSudah = parseInt(String(row[colSudah]).replace(/[^0-9]/g,'')) || 0;
                                let rowBelum = parseInt(String(row[colBelum]).replace(/[^0-9]/g,'')) || 0;

                                // Filter Buang baris kosong atau baris judul
                                if (!rowCRO || rowCRO === "-" || rowCRO.toLowerCase() === "regional") continue;
                                if (rowCRO.toLowerCase().includes("total") || rowCRO.toLowerCase().includes("summary") || rowCRO.toLowerCase().includes("grand")) continue;

                                // Seragamkan nama CRO
                                if(rowCRO.toLowerCase().startsWith('cro')) {
                                    rowCRO = rowCRO.toUpperCase();
                                } else {
                                    rowCRO = "CRO " + rowCRO.toUpperCase(); 
                                }

                                totalPtCount += rowJumlah;
                                totalSudah += rowSudah;
                                totalBelum += rowBelum;

                                // Agregasi Bar Chart
                                chartBarDataMap[rowCRO] = (chartBarDataMap[rowCRO] || 0) + rowJumlah;

                                // Agregasi Summary Per Wilayah
                                let sumKey = rowCRO + "_" + rowWilayah;
                                if (!summaryMap[sumKey]) {
                                    summaryMap[sumKey] = { cro: rowCRO, wilayah: rowWilayah, jumlahPT: 0, sudah: 0, belum: 0 };
                                }
                                summaryMap[sumKey].jumlahPT += rowJumlah;
                                summaryMap[sumKey].sudah += rowSudah;
                                summaryMap[sumKey].belum += rowBelum;
                            }
                        }

                        // Render KPI Boxes Rekap Kemitraan
                        const kpiContainer = document.getElementById('kemitraan-kpi-container');
                        if(kpiContainer) {
                            kpiContainer.innerHTML = `
                                <div class="premium-card p-4 md:p-5 border-t-4 border-t-yellow-500 relative group">
                                    <div class="text-[9px] md:text-[10px] theme-text-muted font-bold uppercase tracking-widest mb-1">Total Keseluruhan PT</div>
                                    <div class="text-2xl md:text-3xl font-bold theme-text-main mb-1">${totalPtCount} PT</div>
                                    <div class="text-[9px] md:text-[10px] theme-text-muted italic opacity-60">(Data Kalkulasi Kemitraan)</div>
                                </div>
                                
                                <div class="premium-card p-4 md:p-5 border-t-4 border-t-blue-500 relative group">
                                    <div class="text-[9px] md:text-[10px] theme-text-muted font-bold uppercase tracking-widest mb-1">Total Sudah Dikelola</div>
                                    <div class="text-2xl md:text-3xl font-bold text-blue-400 mb-1">${totalSudah} PT</div>
                                    <div class="text-[9px] md:text-[10px] theme-text-muted italic opacity-60">Status Aktif Berjalan</div>
                                </div>
                                
                                <div class="premium-card p-4 md:p-5 border-t-4 border-t-red-500 relative group">
                                    <div class="text-[9px] md:text-[10px] theme-text-muted font-bold uppercase tracking-widest mb-1">Total Belum Dikelola</div>
                                    <div class="text-2xl md:text-3xl font-bold text-red-400 mb-1">${totalBelum} PT</div>
                                    <div class="text-[9px] md:text-[10px] theme-text-muted italic opacity-60">Status Belum Berjalan</div>
                                </div>
                            `;
                        }

                        // Render Bar Chart (Sebaran PT)
                        if(document.getElementById('kemitraan-bar-chart')) {
                            Highcharts.chart('kemitraan-bar-chart', {
                                chart: { type: 'column', backgroundColor: 'transparent' },
                                title: { text: null },
                                tooltip: { backgroundColor: 'var(--bg-card)', style: { color: 'var(--text-main)' }, borderWidth: 1, borderColor: 'var(--border-color)', borderRadius: 8 },
                                xAxis: { categories: Object.keys(chartBarDataMap), labels: { style: { color: 'var(--text-muted)' } }, lineWidth: 0, tickWidth: 0 },
                                yAxis: { title: { text: null }, gridLineColor: 'var(--border-color)', labels: { style: { color: 'var(--text-muted)' } } },
                                series: [{ name: 'Jumlah Kemitraan PT', data: Object.values(chartBarDataMap), color: '#8b5cf6' }],
                                plotOptions: { column: { borderRadius: 4, borderWidth: 0 } },
                                credits: { enabled: false }
                            });
                        }

                        // Render Pie Chart (Sudah vs Belum)
                        if(document.getElementById('kemitraan-pie-chart')) {
                            Highcharts.chart('kemitraan-pie-chart', {
                                chart: { type: 'pie', backgroundColor: 'transparent' },
                                title: { text: null },
                                tooltip: { backgroundColor: 'var(--bg-card)', style: { color: 'var(--text-main)' }, borderWidth: 1, borderColor: 'var(--border-color)', borderRadius: 8 },
                                plotOptions: { pie: { innerSize: '65%', borderWidth: 0, dataLabels: { enabled: true, color: 'var(--text-muted)', connectorColor: 'var(--border-color)', style: { textOutline: 'none', fontWeight: 'normal' } } } },
                                series: [{ 
                                    name: 'Total PT', 
                                    data: [
                                        {name: 'Sudah Dikelola', y: totalSudah, color: '#3b82f6'},
                                        {name: 'Belum Dikelola', y: totalBelum, color: '#f43f5e'}
                                    ] 
                                }],
                                credits: { enabled: false }
                            });
                        }
                        
                        // RENDER TABEL SUMMARY PER WILAYAH
                        let ptHtml = '';
                        let sumSudah = 0;
                        let sumBelum = 0;
                        let sumPT = 0;
                        let no = 1;
                        
                        // Urutkan berdasarkan CRO lalu Wilayah
                        let sortedSummaries = Object.values(summaryMap).sort((a,b) => a.cro.localeCompare(b.cro) || a.wilayah.localeCompare(b.wilayah));
                        
                        if (sortedSummaries.length > 0) {
                            sortedSummaries.forEach(item => {
                                sumSudah += item.sudah;
                                sumBelum += item.belum;
                                sumPT += item.jumlahPT;
                                
                                let pctSudah = item.jumlahPT > 0 ? Math.round((item.sudah / item.jumlahPT) * 100) : 0;
                                let pctBelum = item.jumlahPT > 0 ? Math.round((item.belum / item.jumlahPT) * 100) : 0;
                                
                                ptHtml += `
                                    <tr class="hover:bg-[var(--hover-bg)] transition-colors border-b theme-border">
                                        <td class="py-2 md:py-3 px-3 md:px-4 text-[11px] md:text-sm theme-text-main text-center">${no++}</td>
                                        <td class="py-2 md:py-3 px-3 md:px-4 text-[11px] md:text-sm theme-text-main font-semibold">${item.cro}</td>
                                        <td class="py-2 md:py-3 px-3 md:px-4 text-[11px] md:text-sm theme-text-main">${item.wilayah}</td>
                                        <td class="py-2 md:py-3 px-3 md:px-4 text-[11px] md:text-sm theme-text-main text-center font-bold">${item.jumlahPT}</td>
                                        <td class="py-2 md:py-3 px-3 md:px-4 text-[11px] md:text-sm text-blue-400 text-center font-bold">${item.sudah}</td>
                                        <td class="py-2 md:py-3 px-3 md:px-4 text-[11px] md:text-sm text-red-400 text-center font-bold">${item.belum}</td>
                                        <td class="py-2 md:py-3 px-3 md:px-4 text-[11px] md:text-sm text-blue-400 text-center font-bold">${pctSudah}%</td>
                                        <td class="py-2 md:py-3 px-3 md:px-4 text-[11px] md:text-sm text-red-400 text-center font-bold">${pctBelum}%</td>
                                    </tr>
                                `;
                            });
                            
                            // Baris Grand Total di paling bawah
                            let pctTotSudah = sumPT > 0 ? Math.round((sumSudah / sumPT) * 100) : 0;
                            let pctTotBelum = sumPT > 0 ? Math.round((sumBelum / sumPT) * 100) : 0;
                            
                            ptHtml += `
                                <tr class="bg-[var(--hover-bg)] border-t border-[#83b765]">
                                    <td colspan="3" class="py-3 px-4 text-[11px] md:text-sm theme-text-main font-bold text-center uppercase tracking-widest">Grand Total</td>
                                    <td class="py-3 px-4 text-[11px] md:text-sm theme-text-main text-center font-bold">${sumPT}</td>
                                    <td class="py-3 px-4 text-[11px] md:text-sm text-blue-400 text-center font-bold">${sumSudah}</td>
                                    <td class="py-3 px-4 text-[11px] md:text-sm text-red-400 text-center font-bold">${sumBelum}</td>
                                    <td class="py-3 px-4 text-[11px] md:text-sm text-blue-400 text-center font-bold">${pctTotSudah}%</td>
                                    <td class="py-3 px-4 text-[11px] md:text-sm text-red-400 text-center font-bold">${pctTotBelum}%</td>
                                </tr>
                            `;
                        } else {
                            ptHtml = `<tr><td colspan="8" class="py-6 text-center text-[11px] md:text-sm theme-text-muted">Tidak ada data untuk direkap.</td></tr>`;
                        }
                        
                        if(document.getElementById('kemitraan-list-body')) {
                            document.getElementById('kemitraan-list-body').innerHTML = ptHtml;
                        }
                        const isLightNow = document.body.classList.contains('light-mode');
                        updateChartTheme(isLightNow);
                    }
                });
            } catch (e) {
                console.error("Gagal mengambil data kemitraan:", e);
            }
        }

        // FUNGSI MENDAPATKAN IKON FILE
        function getFileIcon(fileName) {
            const ext = fileName.toLowerCase();
            if (ext.includes('.pdf')) {
                return `
                <svg class="w-4 h-4 text-red-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"></path>
                </svg>`; 
            } else if (ext.includes('.doc') || ext.includes('.docx')) {
                return `
                <svg class="w-4 h-4 text-blue-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                </svg>`; 
            } else {
                return `
                <svg class="w-4 h-4 theme-text-muted shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"></path>
                </svg>`; 
            }
        }

        // BUKA MODAL PREVIEW
        function openPreview(rawUrl) {
            let previewUrl = rawUrl.trim();
            if (previewUrl.includes("drive.google.com/file/d/")) {
                previewUrl = previewUrl.replace(/\/view.*/, '/preview'); 
            } else if (previewUrl.includes("docs.google.com/document/d/") || previewUrl.includes("docs.google.com/spreadsheets/d/")) {
                previewUrl = previewUrl.replace(/\/edit.*/, '/preview'); 
            }
            
            document.getElementById('documentIframe').src = previewUrl;
            document.getElementById('modalExternalLink').href = rawUrl;
            
            const modal = document.getElementById('previewModal');
            const content = document.getElementById('modalContent');
            
            modal.classList.remove('hidden');
            setTimeout(() => { 
                modal.classList.remove('opacity-0'); 
                content.classList.remove('scale-95'); 
            }, 10);
        }

        // TUTUP MODAL PREVIEW
        function closePreview() {
            const modal = document.getElementById('previewModal');
            const content = document.getElementById('modalContent');
            
            modal.classList.add('opacity-0'); 
            content.classList.add('scale-95');
            
            setTimeout(() => { 
                modal.classList.add('hidden'); 
                document.getElementById('documentIframe').src = ""; 
            }, 300);
        }

        // =========================================
        // RENDER TABEL MASTER DATA KEBUN
        // =========================================
        function loadTable(sheetName) {
            document.querySelectorAll('#tab-container .tab-btn').forEach(btn => { 
                btn.className = btn.dataset.sheet === sheetName ? 'tab-btn tab-active' : 'tab-btn tab-inactive'; 
            });
            
            const filterContainer = document.getElementById('custom-filter-container');
            if (sheetName === 'INPUT ASTA' && filterContainer) {
                filterContainer.classList.remove('hidden');
                filterContainer.innerHTML = `
                    <span class="text-[10px] md:text-[11px] font-bold theme-text-muted uppercase tracking-widest">Filter Status:</span>
                    <select id="asta-status-filter" class="bg-transparent theme-text-main text-xs md:text-sm font-semibold outline-none cursor-pointer">
                        <option value="" class="bg-[#111111] text-white">Semua Status</option>
                        <option value="Batal" class="bg-[#111111] text-white">Batal</option>
                        <option value="Input Asta" class="bg-[#111111] text-white">Input Asta</option>
                        <option value="TTD" class="bg-[#111111] text-white">TTD</option>
                    </select>
                `;
            } else if(filterContainer) {
                filterContainer.classList.add('hidden');
                filterContainer.innerHTML = '';
            }

            if (sheetName === "Pivot Table") {
                document.getElementById('table-area').classList.add('hidden');
                document.getElementById('pivot-area').classList.remove('hidden');
                return; 
            } 
            
            document.getElementById('table-area').classList.remove('hidden');
            document.getElementById('pivot-area').classList.add('hidden');

            const data = rawData[sheetName] || [];
            
            if ($.fn.DataTable.isDataTable('#mainTable')) { 
                $('#mainTable').DataTable().destroy(); 
                $('#mainTable').empty(); 
            }
            
            if (data.length === 0) { 
                $('#mainTable').html(`<tbody><tr><td class="text-center py-12 theme-text-muted text-sm">Tidak ada data tersedia pada sheet ini.</td></tr></tbody>`); 
                return; 
            }

            const columns = Object.keys(data[0]).map(key => {
                return { 
                    title: key, 
                    data: key, 
                    defaultContent: "-", 
                    render: function(val) {
                        if (typeof val === 'string' && val.includes('|||')) {
                            const parts = val.split('|||');
                            return `
                            <a href="javascript:void(0)" onclick="openPreview('${parts[1]}')" class="inline-flex items-center gap-2 theme-text-muted hover:text-blue-500 group transition-colors">
                                ${getFileIcon(parts[0])} 
                                <span class="group-hover:underline truncate max-w-[200px]" title="${parts[0]}">${parts[0]}</span>
                            </a>`;
                        }
                        else if(typeof val === 'string' && (val.includes('http://') || val.includes('https://'))) {
                            return `
                            <a href="javascript:void(0)" onclick="openPreview('${val}')" class="inline-flex items-center gap-2 text-blue-500 hover:text-blue-400 group transition-colors">
                                <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
                                </svg>
                                <span class="group-hover:underline">Buka Link</span>
                            </a>`;
                        }
                        if (typeof val === 'string' && val.includes('\n')) {
                            return val.replace(/\n/g, ' <span class="theme-text-muted opacity-50 mx-2">/</span> '); 
                        }
                        return val;
                    }
                };
            });

            currentDataTable = $('#mainTable').DataTable({
                data: data, 
                columns: columns, 
                scrollX: true, 
                pageLength: 10, 
                ordering: false,
                language: { 
                    search: "", 
                    searchPlaceholder: "Cari Data...", 
                    lengthMenu: "Tampil _MENU_ baris", 
                    info: "Menampilkan _START_ - _END_ dari _TOTAL_ data", 
                    paginate: { previous: "Prev", next: "Next" } 
                }
            });

            if (sheetName === 'INPUT ASTA') {
                $('#asta-status-filter').on('change', function() {
                    let val = $(this).val();
                    currentDataTable.search(val).draw();
                });
            }
        }

        // =========================================
        // FUNGSI RENDER EVALUASI KINERJA
        // =========================================
        function loadEvaluasiTable(sheetName) {
            document.querySelectorAll('#evaluasi-tab-container .tab-btn').forEach(btn => { 
                btn.className = btn.dataset.sheet === sheetName ? 'tab-btn tab-active' : 'tab-btn tab-inactive'; 
            });

            // JIKA REKAP KEMITRAAN DIKLIK, TAMPILKAN DASHBOARD BARUNYA!
            if (sheetName === "Rekap Kemitraan") {
                document.getElementById('evaluasi-table-area').classList.add('hidden');
                document.getElementById('evaluasi-dashboard-area').classList.remove('hidden');
                renderKemitraanDashboard(); 
                return; 
            } 
            
            document.getElementById('evaluasi-table-area').classList.remove('hidden');
            document.getElementById('evaluasi-dashboard-area').classList.add('hidden');

            const data = rawData[sheetName] || [];
            
            if ($.fn.DataTable.isDataTable('#evaluasiTable')) { 
                $('#evaluasiTable').DataTable().destroy(); 
                $('#evaluasiTable').empty(); 
            }
            
            if (data.length === 0) { 
                $('#evaluasiTable').html(`<tbody><tr><td class="text-center py-12 theme-text-muted text-sm">Sedang sinkronisasi data Viewer... Jika kosong, pastikan koneksi lancar.</td></tr></tbody>`); 
                return; 
            }

            const columns = Object.keys(data[0]).map(key => {
                let title = key;
                if (title.includes('__EMPTY')) title = ''; // Bersihin header nyangkut dari excel
                return { 
                    title: title, data: key, defaultContent: "-", 
                    render: function(val) {
                        if (typeof val === 'number') {
                            if (val % 1 !== 0) return val.toLocaleString('id-ID', {maximumFractionDigits: 2});
                            return val.toLocaleString('id-ID');
                        }
                        if (typeof val === 'string' && val.includes('|||')) {
                            const parts = val.split('|||');
                            return `<a href="javascript:void(0)" onclick="openPreview('${parts[1]}')" class="inline-flex items-center gap-2 theme-text-muted hover:text-blue-500 group transition-colors">${getFileIcon(parts[0])} <span class="group-hover:underline truncate max-w-[200px]" title="${parts[0]}">${parts[0]}</span></a>`;
                        }
                        else if(typeof val === 'string' && (val.includes('http://') || val.includes('https://'))) {
                            return `<a href="javascript:void(0)" onclick="openPreview('${val}')" class="inline-flex items-center gap-2 text-blue-500 hover:text-blue-400 group transition-colors"><svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg><span class="group-hover:underline">Buka Link</span></a>`;
                        }
                        if (typeof val === 'string' && val.includes('\n')) {
                            return val.replace(/\n/g, ' <span class="theme-text-muted opacity-50 mx-2">/</span> '); 
                        }
                        return val;
                    }
                };
            });

            evaluasiDataTable = $('#evaluasiTable').DataTable({
                data: data, columns: columns, scrollX: true, pageLength: 15, ordering: false,
                language: { search: "", searchPlaceholder: "Cari Analisis...", lengthMenu: "Tampil _MENU_ baris", info: "Menampilkan _START_ - _END_ dari _TOTAL_ data", paginate: { previous: "Prev", next: "Next" } }
            });
        }

        // =========================================
        // INIT SAAT WEB DIBUKA
        // =========================================
        document.addEventListener("DOMContentLoaded", function() {
            
            if (localStorage.getItem('theme') === 'light') {
                document.body.classList.add('light-mode');
                const themeIcon = document.getElementById('theme-icon');
                if(themeIcon) {
                    themeIcon.innerHTML = `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"></path>`;
                }
            }

            renderNotifications();
            renderEmailsUI(); 

            // Bangun tombol Tab Master Data (Sheet 1)
            const tabContainer = document.getElementById('tab-container');
            if(tabContainer) {
                listSheets.forEach(sheet => {
                    const btn = document.createElement('button'); 
                    btn.dataset.sheet = sheet; 
                    btn.innerText = sheet; 
                    btn.className = 'tab-btn tab-inactive';
                    btn.onclick = () => loadTable(sheet);
                    tabContainer.appendChild(btn);
                });
            }

            // Bangun tombol Tab Evaluasi Kinerja (Sheet 2)
            const evaluasiTabContainer = document.getElementById('evaluasi-tab-container');
            if(evaluasiTabContainer) {
                listEvaluasiSheets.forEach(sheet => {
                    const btn = document.createElement('button'); 
                    btn.dataset.sheet = sheet; 
                    btn.innerText = sheet; 
                    btn.className = 'tab-btn tab-inactive';
                    btn.onclick = () => loadEvaluasiTable(sheet);
                    evaluasiTabContainer.appendChild(btn);
                });
            }

            const isLightInit = document.body.classList.contains('light-mode');
            Highcharts.setOptions({ 
                colors: ['#3b82f6', '#8b5cf6', '#f97316', '#10b981', '#f43f5e', '#6366f1'], 
                credits: { enabled: false }, 
                chart: { style: { fontFamily: 'Inter' } } 
            });
            updateChartTheme(isLightInit);

            // Tampilkan Dashboard & Tabel Awal
            renderPivotDashboard();
            loadTable("REKAPITULASI");
            loadEvaluasiTable("Sumber/Source Data");
            
            // Re-adjust DataTables on window resize
            window.addEventListener('resize', () => {
                if(currentDataTable) setTimeout(() => currentDataTable.columns.adjust(), 200);
                if(evaluasiDataTable) setTimeout(() => evaluasiDataTable.columns.adjust(), 200);
            });

            // ==========================================
            // LOGIKA POLLING BACKGROUND (SHEETS DEEP-DIFF) INSTANT FETCH
            // ==========================================
            async function syncData() {
                const syncText = document.getElementById('sync-text');
                const syncDot = document.getElementById('sync-dot');

                try {
                    const response = await fetch('/api/check-updates?t=' + new Date().getTime());
                    const result = await response.json();
                    
                    if (result.rawData && Object.keys(result.rawData).length > 0 && JSON.stringify(rawData) !== JSON.stringify(result.rawData)) {
                        
                        // JANGAN bikin notif spam kalau rawData awalnya emang kosong
                        if (Object.keys(rawData).length > 0) {
                            let detectedChanges = [];
                            const allSheetNames = [...listSheets, ...listEvaluasiSheets];
                            
                            allSheetNames.forEach(sheet => {
                                let oldSheet = rawData[sheet] || [];
                                let newSheet = result.rawData[sheet] || [];
                                let maxRows = Math.max(oldSheet.length, newSheet.length);

                                for (let i = 0; i < maxRows; i++) {
                                    let oldRow = oldSheet[i] || {};
                                    let newRow = newSheet[i] || {};
                                    let allKeys = new Set([...Object.keys(oldRow), ...Object.keys(newRow)]);

                                    allKeys.forEach(key => {
                                        // Abaikan metadata link dan baris kosong internal dari Excel
                                        if(key.startsWith('!') || key.startsWith('__EMPTY')) return;

                                        let oldVal = String(oldRow[key] || "").trim();
                                        let newVal = String(newRow[key] || "").trim();

                                        // Hilangkan URL kalau ada fitur "|||" supaya rapi di notifikasi
                                        if(oldVal.includes('|||')) {
                                            oldVal = oldVal.split('|||')[0];
                                        }
                                        if(newVal.includes('|||')) {
                                            newVal = newVal.split('|||')[0];
                                        }

                                        if (oldVal !== newVal) {
                                            detectedChanges.push({
                                                sheet: sheet, 
                                                waktu: new Date().toLocaleTimeString('id-ID', { hour12: false }), 
                                                baris: i + 2, // Excel baris 1 itu header, jadi index 0 = baris 2
                                                kolom: key, 
                                                lama: oldVal === "" ? "(Kosong)" : oldVal, 
                                                baru: newVal === "" ? "(Kosong)" : newVal
                                            });
                                        }
                                    });
                                }
                            });

                            // Masukkan log baru ke urutan teratas (Max 50 riwayat)
                            if(detectedChanges.length > 0) {
                                logsData = [...detectedChanges, ...logsData];
                                if (logsData.length > 50) {
                                    logsData = logsData.slice(0, 50); 
                                }
                            }
                            isUnread = true; 
                        }

                        // Terapkan data baru ke aplikasi
                        rawData = result.rawData;
                        
                        renderNotifications();
                        renderPivotDashboard(); 
                        
                        // Reload Tabel Master Data jika sedang dibuka
                        const activeTab = document.querySelector('#tab-container .tab-active');
                        if (activeTab && activeTab.dataset.sheet !== "Pivot Table") {
                            let currentFilter = '';
                            if (activeTab.dataset.sheet === 'INPUT ASTA') {
                                currentFilter = $('#asta-status-filter').val() || '';
                            }
                            
                            loadTable(activeTab.dataset.sheet);
                            
                            if (activeTab.dataset.sheet === 'INPUT ASTA' && currentFilter !== '') {
                                $('#asta-status-filter').val(currentFilter);
                                currentDataTable.search(currentFilter).draw();
                            }
                        }

                        // Reload Tabel Evaluasi Kinerja jika sedang dibuka
                        const activeEvalTab = document.querySelector('#evaluasi-tab-container .tab-active');
                        if (activeEvalTab && activeEvalTab.dataset.sheet !== "Rekap Kemitraan") {
                            loadEvaluasiTable(activeEvalTab.dataset.sheet);
                        }
                        
                        // Kalo pas ngetab Rekap Kemitraan lagi aktif pas background narik data, refresh chartnya!
                        if (activeEvalTab && activeEvalTab.dataset.sheet === "Rekap Kemitraan") {
                            renderKemitraanDashboard();
                        }

                        // Animasi tombol LIVE
                        if(syncText && syncDot) {
                            syncText.innerText = "UPDATING...";
                            syncText.classList.remove('text-emerald-500', 'text-red-500'); 
                            syncText.classList.add('text-blue-500');
                            syncDot.innerHTML = `<span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-blue-400 opacity-75"></span><span class="relative inline-flex rounded-full h-1.5 w-1.5 bg-blue-500"></span>`;
                            
                            setTimeout(() => { 
                                syncText.innerText = "LIVE SYSTEM"; 
                                syncText.classList.add('text-emerald-500'); 
                                syncText.classList.remove('text-blue-500');
                                syncDot.innerHTML = `<span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span><span class="relative inline-flex rounded-full h-1.5 w-1.5 bg-emerald-500"></span>`;
                            }, 3000);
                        }
                    }
                } catch (err) { 
                    console.error("Gagal sinkronisasi background:", err); 
                    if(syncText && syncDot) {
                        syncText.innerText = "KONEKSI LAMBAT"; 
                        syncText.classList.remove('text-blue-500', 'text-emerald-500'); 
                        syncText.classList.add('text-red-500');
                        syncDot.innerHTML = `<span class="relative inline-flex rounded-full h-1.5 w-1.5 bg-red-500"></span>`;
                    }
                }
            }

            // Fetch langsung kalau cache kosong
            if (Object.keys(rawData).length === 0) {
                syncData();
            }

            setInterval(syncData, 10000); 

            // Cek Email Baru Tiap 5 Detik (Anti Cache)
            setInterval(async () => {
                try {
                    const response = await fetch('/api/check-emails?t=' + new Date().getTime());
                    const result = await response.json();
                    
                    if (JSON.stringify(emailsData) !== JSON.stringify(result.emails)) {
                        emailsData = result.emails;
                        renderEmailsUI();
                        
                        const badge = document.getElementById('sidebar-email-badge');
                        if (result.unreadCount > 0 && badge) {
                            badge.innerText = result.unreadCount;
                            badge.classList.remove('hidden');
                            badge.classList.remove('badge-pop');
                            void badge.offsetWidth; 
                            badge.classList.add('badge-pop');
                        }
                    }
                } catch (err) {}
            }, 5000); 
        });
    </script>
</body>
</html>
