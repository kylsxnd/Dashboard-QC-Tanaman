<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Executive Portal - Agrinas</title>
    
    <!-- Library CSS & Framework -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <script src="https://code.highcharts.com/highcharts.js"></script>
    
    <!-- DataTables Extension -->
    <link href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css" rel="stylesheet">
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>

    <!-- Google Fonts Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <style>
        :root {
            --bg-main: #0a0a0a; --bg-panel: #111111; --bg-card: #151515;
            --border-color: #262626; --text-main: #ffffff; --text-muted: #a1a1aa;
            --hover-bg: #27272a;
        }
        body.light-mode {
            --bg-main: #f3f4f6; --bg-panel: #ffffff; --bg-card: #ffffff;
            --border-color: #e5e7eb; --text-main: #1f2937; --text-muted: #6b7280;
            --hover-bg: #f8fafc;
        }

        body { background-color: var(--bg-main); color: var(--text-main); font-family: 'Inter', sans-serif; overflow: hidden; transition: all 0.3s ease; }
        
        .theme-bg-panel { background-color: var(--bg-panel); transition: all 0.3s ease; }
        .theme-border { border-color: var(--border-color); transition: all 0.3s ease; }
        .theme-text-main { color: var(--text-main); transition: all 0.3s ease; }
        .theme-text-muted { color: var(--text-muted); transition: all 0.3s ease; }

        .premium-card { 
            background: rgba(21, 21, 21, 0.72); backdrop-filter: blur(10px);
            border: 1px solid rgba(255,255,255,0.08); border-radius: 12px; 
            box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.4); transition: all 0.3s ease; 
        }
        body.light-mode .premium-card { background: rgba(255, 255, 255, 0.88); border: 1px solid var(--border-color); box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1); }

        .sidebar-link { padding: 11px 16px; font-size: 13px; font-weight: 500; color: var(--text-muted); border-radius: 10px; transition: all 0.3s ease; display: flex; align-items: center; margin-bottom: 6px; border: 1px solid transparent; }
        .sidebar-link:hover { color: var(--text-main); background: rgba(255,255,255,0.04); transform: translateX(4px); }
        .sidebar-link.active { color: #ffffff; background: linear-gradient(90deg, rgba(131,183,101,0.2) 0%, transparent 100%); border-left: 3px solid #83b765; font-weight: 600; }
        .sidebar-link.active svg { color: #83b765; filter: drop-shadow(0 0 8px rgba(131,183,101,0.5)); }

        .sidebar-child-link { padding: 9px 16px 9px 36px; font-size: 12.5px; font-weight: 500; color: var(--text-muted); border-radius: 8px; transition: all 0.2s ease; display: flex; align-items: center; margin-bottom: 3px; }
        .sidebar-child-link:hover { color: var(--text-main); background: var(--hover-bg); }

        table.dataTable { border-collapse: collapse !important; border-spacing: 0 !important; width: 100% !important; border-bottom: 1px solid rgba(255,255,255,0.05) !important; }
        table.dataTable thead th { background-color: rgba(21, 21, 21, 0.5) !important; color: var(--text-muted) !important; border-bottom: 1px solid rgba(255,255,255,0.05) !important; font-weight: 600; font-size: 11px; padding: 14px 18px !important; white-space: nowrap !important; }
        table.dataTable tbody tr:hover { background-color: rgba(255,255,255,0.05) !important; }
        table.dataTable tbody td { border-bottom: 1px solid rgba(255,255,255,0.05) !important; font-size: 13px; padding: 12px 18px !important; color: var(--text-main) !important; white-space: nowrap !important; }
        .dataTables_wrapper select, .dataTables_wrapper .dataTables_filter input { background-color: rgba(21, 21, 21, 0.8) !important; border: 1px solid rgba(255,255,255,0.1) !important; color: var(--text-main) !important; padding: 6px 12px !important; border-radius: 6px !important; }
        body.light-mode .dataTables_wrapper select, body.light-mode .dataTables_wrapper .dataTables_filter input { background-color: #ffffff !important; border: 1px solid var(--border-color) !important; }

        .fade-in { animation: fadeIn 0.4s ease forwards; }
        @keyframes fadeIn { from { opacity: 0; transform: translateY(4px); } to { opacity: 1; transform: translateY(0); } }

        ::-webkit-scrollbar { width: 6px; height: 8px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.2); border-radius: 4px; }
        ::-webkit-scrollbar-thumb:hover { background: rgba(255,255,255,0.4); }
        
        .bg-overlay { position: absolute; inset: 0; background-color: rgba(10, 10, 10, 0.65); z-index: 0; }
        body.light-mode .bg-overlay { background-color: rgba(243, 244, 246, 0.82); }
    </style>
</head>
<body class="flex h-screen w-full relative bg-black">

    <!-- LOGIN OVERLAY -->
    <div id="login-overlay" class="fixed inset-0 z-[99999] bg-[var(--bg-main)] flex items-center justify-center transition-opacity duration-500">
        <div class="absolute top-0 left-0 w-full h-full overflow-hidden z-0 pointer-events-none">
            <div class="absolute -top-[20%] -right-[10%] w-[50%] h-[50%] bg-[#83b765] opacity-20 blur-[120px] rounded-full"></div>
        </div>
        <div class="premium-card w-full max-w-md p-8 relative z-10 mx-4 border-t-4 border-t-[#83b765]">
            <h2 class="text-2xl font-bold text-center theme-text-main mb-1">Executive Portal</h2>
            <p class="text-xs text-center theme-text-muted mb-8">Masuk ke Sistem Keamanan Agrinas</p>
            <form onsubmit="handleLogin(event)">
                <div class="mb-5">
                    <label class="block text-[10px] font-bold theme-text-muted uppercase mb-2">Username / Email</label>
                    <input type="text" id="login-email" class="w-full bg-[var(--bg-main)] border theme-border rounded-lg px-4 py-3 text-sm theme-text-main outline-none" required autocomplete="off">
                </div>
                <div class="mb-8">
                    <label class="block text-[10px] font-bold theme-text-muted uppercase mb-2">Kata Sandi</label>
                    <input type="password" id="login-password" class="w-full bg-[var(--bg-main)] border theme-border rounded-lg px-4 py-3 text-sm theme-text-main outline-none" required>
                </div>
                <button type="submit" class="w-full bg-[#83b765] text-white font-bold py-3.5 rounded-lg text-sm">Masuk Dashboard</button>
                <div id="login-error" class="hidden mt-4 text-center text-xs text-red-500 bg-red-500/10 py-2.5 rounded">Akses Ditolak: Username/sandi salah!</div>
            </form>
        </div>
    </div>

    <!-- SIDEBAR -->
    <div id="sidebar-overlay" onclick="toggleSidebar()" class="fixed inset-0 bg-black/60 z-40 hidden md:hidden"></div>
    <aside id="mobile-sidebar" class="w-64 theme-bg-panel border-r theme-border flex flex-col h-full flex-shrink-0 z-50 fixed md:relative transform -translate-x-full md:translate-x-0 transition-transform duration-300">
        <div class="h-16 flex items-center px-6 border-b theme-border">
            <div class="flex flex-col">
                <h1 class="text-sm font-bold theme-text-main">AGRINAS OPS</h1>
                <span class="text-[10px] theme-text-muted">PT Agrinas Nusantara</span>
            </div>
            <button onclick="toggleSidebar()" class="ml-auto md:hidden text-gray-400">✖</button>
        </div>

        <div class="flex-1 overflow-y-auto py-5 px-3">
            <div class="text-[10px] font-bold theme-text-muted uppercase tracking-[0.1em] mb-3 px-3">Menu Utama</div>
            
            <button onclick="switchView('view-dashboard', 'nav-dashboard')" class="w-full sidebar-link active" id="nav-dashboard">
                Dashboard Rekapitulasi
            </button>
            <button onclick="switchView('view-pembatalan', 'nav-pembatalan')" class="w-full sidebar-link" id="nav-pembatalan">
                Dashboard Pembatalan
            </button>
            <!-- MENU PDF DIHAPUS -->

            <div class="text-[10px] font-bold theme-text-muted uppercase tracking-[0.1em] mb-2 px-3 mt-6">Master Data Kebun</div>
            <div id="sidebar-master-data" class="mb-2"></div>
        </div>

        <div class="p-4 border-t theme-border theme-bg-main cursor-pointer" onclick="logout()">
            <div class="flex items-center gap-3">
                <div class="w-8 h-8 rounded-full bg-[#83b765] flex items-center justify-center text-xs font-bold text-white">PIC</div>
                <span id="pic-name-display" class="text-xs font-semibold theme-text-main">Staf PIC</span>
            </div>
        </div>
    </aside>

    <!-- CONTENT AREA -->
    <div class="flex-1 flex flex-col h-full overflow-hidden relative">
        <div class="absolute inset-0 z-0 bg-cover bg-center bg-no-repeat opacity-55" style="background-image: url('https://raw.githubusercontent.com/kylsxnd/Dashboard-QC-Tanaman/main/public/bgkelapasawit.jpeg');"></div>
        <div class="bg-overlay"></div>

        <header class="h-16 border-b border-gray-600/30 flex items-center justify-between px-4 md:px-6 z-10" style="background: rgba(17,17,17,0.7); backdrop-filter: blur(10px);">
            <div class="flex items-center text-sm font-medium theme-text-muted">
                <button onclick="toggleSidebar()" class="md:hidden mr-3">☰</button>
                <span id="header-title">Executive On-Farm > Dashboard Rekapitulasi</span>
            </div>
            <div class="flex items-center gap-4">
                <button onclick="toggleTheme()" class="theme-text-muted" title="Ganti Tema">◐</button>
                <div class="flex items-center gap-2 text-[10px] font-semibold text-emerald-500 bg-emerald-500/10 px-2.5 py-1.5 rounded-full border border-emerald-500/20">
                    <span id="sync-dot" class="h-1.5 w-1.5 bg-emerald-500 rounded-full animate-pulse"></span>
                    <span id="sync-text">LIVE SYSTEM</span>
                </div>
            </div>
        </header>

        <main class="flex-1 overflow-y-auto p-4 md:p-6 lg:p-8 relative z-10">
            <!-- 1. DASHBOARD REKAPITULASI -->
            <section id="view-dashboard" class="fade-in block">
                <div class="mb-6 flex flex-col sm:flex-row sm:justify-between sm:items-end gap-4">
                    <div>
                        <h2 class="text-xl md:text-2xl font-bold theme-text-main tracking-tight">Dashboard Rekapitulasi</h2>
                        <p class="text-[10px] md:text-[11px] theme-text-muted mt-1">Data Terverifikasi (Sumber: Pivot Table Penugasan).</p>
                    </div>
                    <div class="premium-card px-4 py-2 rounded-lg">
                        <span class="text-[10px] font-bold theme-text-muted uppercase">FILTER CRO:</span>
                        <select id="cro-filter" onchange="renderDashboardCharts()" class="bg-transparent theme-text-main text-sm font-semibold outline-none"></select>
                    </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 md:gap-5 mb-8" id="dashboard-kpi-container"></div>

                <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 md:gap-5 mb-8">
                    <div class="premium-card p-4 md:p-6">
                        <h3 id="chart-title-bar" class="text-[10px] font-bold theme-text-muted uppercase tracking-widest mb-4">JUMLAH PT (KEBUN)</h3>
                        <div id="dash-bar-chart" style="height: 300px; width: 100%;"></div>
                    </div>
                    <div class="premium-card p-4 md:p-6">
                        <h3 id="chart-title-pie" class="text-[10px] font-bold theme-text-muted uppercase tracking-widest mb-4">LUAS TM (HA)</h3>
                        <div id="dash-pie-chart" style="height: 300px; width: 100%;"></div>
                    </div>
                </div>

                <div class="premium-card p-4 md:p-6 w-full mb-8">
                    <h3 id="pt-list-title" class="text-[10px] font-bold theme-text-muted uppercase mb-4">DAFTAR RINCIAN PERUSAHAAN (PT)</h3>
                    <div class="overflow-x-auto">
                        <table class="w-full text-left border-collapse min-w-[600px]">
                            <thead>
                                <tr>
                                    <th class="border-b border-gray-600/30 py-3 px-4 text-[10px] theme-text-muted uppercase">NAMA PERUSAHAAN (PT)</th>
                                    <th class="border-b border-gray-600/30 py-3 px-4 text-[10px] theme-text-muted uppercase text-center">STATUS KELOLA</th>
                                    <th class="border-b border-gray-600/30 py-3 px-4 text-[10px] theme-text-muted uppercase text-right">LUAS KEBUN (HA)</th>
                                    <th class="border-b border-gray-600/30 py-3 px-4 text-[10px] theme-text-muted uppercase text-right">LUAS TM (HA)</th>
                                </tr>
                            </thead>
                            <tbody id="pt-list-body" class="divide-y divide-gray-600/30"></tbody>
                        </table>
                    </div>
                </div>
            </section>

            <!-- 2. DASHBOARD PEMBATALAN -->
            <section id="view-pembatalan" class="fade-in hidden">
                <div class="mb-6 flex flex-col sm:flex-row sm:justify-between sm:items-end gap-4">
                    <div>
                        <h2 class="text-xl md:text-2xl font-bold theme-text-main tracking-tight">Dashboard Pembatalan</h2>
                        <p class="text-[10px] md:text-[11px] theme-text-muted mt-1">Data Terverifikasi (Sumber: Pivot Table Pembatalan).</p>
                    </div>
                    <div class="premium-card px-4 py-2 rounded-lg">
                        <span class="text-[10px] font-bold theme-text-muted uppercase">FILTER CRO:</span>
                        <select id="pembatalan-cro-filter" onchange="renderPembatalanDashboard()" class="bg-transparent theme-text-main text-sm font-semibold outline-none"></select>
                    </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 md:gap-5 mb-8">
                    <div class="premium-card p-6 bg-gradient-to-br border-t-[3px] border-t-red-600">
                        <div class="text-[10px] md:text-xs text-gray-300 font-bold uppercase tracking-widest mb-2">TOTAL SURAT PEMBATALAN</div>
                        <div class="text-3xl md:text-4xl font-extrabold text-white mb-1" id="kpi-total-batal">0 <span class="text-lg text-gray-400">Surat</span></div>
                    </div>
                    <div class="premium-card p-6 bg-gradient-to-br border-t-[3px] border-t-amber-500">
                        <div class="text-[10px] md:text-xs text-gray-300 font-bold uppercase tracking-widest mb-2">TOTAL LUAS TM BATAL</div>
                        <div class="text-3xl md:text-4xl font-extrabold text-white mb-1" id="kpi-luas-batal">0 <span class="text-lg text-gray-400">Ha</span></div>
                    </div>
                </div>

                <!-- TABEL SUMMARY KATEGORI (Statis) -->
                <div class="premium-card p-4 md:p-6 w-full mb-8 relative overflow-hidden">
                    <h3 class="text-[10px] font-bold theme-text-muted uppercase tracking-widest mb-4">REKAPITULASI KATEGORI MITRA</h3>
                    <div class="overflow-x-auto">
                        <table class="w-full text-left border-collapse min-w-[400px]">
                            <thead>
                                <tr>
                                    <th class="border-b border-gray-600/30 py-3 px-4 text-[10px] theme-text-muted uppercase bg-blue-500/20 text-blue-300">KATEGORI</th>
                                    <th class="border-b border-gray-600/30 py-3 px-4 text-[10px] theme-text-muted uppercase text-center bg-blue-500/20 text-blue-300">JUMLAH KEBUN/MITRA</th>
                                    <th class="border-b border-gray-600/30 py-3 px-4 text-[10px] theme-text-muted uppercase text-center bg-blue-500/20 text-blue-300">JUMLAH PT/CV/KOPERASI</th>
                                </tr>
                            </thead>
                            <tbody id="pembatalan-summary-body" class="divide-y divide-gray-600/30"></tbody>
                        </table>
                    </div>
                </div>

                <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 md:gap-5 mb-8">
                    <div class="premium-card p-4 md:p-6">
                        <h3 id="pembatalan-chart-title-bar" class="text-[10px] font-bold theme-text-muted uppercase tracking-widest mb-4">JUMLAH SURAT PEMBATALAN</h3>
                        <div id="dash-chart-pembatalan" style="height: 300px; width: 100%;"></div>
                    </div>
                    <div class="premium-card p-4 md:p-6">
                        <h3 id="pembatalan-chart-title-pie" class="text-[10px] font-bold theme-text-muted uppercase tracking-widest mb-4">LUAS TM (HA) PEMBATALAN</h3>
                        <div id="dash-pie-pembatalan" style="height: 300px; width: 100%;"></div>
                    </div>
                </div>

                <div class="premium-card p-4 md:p-6 w-full mb-8">
                    <h3 class="text-[10px] font-bold theme-text-muted uppercase mb-4">DAFTAR RINCIAN PERUSAHAAN PEMBATALAN</h3>
                    <div class="overflow-x-auto">
                        <table class="w-full text-left border-collapse min-w-[600px]">
                            <thead>
                                <tr>
                                    <th class="border-b border-gray-600/30 py-3 px-4 text-[10px] theme-text-muted uppercase">NAMA PERUSAHAAN / MITRA</th>
                                    <th class="border-b border-gray-600/30 py-3 px-4 text-[10px] theme-text-muted uppercase text-center">CRO</th>
                                    <th class="border-b border-gray-600/30 py-3 px-4 text-[10px] theme-text-muted uppercase text-right">LUAS TM (HA)</th>
                                    <th class="border-b border-gray-600/30 py-3 px-4 text-[10px] theme-text-muted uppercase text-center">STATUS</th>
                                </tr>
                            </thead>
                            <tbody id="pembatalan-pt-list-body" class="divide-y divide-gray-600/30"></tbody>
                        </table>
                    </div>
                </div>
            </section>

            <!-- 3. MASTER DATA REPOSITORY -->
            <section id="view-database" class="fade-in hidden">
                <div class="mb-6">
                    <h2 class="text-xl md:text-2xl font-bold theme-text-main tracking-tight" id="database-title">Master Data Repository</h2>
                </div>
                <div class="premium-card p-4 md:p-6 w-full">
                    <div class="w-full overflow-hidden" id="data-wrapper">
                        <div id="table-area" class="w-full">
                            <table id="mainTable" class="w-full text-left"></table>
                        </div>
                    </div>
                </div>
            </section>
        </main>
    </div>

    <!-- SCRIPT LOGIC JAVASCRIPT -->
    <script>
        function checkLoginState() {
            const loggedInUser = localStorage.getItem('agrinas_user');
            const loginOverlay = document.getElementById('login-overlay');
            if (loggedInUser) {
                loginOverlay.style.opacity = '0';
                setTimeout(() => { loginOverlay.style.display = 'none'; }, 500);
                const userObj = JSON.parse(loggedInUser);
                if(document.getElementById('pic-name-display')) document.getElementById('pic-name-display').innerText = userObj.name;
            } else {
                loginOverlay.style.display = 'flex';
                setTimeout(() => { loginOverlay.style.opacity = '1'; }, 10);
            }
        }

        function handleLogin(e) {
            e.preventDefault();
            const email = document.getElementById('login-email').value.trim().toLowerCase();
            const password = document.getElementById('login-password').value;
            const errorMsg = document.getElementById('login-error');
            
            if (((email === 'admin@agrinas.id' || email === 'admin') && password === 'admin123') || 
                ((email === 'ceo@agrinas.id' || email === 'ceo') && password === 'ceo123')) {
                const userData = { email: email, name: email.includes('ceo') ? 'BOD Agrinas' : 'Staf PIC HO' };
                localStorage.setItem('agrinas_user', JSON.stringify(userData));
                errorMsg.classList.add('hidden');
                checkLoginState();
            } else {
                errorMsg.classList.remove('hidden');
            }
        }

        function logout() {
            if(confirm("Apakah Anda yakin ingin memuat ulang / keluar sesi ini?")) {
                localStorage.removeItem('agrinas_user');
                window.location.reload();
            }
        }

        let rawData = <%- sheetData %> || {};
        let currentDataTable = null;
        let currentActiveSheet = null; 

        function toggleSidebar() {
            const sidebar = document.getElementById('mobile-sidebar');
            const overlay = document.getElementById('sidebar-overlay');
            if (sidebar.classList.contains('-translate-x-full')) {
                sidebar.classList.remove('-translate-x-full');
                overlay.classList.remove('hidden');
                setTimeout(() => overlay.classList.remove('opacity-0'), 10);
            } else {
                sidebar.classList.add('-translate-x-full');
                overlay.classList.add('opacity-0');
                setTimeout(() => overlay.classList.add('hidden'), 300);
            }
        }

        function toggleTheme() {
            document.body.classList.toggle('light-mode');
            const isLight = document.body.classList.contains('light-mode');
            localStorage.setItem('theme', isLight ? 'light' : 'dark');
            updateChartTheme(isLight);
        }

        function updateChartTheme(isLight) {
            const textColor = isLight ? '#6b7280' : '#a1a1aa';
            const gridColor = isLight ? 'rgba(0,0,0,0.1)' : 'rgba(255,255,255,0.05)';
            const tooltipBg = isLight ? '#ffffff' : '#151515';
            const tooltipText = isLight ? '#1f2937' : '#f8fafc';
            Highcharts.charts.forEach(chart => {
                if (chart) {
                    chart.update({
                        xAxis: { labels: { style: { color: textColor } } },
                        yAxis: { labels: { style: { color: textColor } }, gridLineColor: gridColor },
                        legend: { itemStyle: { color: textColor } },
                        plotOptions: { pie: { dataLabels: { color: textColor } } },
                        tooltip: { backgroundColor: tooltipBg, style: { color: tooltipText }, borderColor: gridColor }
                    });
                }
            });
        }

        function switchView(viewId, elementId, paramName = null) {
            document.getElementById('view-dashboard').classList.add('hidden');
            document.getElementById('view-pembatalan').classList.add('hidden');
            document.getElementById('view-database').classList.add('hidden');
            
            document.getElementById(viewId).classList.remove('hidden');
            
            if(viewId === 'view-dashboard') { currentActiveSheet = 'dashboard'; renderDashboardCharts(); }
            else if(viewId === 'view-pembatalan') { currentActiveSheet = 'pembatalan'; renderPembatalanDashboard(); }
            else if(viewId === 'view-database') { currentActiveSheet = paramName; loadTable(paramName); }
            
            document.querySelectorAll('.sidebar-link').forEach(el => el.classList.remove('active'));
            document.querySelectorAll('.sidebar-child-link').forEach(el => el.classList.remove('active'));
            if (elementId && document.getElementById(elementId)) document.getElementById(elementId).classList.add('active');
            if (window.innerWidth < 768) toggleSidebar();
            if(viewId === 'view-database' && currentDataTable) setTimeout(() => currentDataTable.columns.adjust(), 50);
        }

        const parseNum = (val) => {
            if (typeof val === 'number') return val;
            if (!val) return 0;
            let s = String(val).trim().replace(/Rp|\$|€|\s/gi, '');
            if (s === '-' || s === '') return 0;
            let lastDot = s.lastIndexOf('.');
            let lastComma = s.lastIndexOf(',');
            if (lastComma > lastDot && lastDot !== -1) s = s.replace(/\./g, '').replace(',', '.');
            else if (lastDot > lastComma && lastComma !== -1) s = s.replace(/,/g, '');
            else if (lastComma !== -1 && lastDot === -1) s = s.replace(',', '.');
            let res = parseFloat(s);
            return isNaN(res) ? 0 : res;
        };

        // =========================================
        // ENGINE PIVOT TABLE: OTOMATIS BACA DARI GOOGLE SHEET PIVOT
        // =========================================
        function getPivotData() {
            let pivotSheet = Object.keys(rawData).find(k => k.toLowerCase().includes('pivot')) || '';
            let pivotData = rawData[pivotSheet] || [];

            let penugasan = { totalLuas: 0, totalPT: 0, croMap: {} };
            let pembatalan = { totalLuas: 0, totalSurat: 0, croMap: {} };
            let currentSection = 'PENUGASAN'; 

            for(let i=0; i<pivotData.length; i++) {
                let row = pivotData[i];
                let rowStr = Object.values(row).join(" ").toLowerCase();

                if(rowStr.includes("pemberhentian") || rowStr.includes("pembatalan") || rowStr.includes("counta")) {
                    currentSection = 'PEMBATALAN';
                }

                let vals = Object.values(row).map(v => String(v).trim());
                
                let croTotalStr = vals.find(v => v.toLowerCase().includes('total') && (v.toLowerCase().includes('cro') || v.toLowerCase().match(/cro\s*[ivx]+/)));
                if (croTotalStr) {
                    let croName = croTotalStr.replace(/Total/ig, '').trim().toUpperCase();
                    let nums = vals.filter(v => v !== croTotalStr && v !== '' && !isNaN(parseNum(v)));
                    
                    if(currentSection === 'PENUGASAN') {
                        penugasan.croMap[croName] = { luas: nums.length > 0 ? parseNum(nums[0]) : 0, pt: nums.length > 1 ? parseNum(nums[1]) : 0 };
                    } else {
                        pembatalan.croMap[croName] = { surat: nums.length > 0 ? parseNum(nums[0]) : 0, luas: nums.length > 1 ? parseNum(nums[1]) : 0 };
                    }
                    continue; 
                }

                let grandTotalStr = vals.find(v => v.toLowerCase().includes("total keseluruhan"));
                if (grandTotalStr) {
                    let nums = vals.filter(v => v !== grandTotalStr && v !== '' && !isNaN(parseNum(v)));
                    if(currentSection === 'PENUGASAN') {
                        penugasan.totalLuas = nums.length > 0 ? parseNum(nums[0]) : 0;
                        penugasan.totalPT = nums.length > 1 ? parseNum(nums[1]) : 0;
                    } else {
                        pembatalan.totalSurat = nums.length > 0 ? parseNum(nums[0]) : 0;
                        pembatalan.totalLuas = nums.length > 1 ? parseNum(nums[1]) : 0;
                    }
                }
            }
            
            // Auto Backup jika kata 'Total Keseluruhan' tidak terbaca di kolom pertama
            if (penugasan.totalLuas === 0) Object.values(penugasan.croMap).forEach(val => { penugasan.totalLuas += val.luas; penugasan.totalPT += val.pt; });
            if (pembatalan.totalLuas === 0) Object.values(pembatalan.croMap).forEach(val => { pembatalan.totalLuas += val.luas; pembatalan.totalSurat += val.surat; });

            return { penugasan, pembatalan };
        }

        // =========================================
        // DASHBOARD REKAPITULASI (PIVOT + RAW)
        // =========================================
        function renderDashboardCharts() {
            const pivot = getPivotData().penugasan;
            const filterDropdown = document.getElementById('cro-filter');
            
            let croList = Object.keys(pivot.croMap).sort();
            if (filterDropdown && filterDropdown.options.length <= 1 && croList.length > 0) {
                filterDropdown.innerHTML = '<option value="ALL" class="bg-[#111111] text-white">Semua CRO</option>';
                croList.forEach(c => {
                    let opt = document.createElement('option'); opt.value = c; opt.innerText = c; opt.className = "bg-[#111111] text-white"; 
                    filterDropdown.appendChild(opt);
                });
                filterDropdown.value = "ALL";
            }
            const selectedCRO = filterDropdown ? filterDropdown.value : 'ALL';

            let dispLuas = 0, dispPT = 0;
            let chartBarDataMap = {}, chartPieDataMap = {};

            if (selectedCRO === 'ALL') {
                dispLuas = pivot.totalLuas; dispPT = pivot.totalPT;
                for(let c in pivot.croMap) { chartBarDataMap[c] = pivot.croMap[c].pt; chartPieDataMap[c] = pivot.croMap[c].luas; }
            } else if (pivot.croMap[selectedCRO]) {
                dispLuas = pivot.croMap[selectedCRO].luas; dispPT = pivot.croMap[selectedCRO].pt;
                chartBarDataMap[selectedCRO] = pivot.croMap[selectedCRO].pt; chartPieDataMap[selectedCRO] = pivot.croMap[selectedCRO].luas;
            }

            const kpiContainer = document.getElementById('dashboard-kpi-container');
            if(kpiContainer) {
                kpiContainer.innerHTML = `
                    <div class="relative overflow-hidden premium-card p-6 border-t-[3px] border-t-blue-500">
                        <div class="text-[10px] md:text-xs text-gray-300 font-bold uppercase mb-2">TOTAL PT (KEBUN)</div>
                        <div class="text-3xl md:text-4xl font-extrabold text-white mb-1">${dispPT.toLocaleString('id-ID')} <span class="text-lg text-gray-400 font-medium tracking-normal">PT</span></div>
                    </div>
                    <div class="relative overflow-hidden premium-card p-6 border-t-[3px] border-t-purple-500">
                        <div class="text-[10px] md:text-xs text-gray-300 font-bold uppercase mb-2">TOTAL LUAS TM (HA)</div>
                        <div class="text-3xl md:text-3xl lg:text-4xl font-extrabold text-white mb-1">${dispLuas.toLocaleString('id-ID', {minimumFractionDigits: 2, maximumFractionDigits: 2})} <span class="text-lg text-gray-400 font-medium tracking-normal">Ha</span></div>
                    </div>
                `;
            }

            if(document.getElementById('dash-bar-chart')) {
                Highcharts.chart('dash-bar-chart', {
                    chart: { type: 'column', backgroundColor: 'transparent' }, title: { text: null },
                    xAxis: { categories: Object.keys(chartBarDataMap) }, yAxis: { title: { text: null } },
                    series: [{ name: 'Jumlah PT (Kebun)', data: Object.values(chartBarDataMap), color: '#3b82f6' }],
                    plotOptions: { column: { borderRadius: 6, dataLabels: { enabled: true, color: '#ffffff' } } },
                    credits: { enabled: false }
                });
            }

            if(document.getElementById('dash-pie-chart')) {
                Highcharts.chart('dash-pie-chart', {
                    chart: { type: 'pie', backgroundColor: 'transparent' },
                    title: { text: `<span style="font-size: 10px; color: #a1a1aa;">TOTAL LUAS</span><br><span style="font-size: 18px; font-weight: bold; color: #ffffff;">${dispLuas.toLocaleString('id-ID', {maximumFractionDigits:0})}</span>`, align: 'center', verticalAlign: 'middle', y: 10, useHTML: true },
                    plotOptions: { pie: { innerSize: '75%', dataLabels: { enabled: true, color: '#e5e7eb' } } },
                    series: [{ name: 'Luas TM (Ha)', data: Object.keys(chartPieDataMap).map(k => [k, chartPieDataMap[k]]) }],
                    credits: { enabled: false }
                });
            }

            let rekapKey = Object.keys(rawData).find(k => k.trim().toUpperCase() === "REKAPITULASI PENUGASAN") || Object.keys(rawData).find(k => k.toLowerCase().includes("rekap") && !k.toLowerCase().includes("batal")) || Object.keys(rawData)[0];
            let rekapData = rawData[rekapKey] || [];
            let ptListRaw = [];

            if (rekapData.length > 0) {
                let rCols = Object.keys(rekapData[0] || {});
                let cCro = rCols.find(k => k.toLowerCase() === 'cro' || k.toLowerCase().includes('regional')) || rCols[2] || rCols[0];
                let cPt = rCols.find(k => k.toLowerCase() === 'nama pt' || k.toLowerCase().includes('perusahaan')) || rCols[5] || rCols[1];
                let cLuas = rCols.find(k => k.toLowerCase().includes('luas kebun')) || rCols[8] || rCols[2];
                let cLuasTM = rCols.find(k => k.toLowerCase().includes('luas tm')) || rCols[9] || rCols[3];
                let cStatus = rCols.find(k => k.toLowerCase().includes('status')) || rCols[24] || rCols[5];

                for (let i = 0; i < rekapData.length; i++) {
                    let row = rekapData[i];
                    let rowVals = Object.values(row).map(v => String(v).trim().toLowerCase());
                    if (rowVals.some(v => v === "total" || v === "kategori" || v.includes("jumlah:"))) break; 

                    let rawCro = String(row[cCro] || "").replace(/^[+-]\s*/, '').trim().toUpperCase();
                    let pt = String(row[cPt] || "").trim();
                    if (!rawCro || rawCro === "-" || rawCro === "CRO" || rawCro.includes("SUMMARY") || !pt || pt === "-" || pt.toLowerCase() === "nama pt") continue;

                    if (selectedCRO === 'ALL' || selectedCRO === rawCro) {
                        ptListRaw.push({ name: pt, cro: rawCro, luas: parseNum(row[cLuas]), luasTM: parseNum(row[cLuasTM]), status: String(row[cStatus] || "-").trim() });
                    }
                }
            }

            let ptHtml = '';
            ptListRaw.sort((a,b) => b.luasTM - a.luasTM);
            if (ptListRaw.length > 0) {
                ptListRaw.forEach(pt => {
                    let stc = pt.status.toLowerCase().includes('sudah') ? 'text-blue-400 font-bold' : (pt.status.toLowerCase().includes('belum') ? 'text-red-400 font-bold' : 'theme-text-muted');
                    ptHtml += `<tr class="hover:bg-white/5 border-b border-gray-600/30">
                        <td class="py-3 px-4 text-sm theme-text-main">${pt.name} ${selectedCRO === 'ALL' ? `<span class="ml-2 text-[10px] theme-text-muted bg-black/40 px-2 py-0.5 rounded border border-gray-600/50">${pt.cro}</span>` : ''}</td>
                        <td class="py-3 px-4 text-xs text-center ${stc}">${pt.status}</td>
                        <td class="py-3 px-4 text-sm theme-text-main text-right">${pt.luas.toLocaleString('id-ID', {maximumFractionDigits: 2})}</td>
                        <td class="py-3 px-4 text-sm text-purple-400 font-semibold text-right">${pt.luasTM.toLocaleString('id-ID', {maximumFractionDigits: 2})}</td>
                    </tr>`;
                });
            } else { ptHtml = `<tr><td colspan="4" class="py-6 text-center text-sm theme-text-muted">Tidak ada rincian data perusahaan.</td></tr>`; }
            if(document.getElementById('pt-list-body')) document.getElementById('pt-list-body').innerHTML = ptHtml;
            updateChartTheme(document.body.classList.contains('light-mode'));
        }

        // =========================================
        // DASHBOARD PEMBATALAN (PIVOT + RAW + KATEGORI STATIS)
        // =========================================
        function renderPembatalanDashboard() {
            const pivot = getPivotData().pembatalan;
            const filterDropdown = document.getElementById('pembatalan-cro-filter');
            
            let croList = Object.keys(pivot.croMap).sort();
            if (filterDropdown && filterDropdown.options.length <= 1 && croList.length > 0) {
                filterDropdown.innerHTML = '<option value="ALL" class="bg-[#111111] text-white">Semua CRO</option>';
                croList.forEach(c => {
                    let opt = document.createElement('option'); opt.value = c; opt.innerText = c; opt.className = "bg-[#111111] text-white"; 
                    filterDropdown.appendChild(opt);
                });
                filterDropdown.value = "ALL";
            }
            const selectedCRO = filterDropdown ? filterDropdown.value : 'ALL';

            let dispSurat = 0, dispLuas = 0;
            let chartBarDataMap = {}, chartPieDataMap = {};

            if (selectedCRO === 'ALL') {
                dispSurat = pivot.totalSurat; dispLuas = pivot.totalLuas;
                for(let c in pivot.croMap) { chartBarDataMap[c] = pivot.croMap[c].surat; chartPieDataMap[c] = pivot.croMap[c].luas; }
            } else if (pivot.croMap[selectedCRO]) {
                dispSurat = pivot.croMap[selectedCRO].surat; dispLuas = pivot.croMap[selectedCRO].luas;
                chartBarDataMap[selectedCRO] = pivot.croMap[selectedCRO].surat; chartPieDataMap[selectedCRO] = pivot.croMap[selectedCRO].luas;
            }

            document.getElementById('kpi-total-batal').innerHTML = `${dispSurat.toLocaleString('id-ID')} <span class="text-lg text-gray-400">Surat</span>`;
            document.getElementById('kpi-luas-batal').innerHTML = `${dispLuas.toLocaleString('id-ID', {minimumFractionDigits: 2, maximumFractionDigits: 2})} <span class="text-lg text-gray-400">Ha</span>`;

            if(document.getElementById('dash-chart-pembatalan')) {
                Highcharts.chart('dash-chart-pembatalan', {
                    chart: { type: 'column', backgroundColor: 'transparent' }, title: { text: null },
                    xAxis: { categories: Object.keys(chartBarDataMap) }, yAxis: { title: { text: null } },
                    series: [{ name: 'Jumlah Surat', data: Object.values(chartBarDataMap), color: '#ef4444' }],
                    plotOptions: { column: { borderRadius: 6, dataLabels: { enabled: true, color: '#ffffff' } } },
                    credits: { enabled: false }
                });
            }

            if(document.getElementById('dash-pie-pembatalan')) {
                Highcharts.chart('dash-pie-pembatalan', {
                    chart: { type: 'pie', backgroundColor: 'transparent' },
                    title: { text: `<span style="font-size: 10px; color: #a1a1aa;">TOTAL LUAS</span><br><span style="font-size: 18px; font-weight: bold; color: #ffffff;">${dispLuas.toLocaleString('id-ID', {maximumFractionDigits:0})}</span>`, align: 'center', verticalAlign: 'middle', y: 10, useHTML: true },
                    plotOptions: { pie: { innerSize: '75%', dataLabels: { enabled: true, color: '#e5e7eb' } } },
                    series: [{ name: 'Luas TM Batal (Ha)', data: Object.keys(chartPieDataMap).map(k => [k, chartPieDataMap[k]]) }],
                    credits: { enabled: false }
                });
            }

            // KATEGORI STATIS
            let summaryHtml = '';
            let dataKategori = [
                { cat: "PT", val1: 44, val2: 32 }, { cat: "CV", val1: 32, val2: 13 },
                { cat: "Koperasi", val1: 18, val2: 12 }, { cat: "Kelompok Tani", val1: 2, val2: 2 },
                { cat: "Total Penugasan", val1: 96, val2: 59 }
            ];
            dataKategori.forEach(item => {
                let isTotal = item.cat === "Total Penugasan";
                let rowClass = isTotal ? "bg-blue-500/10 font-bold" : "hover:bg-white/5";
                let textClass = isTotal ? "text-blue-400" : "theme-text-main";
                summaryHtml += `<tr class="${rowClass} border-b border-gray-600/30">
                    <td class="py-3 px-4 text-sm ${textClass}">${item.cat}</td>
                    <td class="py-3 px-4 text-sm ${textClass} text-center">${item.val1}</td>
                    <td class="py-3 px-4 text-sm ${textClass} text-center">${item.val2}</td>
                </tr>`;
            });
            if(document.getElementById('pembatalan-summary-body')) document.getElementById('pembatalan-summary-body').innerHTML = summaryHtml;

            // DAFTAR PERUSAHAAN PEMBATALAN RAW
            let batalKey = Object.keys(rawData).find(k => k.trim().toUpperCase() === "REKAPITULASI PEMBATALAN") || Object.keys(rawData).find(k => k.toLowerCase().includes("pembatalan")) || "REKAPITULASI PEMBATALAN";
            let pembatalanData = rawData[batalKey] || [];
            let ptListBatal = [];

            if (pembatalanData.length > 0) {
                let pCols = Object.keys(pembatalanData[0] || {});
                let pCroCol = pCols.find(k => k.toLowerCase() === 'cro' || k.toLowerCase().includes('regional')) || pCols[4];
                let pPtCol = pCols.find(k => k.toLowerCase() === 'nama pt' || k.toLowerCase().includes('nama mitra')) || pCols[2];
                let pLuasTM = pCols.find(k => k.toLowerCase().includes('luas tm')) || pCols[9];

                for (let i = 0; i < pembatalanData.length; i++) {
                    let row = pembatalanData[i];
                    let rowValsString = Object.values(row).map(v => String(v).trim().toLowerCase()).join(" ");
                    if (rowValsString.includes("total") || rowValsString.includes("kategori") || rowValsString.includes("jumlah:")) break; 
                    
                    let pt = String(row[pPtCol] || "-").trim();
                    let rawCro = String(row[pCroCol] || "").replace(/^[+-]\s*/, '').trim().toUpperCase();
                    let luas = parseNum(row[pLuasTM]);
                    let displayStatus = rowValsString.includes("proses ttd") ? "Proses TTD" : "Telah Terbit";

                    if (pt !== "-" && pt.toLowerCase() !== "nama pt" && luas > 0) {
                        if (rawCro && rawCro !== "-") { if (!rawCro.startsWith("CRO")) rawCro = "CRO " + rawCro; } 
                        else { rawCro = "Belum Ada CRO"; }

                        if (selectedCRO === 'ALL' || selectedCRO === rawCro) {
                            ptListBatal.push({ name: pt, cro: rawCro, luas: luas, status: displayStatus });
                        }
                    }
                }
            }

            let ptBatalHtml = '';
            ptListBatal.sort((a,b) => b.luas - a.luas); 
            ptListBatal.forEach(pt => {
                let statusBadge = pt.status === "Proses TTD" ? `<span class="px-2 py-1 bg-yellow-500/20 text-yellow-400 rounded">${pt.status}</span>` : `<span class="px-2 py-1 bg-red-500/20 text-red-400 rounded">${pt.status}</span>`;
                ptBatalHtml += `<tr class="hover:bg-white/5 border-b border-gray-600/30">
                    <td class="py-3 px-4 text-sm theme-text-main">${pt.name} ${selectedCRO === 'ALL' ? `<span class="ml-2 text-[10px] theme-text-muted bg-black/40 px-2 py-0.5 rounded border border-gray-600/50">${pt.cro}</span>` : ''}</td>
                    <td class="py-3 px-4 text-sm text-center theme-text-muted">${pt.cro}</td>
                    <td class="py-3 px-4 text-sm theme-text-main text-right">${pt.luas.toLocaleString('id-ID', {maximumFractionDigits: 2})}</td>
                    <td class="py-3 px-4 text-xs text-center">${statusBadge}</td>
                </tr>`;
            });
            if (ptListBatal.length === 0) ptBatalHtml = `<tr><td colspan="4" class="text-center py-6 theme-text-muted text-sm">Tidak ada rincian perusahaan.</td></tr>`;
            if(document.getElementById('pembatalan-pt-list-body')) document.getElementById('pembatalan-pt-list-body').innerHTML = ptBatalHtml;
            updateChartTheme(document.body.classList.contains('light-mode'));
        }

        // =========================================
        // MASTER DATA & AUTO SYNC
        // =========================================
        function loadTable(sheetName) {
            document.getElementById('table-area').classList.remove('hidden');
            let actualKey = sheetName;
            if (sheetName === "REKAPITULASI") actualKey = Object.keys(rawData).find(k => k.trim().toUpperCase().includes("REKAPITULASI PENUGASAN")) || "REKAPITULASI PENUGASAN";
            else if (sheetName === "REKAPITULASI PEMBATALAN") actualKey = Object.keys(rawData).find(k => k.trim().toUpperCase() === "REKAPITULASI PEMBATALAN") || "REKAPITULASI PEMBATALAN";

            const dataFull = rawData[actualKey] || [];
            let data = [];
            for(let i=0; i<dataFull.length; i++) {
                let rowVals = Object.values(dataFull[i]).map(v => String(v).trim().toLowerCase());
                if (rowVals.some(v => v === "total" || v === "kategori" || v.includes("jumlah:"))) break; 
                data.push(dataFull[i]);
            }

            if ($.fn.DataTable.isDataTable('#mainTable')) { $('#mainTable').DataTable().destroy(); $('#mainTable').empty(); }
            if (data.length === 0) { $('#mainTable').html(`<tbody><tr><td class="text-center py-12 theme-text-muted text-sm">Tidak ada data.</td></tr></tbody>`); return; }

            const validKeys = [];
            let allKeysSet = new Set();
            data.forEach(row => Object.keys(row).forEach(k => allKeysSet.add(k)));
            Array.from(allKeysSet).forEach(key => {
                let isGhost = true;
                for(let i=0; i < data.length; i++) { if (data[i][key] !== undefined && String(data[i][key]).trim() !== '-' && String(data[i][key]).trim() !== '') { isGhost = false; break; } }
                if (!isGhost) validKeys.push(key);
            });

            const columns = validKeys.map(key => {
                let displayTitle = key.startsWith('__EMPTY') ? "-" : key.replace(/_\d+$/, '').trim();
                return { title: `<span class="whitespace-nowrap">${displayTitle}</span>`, data: key, defaultContent: "-", 
                    render: function(val) { return typeof val === 'number' ? (val % 1 !== 0 ? val.toLocaleString('id-ID', {maximumFractionDigits: 2}) : val.toLocaleString('id-ID')) : val; }
                };
            });

            currentDataTable = $('#mainTable').DataTable({ data: data, columns: columns, scrollX: true, pageLength: 10, ordering: false, language: { search: "", searchPlaceholder: "Cari Data..." } });
        }

        document.addEventListener("DOMContentLoaded", function() {
            checkLoginState(); 
            if (localStorage.getItem('theme') === 'light') document.body.classList.add('light-mode');
            
            const sidebarMaster = document.getElementById('sidebar-master-data');
            if(sidebarMaster) {
                const masterItems = [ { id: "REKAPITULASI", display: "REKAPITULASI" }, { id: "REKAPITULASI PEMBATALAN", display: "REKAPITULASI PEMBATALAN" } ];
                masterItems.forEach((item, idx) => {
                    const btn = document.createElement('button'); btn.id = 'nav-md-' + idx; btn.className = 'w-full sidebar-child-link text-left'; 
                    btn.innerHTML = `<span>${item.display}</span>`; btn.onclick = () => switchView('view-database', btn.id, item.id);
                    sidebarMaster.appendChild(btn);
                });
            }

            Highcharts.setOptions({ colors: ['#3b82f6', '#8b5cf6', '#f97316', '#10b981', '#f43f5e', '#06b6d4'], credits: { enabled: false }, chart: { style: { fontFamily: 'Inter' } } });
            updateChartTheme(document.body.classList.contains('light-mode'));
            switchView('view-dashboard', 'nav-dashboard'); 
            
            async function syncData() {
                try {
                    const response = await fetch('/api/check-updates?t=' + new Date().getTime());
                    const result = await response.json();
                    if (result.rawData && Object.keys(result.rawData).length > 0 && JSON.stringify(rawData) !== JSON.stringify(result.rawData)) {
                        rawData = result.rawData;
                        if (currentActiveSheet === 'dashboard') renderDashboardCharts(); 
                        else if (currentActiveSheet === 'pembatalan') renderPembatalanDashboard(); 
                        else loadTable(currentActiveSheet);
                    }
                } catch (err) { console.error("Sync gagal", err); }
            }
            setInterval(syncData, 10000); 
        });
    </script>
</body>
</html>
