<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Executive Portal - Agrinas</title>
    
    <!-- Library CSS & Framework -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <script src="https://code.highcharts.com/highcharts.js"></script>
    
    <!-- DataTables & ColReorder Extension -->
    <link href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css" rel="stylesheet">
    <link href="https://cdn.datatables.net/colreorder/1.7.0/css/colReorder.dataTables.min.css" rel="stylesheet">
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/colreorder/1.7.0/js/dataTables.colReorder.min.js"></script>

    <!-- Google Fonts Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <style>
        :root {
            --bg-main: #0a0a0a; 
            --bg-panel: #111111;
            --bg-card: #151515;
            --border-color: #262626;
            --text-main: #ffffff;
            --text-muted: #a1a1aa;
            --hover-bg: #27272a;
            --shadow-drop: 0 10px 40px -10px rgba(0,0,0,0.8);
            --bg-dropdown: rgba(21, 21, 21, 0.95);
        }
        
        body.light-mode {
            --bg-main: #f3f4f6; 
            --bg-panel: #ffffff;
            --bg-card: #ffffff;
            --border-color: #e5e7eb;
            --text-main: #1f2937;
            --text-muted: #6b7280;
            --hover-bg: #f8fafc;
            --shadow-drop: 0 10px 40px -10px rgba(0,0,0,0.15);
            --bg-dropdown: rgba(255, 255, 255, 0.98); 
        }

        .theme-bg-main { background-color: var(--bg-main); transition: all 0.3s ease; }
        .theme-bg-panel { background-color: var(--bg-panel); transition: all 0.3s ease; }
        .theme-border { border-color: var(--border-color); transition: all 0.3s ease; }
        .theme-text-main { color: var(--text-main); transition: all 0.3s ease; }
        .theme-text-muted { color: var(--text-muted); transition: all 0.3s ease; }

        body { background-color: var(--bg-main); color: var(--text-main); font-family: 'Inter', sans-serif; overflow: hidden; transition: all 0.3s ease; }
        
        .premium-card { 
            background: rgba(21, 21, 21, 0.72); 
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255,255,255,0.08); 
            border-radius: 12px; 
            box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.4); 
            transition: all 0.3s ease; 
        }
        
        body.light-mode .premium-card {
            background: rgba(255, 255, 255, 0.88); 
            border: 1px solid var(--border-color); 
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1); 
        }

        .sidebar-link { padding: 11px 16px; font-size: 13px; font-weight: 500; color: var(--text-muted); border-radius: 10px; transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); display: flex; align-items: center; margin-bottom: 6px; position: relative; border: 1px solid transparent; }
        .sidebar-link:hover { color: var(--text-main); background: rgba(255,255,255,0.04); border-color: rgba(255,255,255,0.05); transform: translateX(4px); }
        .sidebar-link.active { color: #ffffff; background: linear-gradient(90deg, rgba(131,183,101,0.2) 0%, transparent 100%); border-left: 3px solid #83b765; border-color: transparent; border-left-color: #83b765; font-weight: 600; }
        .sidebar-link.active svg { color: #83b765; filter: drop-shadow(0 0 8px rgba(131,183,101,0.5)); }

        .sidebar-child-link { padding: 9px 16px 9px 36px; font-size: 12.5px; font-weight: 500; color: var(--text-muted); border-radius: 8px; transition: all 0.2s ease; display: flex; align-items: center; margin-bottom: 3px; }
        .sidebar-child-link:hover { color: var(--text-main); background: var(--hover-bg); }
        .sidebar-child-link.active { color: #83b765; background: rgba(131, 183, 101, 0.08); font-weight: 600; border-right: 3px solid #83b765; }

        .dataTables_wrapper select, .dataTables_wrapper .dataTables_filter input { background-color: rgba(21, 21, 21, 0.8) !important; border: 1px solid rgba(255,255,255,0.1) !important; color: var(--text-main) !important; padding: 6px 12px !important; border-radius: 6px !important; outline: none !important; transition: all 0.2s; }
        body.light-mode .dataTables_wrapper select, body.light-mode .dataTables_wrapper .dataTables_filter input { background-color: #ffffff !important; border: 1px solid var(--border-color) !important; }
        .dataTables_wrapper .dataTables_filter input:focus { border-color: #83b765 !important; }

        table.dataTable { border-collapse: collapse !important; border-spacing: 0 !important; margin-top: 12px !important; margin-bottom: 20px !important; width: 100% !important; border-bottom: 1px solid rgba(255,255,255,0.05) !important; }
        table.dataTable thead th { cursor: grab !important; background-color: rgba(21, 21, 21, 0.5) !important; color: var(--text-muted) !important; border-bottom: 1px solid rgba(255,255,255,0.05) !important; font-weight: 600; font-size: 11px; padding: 14px 18px !important; text-transform: uppercase; white-space: nowrap !important; }
        table.dataTable tbody tr { background-color: transparent !important; transition: all 0.15s ease; }
        table.dataTable tbody tr:hover { background-color: rgba(255,255,255,0.05) !important; }
        table.dataTable tbody td { border-bottom: 1px solid rgba(255,255,255,0.05) !important; font-size: 13px; padding: 12px 18px !important; color: var(--text-main) !important; white-space: nowrap !important; vertical-align: middle !important; }
        
        /* Pivot Table specific styles */
        .pivot-group-header { background-color: rgba(131, 183, 101, 0.1) !important; font-weight: 700 !important; color: #83b765 !important; }
        .pivot-total-row { background-color: rgba(255, 255, 255, 0.08) !important; font-weight: 700 !important; }
        .pivot-grand-total { background-color: rgba(255, 255, 255, 0.15) !important; font-weight: 800 !important; color: #fff !important;}
        body.light-mode .pivot-total-row { background-color: rgba(0, 0, 0, 0.05) !important; }
        body.light-mode .pivot-grand-total { background-color: rgba(0, 0, 0, 0.1) !important; color: #000 !important; }

        .fade-in { animation: fadeIn 0.4s ease forwards; }
        @keyframes fadeIn { from { opacity: 0; transform: translateY(4px); } to { opacity: 1; transform: translateY(0); } }

        ::-webkit-scrollbar { width: 6px; height: 8px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.2); border-radius: 4px; }
        ::-webkit-scrollbar-thumb:hover { background: rgba(255,255,255,0.4); }
        
        .bg-overlay {
            position: absolute;
            inset: 0;
            background-color: rgba(10, 10, 10, 0.65); 
            z-index: 0;
        }
        body.light-mode .bg-overlay {
            background-color: rgba(243, 244, 246, 0.82); 
        }
    </style>
</head>
<body class="flex h-screen w-full theme-bg-main theme-text-main relative bg-black">

    <!-- SIDEBAR -->
    <div id="sidebar-overlay" onclick="toggleSidebar()" class="fixed inset-0 bg-black/60 z-40 hidden md:hidden backdrop-blur-sm transition-opacity opacity-0 duration-300"></div>

    <aside id="mobile-sidebar" class="w-64 theme-bg-panel border-r theme-border flex flex-col h-full flex-shrink-0 z-50 fixed md:relative transform -translate-x-full md:translate-x-0 transition-transform duration-300">
        <div class="h-16 flex items-center px-6 border-b theme-border">
            <div class="flex items-center gap-3">
                <svg class="w-6 h-6 text-[#83b765]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path></svg>
                <div class="flex flex-col">
                    <h1 class="text-sm font-bold theme-text-main tracking-wide leading-tight">AGRINAS OPS</h1>
                    <span class="text-[10px] theme-text-muted">PT Agrinas Nusantara</span>
                </div>
            </div>
            <button onclick="toggleSidebar()" class="ml-auto md:hidden text-gray-400 hover:text-white focus:outline-none">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
            </button>
        </div>

        <div class="flex-1 overflow-y-auto py-5 px-3">
            <div class="text-[10px] font-bold theme-text-muted uppercase tracking-[0.1em] mb-3 px-3">Menu Utama</div>
            
            <!-- 0. DASHBOARD PIVOT (BARU) -->
            <button onclick="switchView('view-pivot', 'nav-pivot')" class="w-full sidebar-link active" id="nav-pivot">
                <svg class="w-4 h-4 mr-3 opacity-80" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"></path></svg> Dashboard Pivot
            </button>

            <!-- 1. DASHBOARD REKAPITULASI -->
            <button onclick="switchView('view-dashboard', 'nav-dashboard')" class="w-full sidebar-link" id="nav-dashboard">
                <svg class="w-4 h-4 mr-3 opacity-80" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path></svg> Dashboard Rekapitulasi
            </button>
            
            <!-- 2. DASHBOARD PEMBATALAN -->
            <button onclick="switchView('view-pembatalan', 'nav-pembatalan')" class="w-full sidebar-link" id="nav-pembatalan">
                <svg class="w-4 h-4 mr-3 opacity-80" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg> Dashboard Pembatalan
            </button>

            <!-- KATEGORI MASTER DATA -->
            <div class="text-[10px] font-bold theme-text-muted uppercase tracking-[0.1em] mb-2 px-3 mt-6 flex items-center">
                <svg class="w-3.5 h-3.5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4"></path></svg> Master Data Kebun
            </div>
            <div id="sidebar-master-data" class="mb-2"></div>
        </div>

        <div class="p-4 border-t theme-border theme-bg-main transition-colors duration-300 group cursor-pointer hover:bg-white/5" onclick="logout()">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-3">
                    <div class="w-8 h-8 rounded-full border border-[#83b765]/30 flex items-center justify-center text-xs font-bold text-white bg-gradient-to-br from-[#83b765] to-emerald-700 shadow-sm">PIC</div>
                    <div class="flex flex-col overflow-hidden">
                        <span id="pic-name-display" class="text-xs font-semibold theme-text-main truncate">Staf PIC HO</span>
                    </div>
                </div>
                <svg class="w-4 h-4 text-red-500 opacity-50 group-hover:opacity-100 transition-opacity" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path></svg>
            </div>
        </div>
    </aside>

    <!-- CONTENT AREA -->
    <div class="flex-1 flex flex-col h-full overflow-hidden transition-colors duration-300 relative bg-black">
        <div class="absolute inset-0 z-0 bg-cover bg-center bg-no-repeat transition-all duration-500" style="background-image: url('https://raw.githubusercontent.com/kylsxnd/Dashboard-QC-Tanaman/main/public/bgkelapasawit.jpeg'); opacity: 0.45;"></div>
        <div class="bg-overlay"></div>

        <header class="h-16 border-b border-gray-600/30 flex items-center justify-between px-4 md:px-6 z-10 flex-shrink-0 transition-colors duration-300 relative" style="background: rgba(17,17,17,0.7); backdrop-filter: blur(10px);">
            <div class="flex items-center text-sm font-medium theme-text-muted min-w-0">
                <button onclick="toggleSidebar()" class="md:hidden mr-3 p-2 -ml-2 rounded-lg theme-text-muted hover:bg-[var(--hover-bg)] focus:outline-none shrink-0">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
                </button>
                <svg class="w-4 h-4 mr-2 shrink-0 hidden sm:block" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
                <span id="header-title" class="truncate max-w-[130px] sm:max-w-xs md:max-w-md">Dashboard Pivot</span>
            </div>

            <div class="flex items-center gap-2 md:gap-4 shrink-0">
                <button onclick="toggleTheme()" class="relative p-2 theme-text-muted hover:text-[var(--text-main)] transition-colors focus:outline-none" title="Ganti Tema">
                    <svg id="theme-icon" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
                </button>
                <div class="w-px h-5 theme-border border-l"></div>
                <div class="flex items-center gap-2 text-[10px] font-semibold text-emerald-500 bg-emerald-500/10 px-2.5 py-1.5 md:px-3 rounded-full border border-emerald-500/20">
                    <span id="sync-dot" class="relative flex h-1.5 w-1.5"><span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span><span class="relative inline-flex rounded-full h-1.5 w-1.5 bg-emerald-500"></span></span>
                    <span id="sync-text" class="hidden sm:inline">LIVE SYSTEM</span>
                </div>
            </div>
        </header>

        <main class="flex-1 overflow-y-auto p-4 md:p-6 lg:p-8 relative z-10">
            
            <!-- 0. DASHBOARD PIVOT (BARU) -->
            <section id="view-pivot" class="fade-in block">
                <div class="mb-6">
                    <h2 class="text-xl md:text-2xl font-bold theme-text-main tracking-tight">Dashboard Pivot</h2>
                    <p class="text-[10px] md:text-[11px] theme-text-muted mt-1 flex items-center gap-1">
                        <svg class="w-3 h-3 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg> Rekapitulasi Data Terpusat (Berdasarkan Kalkulasi Data Mentah)
                    </p>
                </div>

                <!-- Pivot Tabel 1: Surat Penugasan -->
                <div class="premium-card p-4 md:p-6 w-full mb-8">
                    <h3 class="text-[11px] md:text-xs font-bold theme-text-main uppercase tracking-widest mb-4">REKAPITULASI SURAT PENUGASAN SEMENTARA PENGELOLAAN KEBUN</h3>
                    <div class="overflow-x-auto rounded-lg border theme-border">
                        <table class="w-full text-left border-collapse min-w-[500px]">
                            <thead class="bg-[#2b4c7e] text-white">
                                <tr>
                                    <th class="py-3 px-4 text-xs font-semibold uppercase border-r border-[#1e3a63]">CRO</th>
                                    <th class="py-3 px-4 text-xs font-semibold uppercase border-r border-[#1e3a63]">Tahap</th>
                                    <th class="py-3 px-4 text-xs font-semibold uppercase text-right border-r border-[#1e3a63]">SUM dari Luas TM (Ha)</th>
                                    <th class="py-3 px-4 text-xs font-semibold uppercase text-center">Jumlah PT (Kebun)</th>
                                </tr>
                            </thead>
                            <tbody id="pivot-penugasan-body" class="divide-y divide-gray-600/30 text-sm">
                                <!-- Data diisi oleh JS -->
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Pivot Tabel 2: Surat Pembatalan -->
                <div class="premium-card p-4 md:p-6 w-full mb-8">
                    <h3 class="text-[11px] md:text-xs font-bold theme-text-main uppercase tracking-widest mb-4">REKAPITULASI SURAT PEMBATALAN</h3>
                    <div class="overflow-x-auto rounded-lg border theme-border">
                        <table class="w-full text-left border-collapse min-w-[500px]">
                            <thead class="bg-[#59698d] text-white">
                                <tr>
                                    <th class="py-3 px-4 text-xs font-semibold uppercase border-r border-[#3d4c6a]">CRO</th>
                                    <th class="py-3 px-4 text-xs font-semibold uppercase border-r border-[#3d4c6a]">Tahap</th>
                                    <th class="py-3 px-4 text-xs font-semibold uppercase text-center border-r border-[#3d4c6a]">COUNTA dari No Surat Pembatalan</th>
                                    <th class="py-3 px-4 text-xs font-semibold uppercase text-right">SUM dari Luas TM (Ha)</th>
                                </tr>
                            </thead>
                            <tbody id="pivot-pembatalan-body" class="divide-y divide-gray-600/30 text-sm">
                                <!-- Data diisi oleh JS -->
                            </tbody>
                        </table>
                    </div>
                </div>
            </section>

            <!-- 1. DASHBOARD REKAPITULASI -->
            <section id="view-dashboard" class="fade-in hidden">
                <div class="mb-6 flex flex-col sm:flex-row sm:justify-between sm:items-end gap-4">
                    <div>
                        <h2 class="text-xl md:text-2xl font-bold theme-text-main tracking-tight">Dashboard Rekapitulasi</h2>
                        <p class="text-[10px] md:text-[11px] theme-text-muted mt-1 flex items-center gap-1">
                            <svg class="w-3 h-3 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg> Data setara sheet PIVOT (Otomatis Filter Baris 1-207).
                        </p>
                    </div>
                    <div class="flex items-center justify-between sm:justify-start gap-3 premium-card border theme-border px-4 py-2 rounded-lg shadow-sm">
                        <span class="text-[10px] md:text-[11px] font-bold theme-text-muted uppercase tracking-widest">FILTER CRO:</span>
                        <select id="cro-filter" onchange="renderDashboardCharts()" class="bg-transparent theme-text-main text-xs md:text-sm font-semibold outline-none cursor-pointer border-none !p-0"></select>
                    </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-3 lg:grid-cols-3 gap-4 md:gap-5 mb-8" id="dashboard-kpi-container"></div>

                <div class="grid grid-cols-1 lg:grid-cols-3 gap-4 md:gap-5 mb-8">
                    <div class="premium-card p-4 md:p-6 w-full lg:col-span-1 relative overflow-hidden">
                        <h3 id="chart-title-bar" class="text-[10px] font-bold theme-text-muted uppercase tracking-widest mb-4">TARGET PRODUKSI (TON) SE-INDONESIA</h3>
                        <div id="dash-bar-chart" style="height: 300px; width: 100%;"></div>
                    </div>
                    <div class="premium-card p-4 md:p-6 w-full lg:col-span-1 relative overflow-hidden">
                        <h3 id="chart-title-pie" class="text-[10px] font-bold theme-text-muted uppercase tracking-widest mb-4">LUAS KEBUN (HA) SE-INDONESIA</h3>
                        <div id="dash-pie-chart" style="height: 300px; width: 100%;"></div>
                    </div>
                    <div class="premium-card p-4 md:p-6 w-full lg:col-span-1 relative overflow-hidden">
                        <h3 id="chart-title-status" class="text-[10px] font-bold theme-text-muted uppercase tracking-widest mb-4">STATUS KELOLA PT SE-INDONESIA</h3>
                        <div id="status-pie-chart" style="height: 300px; width: 100%;"></div>
                    </div>
                </div>

                <div class="premium-card p-4 md:p-6 mt-5 w-full mb-8">
                    <h3 id="pt-list-title" class="text-[10px] font-bold theme-text-muted uppercase tracking-widest mb-4">DAFTAR PERUSAHAAN (PT)</h3>
                    <div class="overflow-x-auto">
                        <table class="w-full text-left border-collapse min-w-[600px]">
                            <thead>
                                <tr>
                                    <th class="border-b border-gray-600/30 py-3 px-4 text-[10px] theme-text-muted uppercase">NAMA PERUSAHAAN (PT)</th>
                                    <th class="border-b border-gray-600/30 py-3 px-4 text-[10px] theme-text-muted uppercase text-center">STATUS KELOLA</th>
                                    <th class="border-b border-gray-600/30 py-3 px-4 text-[10px] theme-text-muted uppercase text-right">LUAS KEBUN (HA)</th>
                                    <th class="border-b border-gray-600/30 py-3 px-4 text-[10px] theme-text-muted uppercase text-right">LUAS TM (HA)</th>
                                    <th class="border-b border-gray-600/30 py-3 px-4 text-[10px] theme-text-muted uppercase text-right">TARGET PRODUKSI (TON)</th>
                                </tr>
                            </thead>
                            <tbody id="pt-list-body" class="divide-y divide-gray-600/30"></tbody>
                        </table>
                    </div>
                </div>
