    <!-- SCRIPT LOGIC -->
    <script>
        function checkLoginState() {
            const loggedInUser = localStorage.getItem('agrinas_user');
            const loginOverlay = document.getElementById('login-overlay');
            if (loggedInUser) {
                loginOverlay.style.opacity = '0';
                setTimeout(() => { loginOverlay.style.display = 'none'; }, 500);
                const userObj = JSON.parse(loggedInUser);
                document.getElementById('pic-name-display').innerText = userObj.name;
                document.getElementById('pic-email-display').innerText = userObj.email;
            } else {
                loginOverlay.style.display = 'flex';
                setTimeout(() => { loginOverlay.style.opacity = '1'; }, 10);
            }
        }

        function handleLogin(e) {
            e.preventDefault();
            const email = document.getElementById('login-email').value.trim();
            const password = document.getElementById('login-password').value;
            const errorMsg = document.getElementById('login-error');
            
            if ((email === 'admin@agrinas.id' && password === 'admin123') || 
                (email === 'ceo@agrinas.id' && password === 'ceo123')) {
                const userData = { email: email, name: email === 'ceo@agrinas.id' ? 'BOD Agrinas' : 'Staf PIC HO' };
                localStorage.setItem('agrinas_user', JSON.stringify(userData));
                errorMsg.classList.add('hidden');
                checkLoginState();
            } else {
                errorMsg.classList.remove('hidden');
            }
        }
        
        function logout() {
            if(confirm("Apakah Anda yakin ingin keluar dari sistem?")) {
                localStorage.removeItem('agrinas_user');
                document.getElementById('login-email').value = '';
                document.getElementById('login-password').value = '';
                checkLoginState();
            }
        }

        let rawData = <%- sheetData %> || {};
        let logsData = <%- logsData %> || []; 
        let emailsData = <%- emailsData %> || []; 
        
        // NAMA SHEET DI-UPDATE SESUAI EXCEL TERBARU (REKAPITULASI & REKAPITULASI PEMBATALAN)
        const listSheets = ["REKAPITULASI", "REKAPITULASI PEMBATALAN"];
        let currentDataTable = null;
        let isUnread = false; 
        let currentActiveSheet = null; 

        function toggleSidebar() {
            const sidebar = document.getElementById('mobile-sidebar');
            const overlay = document.getElementById('sidebar-overlay');
            if (sidebar.classList.contains('-translate-x-full')) {
                sidebar.classList.remove('-translate-x-full');
                overlay.classList.remove('hidden');
                setTimeout(() => overlay.classList.remove('opacity-0'), 10);
            } else {
                sidebar.classList.add('-translate-x-full');
                overlay.classList.add('opacity-0');
                setTimeout(() => overlay.classList.add('hidden'), 300);
            }
        }

        function toggleTheme() {
            document.body.classList.toggle('light-mode');
            const isLight = document.body.classList.contains('light-mode');
            localStorage.setItem('theme', isLight ? 'light' : 'dark');
            const themeIcon = document.getElementById('theme-icon');
            if (isLight) themeIcon.innerHTML = `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"></path>`;
            else themeIcon.innerHTML = `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path>`;
            updateChartTheme(isLight);
        }

        function updateChartTheme(isLight) {
            const textColor = isLight ? '#6b7280' : '#a1a1aa';
            const gridColor = isLight ? 'rgba(0,0,0,0.1)' : 'rgba(255,255,255,0.05)';
            const tooltipBg = isLight ? '#ffffff' : '#151515';
            const tooltipText = isLight ? '#1f2937' : '#f8fafc';
            Highcharts.charts.forEach(chart => {
                if (chart) {
                    chart.update({
                        xAxis: { labels: { style: { color: textColor } } },
                        yAxis: { labels: { style: { color: textColor } }, gridLineColor: gridColor },
                        legend: { itemStyle: { color: textColor } },
                        plotOptions: { pie: { dataLabels: { color: textColor } } },
                        tooltip: { backgroundColor: tooltipBg, style: { color: tooltipText }, borderColor: gridColor }
                    });
                }
            });
        }

        function switchView(viewId, elementId, sheetName = null) {
            document.getElementById('view-dashboard').classList.add('hidden');
            document.getElementById('view-database').classList.add('hidden');
            document.getElementById('view-inbox').classList.add('hidden');
            
            document.getElementById(viewId).classList.remove('hidden');
            
            const headerTitle = document.getElementById('header-title');
            if(viewId === 'view-dashboard') {
                headerTitle.innerText = "Executive On-Farm > Dashboard";
                currentActiveSheet = 'dashboard';
                renderPivotDashboard(); 
            }
            else if(viewId === 'view-database') {
                headerTitle.innerText = "Master Data > " + sheetName;
                document.getElementById('database-title').innerText = sheetName;
                currentActiveSheet = sheetName;
                loadTable(sheetName);
            }
            else if(viewId === 'view-inbox') {
                headerTitle.innerText = "Executive On-Farm > Inbox Email";
                currentActiveSheet = 'inbox';
                fetch('/api/read-emails?t=' + new Date().getTime(), { method: 'POST' }).then(() => {
                    const badge = document.getElementById('sidebar-email-badge');
                    if(badge) { badge.classList.add('hidden'); badge.classList.remove('badge-pop'); }
                    document.querySelectorAll('.email-row').forEach(el => {
                        if(el.classList.contains('bg-blue-500/10')) {
                            el.classList.remove('bg-blue-500/10');
                            el.querySelector('.email-sender').classList.remove('font-bold', 'text-white');
                            el.querySelector('.email-subject').classList.remove('font-bold', 'text-white');
                        }
                    });
                });
            }
            
            document.querySelectorAll('.sidebar-link').forEach(el => el.classList.remove('active'));
            document.querySelectorAll('.sidebar-child-link').forEach(el => el.classList.remove('active'));
            
            if (elementId && document.getElementById(elementId)) {
                document.getElementById(elementId).classList.add('active');
            }
            
            if (window.innerWidth < 768) toggleSidebar();
            if(viewId === 'view-database' && currentDataTable) setTimeout(() => currentDataTable.columns.adjust(), 50);
        }

        function markAsRead() { document.getElementById('notif-badge').classList.add('hidden'); isUnread = false; }

        async function changeEmailLabel(id, newLabel) {
            try {
                const res = await fetch('/api/update-email-label?t=' + new Date().getTime(), { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ id: id, label: newLabel }) });
                const data = await res.json();
                if(data.success) { emailsData = data.emails; renderEmailsUI(); }
            } catch (err) { console.error(err); }
        }

        function renderEmailsUI() {
            const container = document.getElementById('email-list-container');
            let html = '';
            if(emailsData && emailsData.length > 0) {
                emailsData.forEach(email => {
                    const bgClass = email.unread ? 'bg-blue-500/10' : 'hover:bg-[var(--hover-bg)]';
                    const textSenderClass = email.unread ? 'font-bold text-white' : 'font-medium theme-text-main';
                    const textSubjectClass = email.unread ? 'font-bold text-white' : 'font-medium theme-text-main';
                    const dotClass = email.unread ? '<div class="w-2 h-2 bg-blue-400 rounded-full mr-2 md:mr-3 shrink-0"></div>' : '<div class="w-2 h-2 mr-2 md:mr-3 shrink-0"></div>';
                    let badgeColor = email.label === "SUDAH DI CRO" ? "bg-emerald-500/20 text-emerald-400 border-emerald-500/30" : "bg-amber-500/20 text-amber-400 border-amber-500/30";
                    html += `<div class="email-row flex flex-col md:flex-row md:items-center justify-between px-4 md:px-6 py-4 cursor-pointer transition-colors border-b border-gray-600/30 last:border-0 ${bgClass} gap-3 md:gap-0"><div class="flex items-center gap-3 md:gap-4 min-w-0 pr-0 md:pr-4">${dotClass}<div class="w-8 h-8 md:w-10 md:h-10 rounded-full bg-black/40 border border-gray-600/50 flex items-center justify-center text-xs font-bold theme-text-main shrink-0">${email.sender.charAt(0)}</div><div class="min-w-0"><div class="flex items-center gap-2 mb-0.5 md:mb-1"><span class="email-sender text-[11px] md:text-xs truncate ${textSenderClass}">${email.sender}</span><span class="text-[9px] md:text-[10px] theme-text-muted shrink-0">• ${email.time}</span></div><h4 class="email-subject text-xs md:text-sm truncate mb-0.5 ${textSubjectClass}">${email.subject}</h4><p class="text-[10px] md:text-xs theme-text-muted truncate">${email.snippet}</p></div></div><div class="shrink-0 flex items-center pl-10 md:pl-0"><select onchange="changeEmailLabel(${email.id}, this.value)" class="text-[10px] md:text-xs font-semibold px-2 py-1 md:px-3 md:py-1.5 rounded-lg border cursor-pointer outline-none transition-all ${badgeColor}"><option value="BELUM DI CRO" ${email.label === 'BELUM DI CRO' ? 'selected' : ''} class="bg-[#111111] text-white">BELUM DI CRO</option><option value="SUDAH DI CRO" ${email.label === 'SUDAH DI CRO' ? 'selected' : ''} class="bg-[#111111] text-white">SUDAH DI CRO</option></select></div></div>`;
                });
            } else { html = `<div class="p-8 text-center text-sm theme-text-muted">Tidak ada email masuk.</div>`; }
            if(container) container.innerHTML = html;
        }

        function renderNotifications() {
            const listContainer = document.getElementById('notif-list');
            const badge = document.getElementById('notif-badge');
            if (logsData && logsData.length > 0) {
                if (isUnread && badge) badge.classList.remove('hidden'); 
                let html = '';
                logsData.forEach(log => {
                    html += `<div class="mb-3 pb-3 border-b theme-border last:border-0 last:mb-0 last:pb-0"><div class="flex justify-between items-center mb-1"><span class="text-[10px] font-semibold text-blue-500 uppercase tracking-wider">${log.sheet}</span><div class="flex items-center gap-1 text-[10px] theme-text-muted"><svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>${log.waktu}</div></div><div class="text-xs theme-text-muted mb-2">Row <span class="theme-text-main font-medium">${log.baris}</span>, Col <span class="theme-text-main font-medium">${log.kolom}</span></div><div class="text-xs theme-bg-main border theme-border rounded py-1.5 px-2"><div class="flex items-center gap-2 theme-text-muted line-through mb-1"><span class="truncate">${log.lama}</span></div><div class="flex items-center gap-2 text-emerald-500"><span class="truncate">${log.baru}</span></div></div></div>`;
                });
                if(listContainer) listContainer.innerHTML = html;
            } else {
                if(listContainer) listContainer.innerHTML = `<div class="flex flex-col items-center justify-center py-8 text-center"><p class="text-xs theme-text-muted font-medium">Belum ada perubahan data.</p></div>`;
            }
        }

        const parseNum = (val) => {
            if (typeof val === 'number') return val;
            if (val === null || val === undefined) return 0;
            let s = String(val).trim().replace(/Rp|\$|€| /gi, '');
            if (s === '-' || s === '') return 0;

            if (s.includes(',')) {
                s = s.replace(/\./g, '').replace(',', '.');
            } else {
                let lastDot = s.lastIndexOf('.');
                if (lastDot !== -1 && s.indexOf('.') !== lastDot) {
                    s = s.substring(0, lastDot).replace(/\./g, '') + s.substring(lastDot);
                }
            }
            let res = parseFloat(s);
            return isNaN(res) ? 0 : res;
        };

        // =========================================
        // DASHBOARD UTAMA (LIVE DYNAMIC - FULL CRO + OPSI ALL KEMBALI)
        // =========================================
        function renderPivotDashboard() {
            const filterDropdown = document.getElementById('cro-filter');
            
            // SEDOT DATA DARI SHEET "REKAPITULASI" (SESUAI UPDATE NAMA TERBARU)
            let rekapKey = Object.keys(rawData).find(k => k.trim().toLowerCase() === "rekapitulasi") || "REKAPITULASI";
            const rekapData = rawData[rekapKey] || [];
            
            let croList = new Set();

            if (rekapData.length > 0) {
                let rCols = Object.keys(rekapData[0] || {});
                let cCro = rCols.find(k => k.toLowerCase() === 'cro' || k.toLowerCase().includes('regional')) || rCols[0];
                let cPt = rCols.find(k => k.toLowerCase().includes('nama pt') || k.toLowerCase().includes('perusahaan') || k.toLowerCase().includes('koperasi') || k.toLowerCase().includes('vendor')) || rCols[1];
                let cNoSurat = rCols.find(k => k.toLowerCase().includes('no surat')) || rCols.find(k => k.toLowerCase().includes('surat'));

                rekapData.forEach(row => {
                    let rawCro = String(row[cCro] || "").replace(/^[+-]\s*/, '').trim();
                    let cro = rawCro.toUpperCase();
                    let pt = String(row[cPt] || "").trim();
                    let noSurat = cNoSurat ? String(row[cNoSurat] || "").trim() : "ADA"; 

                    // FILTER WAJIB: Harus Punya No Surat yang Valid (Ada garis miring)
                    if (cNoSurat && (!noSurat || noSurat === "-" || noSurat.toLowerCase().includes("no surat") || !noSurat.includes("/"))) return;
                    if (!cro || cro === "-" || cro === "CRO" || cro.includes("TOTAL") || cro.includes("SUMMARY") || cro.includes("TAHAP")) return;
                    if (!pt || pt === "-" || pt.toLowerCase() === "nama pt") return;

                    croList.add(cro);
                });
            }

            // Atur Dropdown otomatis dengan opsi ALL
            if (filterDropdown && filterDropdown.options.length <= 1 && croList.size > 0) {
                filterDropdown.innerHTML = '<option value="ALL" class="bg-[#111111] text-white">Semua CRO</option>';
                let sortedCro = [...croList].sort();
                sortedCro.forEach(c => {
                    let opt = document.createElement('option'); 
                    opt.value = c; 
                    opt.innerText = c; 
                    opt.className = "bg-[#111111] text-white"; 
                    filterDropdown.appendChild(opt);
                });
                filterDropdown.value = "ALL";
            }

            const selectedCRO = filterDropdown ? filterDropdown.value : 'ALL';
            
            let totalLuas = 0, totalLuasTM = 0, totalTarget = 0;
            let chartBarDataMap = {}, chartPieDataMap = {}; 
            let ptListRaw = []; 
            let totalSudahDikelola = 0, totalBelumDikelola = 0;

            if (rekapData.length > 0) {
                let rCols = Object.keys(rekapData[0] || {});
                let cCro = rCols.find(k => k.toLowerCase() === 'cro' || k.toLowerCase().includes('regional')) || rCols[0];
                let cPt = rCols.find(k => k.toLowerCase().includes('nama pt') || k.toLowerCase().includes('perusahaan') || k.toLowerCase().includes('koperasi') || k.toLowerCase().includes('vendor')) || rCols[1];
                let cLuas = rCols.find(k => k.toLowerCase().includes('luas kebun')) || rCols[2];
                let cLuasTM = rCols.find(k => k.toLowerCase().includes('luas tm')) || rCols[3];
                let cTarget = rCols.find(k => k.toLowerCase().includes('target')) || rCols[4];
                let cStatus = rCols.find(k => k.toLowerCase().includes('status')) || rCols[5];
                let cNoSurat = rCols.find(k => k.toLowerCase().includes('no surat')) || rCols.find(k => k.toLowerCase().includes('surat'));

                rekapData.forEach(row => {
                    let rawCro = String(row[cCro] || "").replace(/^[+-]\s*/, '').trim();
                    let cro = rawCro.toUpperCase();
                    let pt = String(row[cPt] || "").trim();
                    let status = String(row[cStatus] || "").trim();
                    let sLow = status.toLowerCase();
                    let noSurat = cNoSurat ? String(row[cNoSurat] || "").trim() : "ADA"; 

                    // Filter wajib
                    if (cNoSurat && (!noSurat || noSurat === "-" || noSurat.toLowerCase().includes("no surat") || !noSurat.includes("/"))) return;
                    if (!cro || cro === "-" || cro === "CRO" || cro.includes("TOTAL") || cro.includes("SUMMARY") || cro.includes("TAHAP")) return;
                    if (!pt || pt === "-" || pt.toLowerCase() === "nama pt") return;

                    // Hitung jika sesuai filter
