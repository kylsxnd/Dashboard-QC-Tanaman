        // =========================================
        // DASHBOARD 1: REKAPITULASI CHARTS & TABLES
        // =========================================
        function renderDashboardCharts() {
            const filterDropdown = document.getElementById('cro-filter');
            
            let rekapKey = Object.keys(rawData).find(k => k.trim().toUpperCase() === "REKAPITULASI") || "REKAPITULASI";
            let rekapDataRaw = rawData[rekapKey] || [];
            let rekapData = rekapDataRaw.slice(0, 206); 
            
            let croList = new Set();
            let totalLuas = 0, totalLuasTM = 0, totalTarget = 0;
            let chartBarDataMap = {}, chartPieDataMap = {}; 
            let ptListRaw = []; 
            let totalSudahDikelola = 0, totalBelumDikelola = 0, totalProsesTTD = 0;

            if (rekapData.length > 0) {
                let rCols = Object.keys(rekapData[0] || {});
                let cCro = rCols.find(k => k.toLowerCase() === 'cro' || k.toLowerCase().includes('regional')) || rCols[0];
                let cPt = rCols.find(k => k.toLowerCase().includes('nama pt') || k.toLowerCase().includes('perusahaan') || k.toLowerCase().includes('koperasi') || k.toLowerCase().includes('vendor')) || rCols[1];
                let cNoSurat = rCols.find(k => k.toLowerCase().includes('no surat')) || rCols.find(k => k.toLowerCase().includes('surat'));
                let cLink = rCols.find(k => k.toLowerCase().includes('link surat')) || rCols.find(k => k.toLowerCase().includes('link'));

                rekapData.forEach(row => {
                    let rawCro = String(row[cCro] || "").replace(/^[+-]\s*/, '').trim();
                    let cro = rawCro.toUpperCase();
                    let pt = String(row[cPt] || "").trim();
                    let noSurat = cNoSurat ? String(row[cNoSurat] || "").trim() : "ADA"; 
                    let linkSurat = cLink ? String(row[cLink] || "").trim() : "";
                    
                    let isProsesTTD = noSurat.toLowerCase().includes("proses ttd") || linkSurat.toLowerCase().includes("proses ttd");
                    let isValidRow = noSurat && noSurat !== "-" && !noSurat.toLowerCase().includes("no surat");

                    if (!cro || cro === "-" || cro === "CRO" || cro.includes("TOTAL") || cro.includes("SUMMARY") || cro.includes("TAHAP")) return;
                    if (!pt || pt === "-" || pt.toLowerCase() === "nama pt") return;
                    if (isValidRow || isProsesTTD) croList.add(cro);
                });
            }

            if (filterDropdown && filterDropdown.options.length <= 1 && croList.size > 0) {
                filterDropdown.innerHTML = '<option value="ALL" class="bg-[#111111] text-white">Semua CRO</option>';
                let sortedCro = [...croList].sort();
                sortedCro.forEach(c => {
                    let opt = document.createElement('option'); 
                    opt.value = c; opt.innerText = c; opt.className = "bg-[#111111] text-white"; 
                    filterDropdown.appendChild(opt);
                });
                filterDropdown.value = "ALL";
            }

            const selectedCRO = filterDropdown ? filterDropdown.value : 'ALL';

            if (rekapData.length > 0) {
                let rCols = Object.keys(rekapData[0] || {});
                let cCro = rCols.find(k => k.toLowerCase() === 'cro' || k.toLowerCase().includes('regional')) || rCols[0];
                let cPt = rCols.find(k => k.toLowerCase().includes('nama pt') || k.toLowerCase().includes('perusahaan') || k.toLowerCase().includes('koperasi') || k.toLowerCase().includes('vendor')) || rCols[1];
                let cLuas = rCols.find(k => k.toLowerCase().includes('luas kebun')) || rCols[2];
                let cLuasTM = rCols.find(k => k.toLowerCase().includes('luas tm')) || rCols[3];
                let cTarget = rCols.find(k => k.toLowerCase().includes('target')) || rCols[4];
                let cStatus = rCols.find(k => k.toLowerCase().includes('status')) || rCols[5];
                let cNoSurat = rCols.find(k => k.toLowerCase().includes('no surat')) || rCols.find(k => k.toLowerCase().includes('surat'));
                let cLink = rCols.find(k => k.toLowerCase().includes('link surat')) || rCols.find(k => k.toLowerCase().includes('link'));

                rekapData.forEach(row => {
                    let rawCro = String(row[cCro] || "").replace(/^[+-]\s*/, '').trim();
                    let cro = rawCro.toUpperCase();
                    let pt = String(row[cPt] || "").trim();
                    let status = String(row[cStatus] || "").trim();
                    let sLow = status.toLowerCase();
                    
                    let noSurat = cNoSurat ? String(row[cNoSurat] || "").trim() : "ADA"; 
                    let linkSurat = cLink ? String(row[cLink] || "").trim() : "";
                    
                    let isProsesTTD = noSurat.toLowerCase().includes("proses ttd") || linkSurat.toLowerCase().includes("proses ttd");
                    let isValidRow = noSurat && noSurat !== "-" && !noSurat.toLowerCase().includes("no surat");

                    if (!cro || cro === "-" || cro === "CRO" || cro.includes("TOTAL") || cro.includes("SUMMARY") || cro.includes("TAHAP")) return;
                    if (!pt || pt === "-" || pt.toLowerCase() === "nama pt") return;

                    if ((isValidRow || isProsesTTD) && (selectedCRO === 'ALL' || selectedCRO === cro)) {
                        let luas = parseNum(row[cLuas]);
                        let luasTM = parseNum(row[cLuasTM]);
                        let target = parseNum(row[cTarget]);

                        totalLuas += luas;
                        totalLuasTM += luasTM;
                        totalTarget += target;

                        chartBarDataMap[cro] = (chartBarDataMap[cro] || 0) + target;
                        chartPieDataMap[cro] = (chartPieDataMap[cro] || 0) + luas;

                        let finalStatus = isProsesTTD ? "Proses TTD" : (status || '-');
                        ptListRaw.push({ name: pt, cro: cro, luas: luas, luasTM: luasTM, target: target, status: finalStatus });

                        if (isProsesTTD) totalProsesTTD++;
                        else if (sLow.includes('sudah')) totalSudahDikelola++;
                        else totalBelumDikelola++;
                    }
                });
            }

            let totalPtCount = ptListRaw.length;

            const kpiContainer = document.getElementById('dashboard-kpi-container');
            if(kpiContainer) {
                kpiContainer.innerHTML = `
                    <div class="relative overflow-hidden premium-card p-6 bg-gradient-to-br from-[rgba(17,17,17,0.8)] to-[rgba(21,21,21,0.9)] border-t-[3px] border-t-blue-500 shadow-[0_4px_15px_-4px_rgba(59,130,246,0.2)] group transition-all duration-300 hover:shadow-[0_0_25px_rgba(59,130,246,0.6)] cursor-default">
                        <div class="text-[10px] md:text-xs text-gray-300 font-bold uppercase tracking-widest mb-2">TOTAL TARGET PRODUKSI</div>
                        <div class="text-3xl md:text-4xl font-extrabold text-white mb-1 tracking-tight">${totalTarget.toLocaleString('id-ID', {minimumFractionDigits: 2, maximumFractionDigits: 2})} <span class="text-lg text-gray-400 font-medium tracking-normal">Ton</span></div>
                        <div class="text-[10px] text-gray-500 italic mt-2 opacity-80">(Berdasarkan data filter)</div>
                    </div>
                    <div class="relative overflow-hidden premium-card p-6 bg-gradient-to-br from-[rgba(17,17,17,0.8)] to-[rgba(21,21,21,0.9)] border-t-[3px] border-t-purple-500 shadow-[0_4px_15px_-4px_rgba(168,85,247,0.2)] group transition-all duration-300 hover:shadow-[0_0_25px_rgba(168,85,247,0.6)] cursor-default">
                        <div class="text-[10px] md:text-xs text-gray-300 font-bold uppercase tracking-widest mb-2">TOTAL LUAS KEBUN / LUAS TM</div>
                        <div class="text-3xl md:text-4xl font-extrabold text-white mb-1 tracking-tight">${totalLuas.toLocaleString('id-ID', {minimumFractionDigits: 2, maximumFractionDigits: 2})} <span class="text-lg text-gray-400 font-medium tracking-normal">Ha</span></div>
                        <div class="text-[10px] font-semibold text-purple-300 mt-2 bg-purple-500/20 inline-block px-2 py-0.5 rounded border border-purple-500/30">Luas TM ${totalLuasTM.toLocaleString('id-ID', {minimumFractionDigits: 2, maximumFractionDigits: 2})} Ha</div>
                    </div>
                    <div class="relative overflow-hidden premium-card p-6 bg-gradient-to-br from-[rgba(17,17,17,0.8)] to-[rgba(21,21,21,0.9)] border-t-[3px] border-t-emerald-500 shadow-[0_4px_15px_-4px_rgba(16,185,129,0.2)] group transition-all duration-300 hover:shadow-[0_0_25px_rgba(16,185,129,0.6)] cursor-default">
                        <div class="text-[10px] md:text-xs text-gray-300 font-bold uppercase tracking-widest mb-2">TOTAL KEMITRAAN PT</div>
                        <div class="text-3xl md:text-4xl font-extrabold text-white mb-1 tracking-tight">${totalPtCount.toLocaleString('id-ID')} <span class="text-lg text-gray-400 font-medium tracking-normal">PT</span></div>
                        <div class="text-[10px] text-gray-500 italic mt-2 opacity-80">(Data Filter Berdasarkan Pivot)</div>
                    </div>
                `;
            }

            const titleSuffix = selectedCRO === 'ALL' ? 'SE-INDONESIA' : `(REGIONAL ${selectedCRO})`;
            if(document.getElementById('chart-title-bar')) document.getElementById('chart-title-bar').innerText = `TARGET PRODUKSI (TON) ${titleSuffix}`;
            if(document.getElementById('chart-title-pie')) document.getElementById('chart-title-pie').innerText = `LUAS KEBUN (HA) ${titleSuffix}`;
            if(document.getElementById('chart-title-status')) document.getElementById('chart-title-status').innerText = `STATUS KELOLA PT ${titleSuffix}`;
            if(document.getElementById('pt-list-title')) document.getElementById('pt-list-title').innerText = `DAFTAR PERUSAHAAN (PT) ${selectedCRO !== 'ALL' ? '- ' + selectedCRO : ''}`;

            if(document.getElementById('dash-bar-chart')) {
                Highcharts.chart('dash-bar-chart', {
                    chart: { type: 'column', backgroundColor: 'transparent', marginTop: 30 },
                    title: { text: null },
                    tooltip: { backgroundColor: 'rgba(21, 21, 21, 0.95)', style: { color: '#ffffff' }, borderWidth: 1, borderColor: '#333333', borderRadius: 8, padding: 12 },
                    xAxis: { categories: Object.keys(chartBarDataMap), labels: { style: { color: '#a1a1aa', fontWeight: '500' } }, lineWidth: 0, tickWidth: 0 },
                    yAxis: { title: { text: null }, gridLineColor: 'rgba(255,255,255,0.05)', labels: { style: { color: '#a1a1aa' } } },
                    series: [{ name: 'Target Produksi (Ton)', data: Object.values(chartBarDataMap), color: { linearGradient: { x1: 0, x2: 0, y1: 0, y2: 1 }, stops: [ [0, '#3b82f6'], [1, 'rgba(59, 130, 246, 0.2)'] ] } }],
                    plotOptions: { column: { borderRadius: 6, borderWidth: 0, dataLabels: { enabled: false } } },
                    credits: { enabled: false }
                });
            }

            if(document.getElementById('dash-pie-chart')) {
                Highcharts.chart('dash-pie-chart', {
                    chart: { type: 'pie', backgroundColor: 'transparent' },
                    title: { text: `<span style="font-size: 10px; color: #a1a1aa; letter-spacing: 1px; font-weight: normal;">TOTAL LUAS (HA)</span><br><span style="font-size: 20px; font-weight: bold; color: #ffffff;">${totalLuas.toLocaleString('id-ID', {maximumFractionDigits:0})}</span>`, align: 'center', verticalAlign: 'middle', y: 10, useHTML: true },
                    tooltip: { backgroundColor: 'rgba(21, 21, 21, 0.95)', style: { color: '#ffffff' }, borderWidth: 1, borderColor: '#333333', borderRadius: 8 },
                    plotOptions: { pie: { innerSize: '75%', borderWidth: 0, dataLabels: { enabled: true, color: '#e5e7eb', style: { textOutline: 'none', fontWeight: '500' }, connectorColor: 'rgba(255,255,255,0.2)' } } },
                    colors: ['#8b5cf6', '#3b82f6', '#10b981', '#f59e0b', '#f43f5e', '#06b6d4', '#6366f1', '#14b8a6', '#f97316', '#84cc16'],
                    series: [{ name: 'Luas Kebun (Ha)', data: Object.keys(chartPieDataMap).map(k => [k, chartPieDataMap[k]]) }],
                    credits: { enabled: false }
                });
            }

            if(document.getElementById('status-pie-chart')) {
                Highcharts.chart('status-pie-chart', {
                    chart: { type: 'pie', backgroundColor: 'transparent' },
                    title: { text: `<span style="font-size: 10px; color: #a1a1aa; letter-spacing: 1px; font-weight: normal;">TOTAL PT</span><br><span style="font-size: 20px; font-weight: bold; color: #ffffff;">${totalSudahDikelola + totalBelumDikelola + totalProsesTTD}</span>`, align: 'center', verticalAlign: 'middle', y: 10, useHTML: true },
                    tooltip: { backgroundColor: 'rgba(21, 21, 21, 0.95)', style: { color: '#ffffff' }, borderWidth: 1, borderColor: '#333333', borderRadius: 8 },
                    plotOptions: { pie: { innerSize: '75%', borderWidth: 0, dataLabels: { enabled: true, color: '#e5e7eb', style: { textOutline: 'none', fontWeight: '500' }, connectorColor: 'rgba(255,255,255,0.2)' } } },
                    colors: ['#3b82f6', '#f43f5e', '#f59e0b'], 
                    series: [{ name: 'Jumlah PT', data: [
                        {name: 'Sudah Dikelola', y: totalSudahDikelola}, 
                        {name: 'Belum Dikelola', y: totalBelumDikelola},
                        {name: 'Proses TTD', y: totalProsesTTD}
                    ]}],
                    credits: { enabled: false }
