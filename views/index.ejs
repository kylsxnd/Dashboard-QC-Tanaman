<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Executive Portal - Agrinas</title>
    
    <!-- Library CSS & Framework -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <script src="https://code.highcharts.com/highcharts.js"></script>

    <!-- ALAT PENYEDOT DATA CADANGAN (PAPAPARSE) KHUSUS REKAP KEMITRAAN -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/PapaParse/5.4.1/papaparse.min.js"></script>
    
    <!-- DataTables -->
    <link href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css" rel="stylesheet">
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>

    <!-- Google Fonts Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <style>
        /* =========================================
           SISTEM TEMA: DARK / LIGHT MODE
           ========================================= */
        :root {
            /* Tema Gelap (Bawaan) */
            --bg-main: #0a0a0a; 
            --bg-panel: #111111;
            --bg-card: #151515;
            --border-color: #262626;
            --text-main: #ffffff;
            --text-muted: #a1a1aa;
            --hover-bg: #27272a;
            --shadow-drop: 0 10px 40px -10px rgba(0,0,0,0.8);
            --bg-dropdown: rgba(21, 21, 21, 0.95);
        }
        
        body.light-mode {
            /* Tema Terang */
            --bg-main: #f3f4f6; 
            --bg-panel: #ffffff;
            --bg-card: #ffffff;
            --border-color: #e5e7eb;
            --text-main: #1f2937;
            --text-muted: #6b7280;
            --hover-bg: #f8fafc;
            --shadow-drop: 0 10px 40px -10px rgba(0,0,0,0.15);
            --bg-dropdown: rgba(255, 255, 255, 0.98); 
        }

        /* CLASS KHUSUS UNTUK MENERAPKAN TEMA */
        .theme-bg-main { 
            background-color: var(--bg-main); 
            transition: all 0.3s ease; 
        }
        
        .theme-bg-panel { 
            background-color: var(--bg-panel); 
            transition: all 0.3s ease; 
        }
        
        .theme-border { 
            border-color: var(--border-color); 
            transition: all 0.3s ease; 
        }
        
        .theme-text-main { 
            color: var(--text-main); 
            transition: all 0.3s ease; 
        }
        
        .theme-text-muted { 
            color: var(--text-muted); 
            transition: all 0.3s ease; 
        }

        /* =========================================
           BASE & LAYOUT
           ========================================= */
        body { 
            background-color: var(--bg-main); 
            color: var(--text-main); 
            font-family: 'Inter', sans-serif; 
            overflow: hidden; 
            transition: all 0.3s ease; 
        }
        
        /* PREMIUM CARDS */
        .premium-card { 
            background: var(--bg-card); 
            border: 1px solid var(--border-color); 
            border-radius: 12px; 
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1); 
            transition: all 0.3s ease; 
        }

        /* =========================================
           DROPDOWN NOTIFIKASI KHUSUS (ANTI TRANSPARAN)
           ========================================= */
        .premium-dropdown {
            background-color: var(--bg-dropdown);
            backdrop-filter: blur(12px); 
            border: 1px solid var(--border-color);
            box-shadow: var(--shadow-drop);
            z-index: 100 !important; 
        }
        
        .premium-dropdown-header {
            background-color: var(--bg-panel);
            border-bottom: 1px solid var(--border-color);
        }

        /* =========================================
           SIDEBAR LINKS
           ========================================= */
        .sidebar-link {
            padding: 10px 16px;
            font-size: 13px;
            font-weight: 500;
            color: var(--text-muted);
            border-radius: 8px;
            transition: all 0.2s ease;
            display: flex;
            align-items: center;
            margin-bottom: 4px;
            position: relative;
        }

        .sidebar-link:hover { 
            color: var(--text-main); 
            background: var(--hover-bg); 
        }

        .sidebar-link.active { 
            color: var(--text-main); 
            background: var(--hover-bg); 
            border-left: 3px solid #83b765; 
        }

        /* ANIMASI BADGE KIRI */
        @keyframes pop {
            0% { transform: scale(0.8); opacity: 0; }
            50% { transform: scale(1.2); opacity: 1; }
            100% { transform: scale(1); opacity: 1; }
        }
        
        .badge-pop {
            animation: pop 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
        }
        
        /* =========================================
           TABS NAVIGATION (Menu Sheet)
           ========================================= */
        .tab-btn { 
            padding: 8px 16px; 
            font-size: 13px; 
            cursor: pointer; 
            white-space: nowrap; 
            transition: all 0.25s ease; 
            border-radius: 6px; 
            color: var(--text-muted); 
            font-weight: 500; 
            background: transparent; 
            border: 1px solid transparent; 
        }
        
        .tab-active { 
            background: var(--hover-bg) !important; 
            color: var(--text-main) !important; 
            border-color: var(--border-color) !important; 
        }
        
        .tab-btn:hover:not(.tab-active) { 
            color: var(--text-main); 
            background: var(--hover-bg); 
        }

        /* =========================================
           DATATABLES CUSTOMIZATION
           ========================================= */
        .dataTables_wrapper .dataTables_length, 
        .dataTables_wrapper .dataTables_filter, 
        .dataTables_wrapper .dataTables_info, 
        .dataTables_wrapper .dataTables_paginate { 
            color: var(--text-muted) !important; 
            font-size: 12px; 
            margin-top: 16px; 
            margin-bottom: 24px; 
        }
        
        .dataTables_wrapper select, 
        .dataTables_wrapper .dataTables_filter input { 
            background-color: var(--bg-main) !important; 
            border: 1px solid var(--border-color) !important; 
            color: var(--text-main) !important; 
            padding: 6px 12px !important; 
            border-radius: 6px !important; 
            outline: none !important; 
            transition: all 0.2s; 
        }
        
        .dataTables_wrapper .dataTables_filter input:focus { 
            border-color: #83b765 !important; 
        }

        table.dataTable { 
            border-collapse: collapse !important; 
            border-spacing: 0 !important; 
            margin-top: 12px !important; 
            margin-bottom: 20px !important; 
            width: 100% !important; 
            border-bottom: 1px solid var(--border-color) !important; 
        }
        
        table.dataTable thead th { 
            background-color: var(--bg-card) !important; 
            color: var(--text-muted) !important; 
            border-bottom: 1px solid var(--border-color) !important; 
            font-weight: 600; 
            font-size: 11px; 
            letter-spacing: 0.05em; 
            padding: 14px 18px !important; 
            text-transform: uppercase; 
            white-space: nowrap !important; 
        }
        
        table.dataTable tbody tr { 
            background-color: transparent !important; 
            transition: all 0.15s ease; 
        }
        
        table.dataTable tbody tr:hover { 
            background-color: var(--hover-bg) !important; 
        }
        
        table.dataTable tbody td { 
            border-bottom: 1px solid var(--border-color) !important; 
            font-size: 13px; 
            padding: 12px 18px !important; 
            color: var(--text-main) !important; 
            white-space: nowrap !important; 
            vertical-align: middle !important; 
        }

        /* PAGINATION BUTTONS */
        .dataTables_wrapper .dataTables_paginate .paginate_button { 
            background: transparent !important; 
            border: 1px solid transparent !important; 
            border-radius: 6px !important; 
            color: var(--text-muted) !important; 
            padding: 4px 10px !important; 
            margin: 0 2px !important; 
            transition: all 0.2s; 
        }
        
        .dataTables_wrapper .dataTables_paginate .paginate_button:hover { 
            background: var(--hover-bg) !important; 
            color: var(--text-main) !important; 
        }
        
        .dataTables_wrapper .dataTables_paginate .paginate_button.current { 
            background: var(--hover-bg) !important; 
            color: var(--text-main) !important; 
            border-color: var(--border-color) !important; 
            font-weight: 600; 
        }

        /* =========================================
           ANIMATIONS & CUSTOM SCROLLBAR
           ========================================= */
        .fade-in { 
            animation: fadeIn 0.4s ease forwards; 
        }
        
        @keyframes fadeIn { 
            from { opacity: 0; transform: translateY(4px); } 
            to { opacity: 1; transform: translateY(0); } 
        }

        ::-webkit-scrollbar { 
            width: 6px; 
            height: 8px; 
        }
        
        ::-webkit-scrollbar-track { 
            background: transparent; 
        }
        
        ::-webkit-scrollbar-thumb { 
            background: var(--border-color); 
            border-radius: 4px; 
        }
        
        ::-webkit-scrollbar-thumb:hover { 
            background: var(--text-muted); 
        }
    </style>
</head>
<body class="flex h-screen w-full theme-bg-main theme-text-main relative">

    <!-- =========================================
         OVERLAY BACKDROP (UNTUK HP)
         ========================================= -->
    <div id="sidebar-overlay" onclick="toggleSidebar()" class="fixed inset-0 bg-black/60 z-40 hidden md:hidden backdrop-blur-sm transition-opacity opacity-0 duration-300"></div>

    <!-- =========================================
         SIDEBAR KIRI (Menu Navigasi)
         ========================================= -->
    <aside id="mobile-sidebar" class="w-64 theme-bg-panel border-r theme-border flex flex-col h-full flex-shrink-0 z-50 fixed md:relative transform -translate-x-full md:translate-x-0 transition-transform duration-300">
        
        <!-- Logo Sidebar -->
        <div class="h-16 flex items-center px-6 border-b theme-border">
            <div class="flex items-center gap-3">
                <svg class="w-6 h-6 text-[#83b765]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
                </svg>
                <div class="flex flex-col">
                    <h1 class="text-sm font-bold theme-text-main tracking-wide leading-tight">AGRINAS OPS</h1>
                    <span class="text-[10px] theme-text-muted">PT Agrinas Nusantara</span>
                </div>
            </div>
            <!-- Tombol Close Sidebar (Mobile Only) -->
            <button onclick="toggleSidebar()" class="ml-auto md:hidden text-gray-400 hover:text-white focus:outline-none">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
            </button>
        </div>

        <!-- Menu Utama -->
        <div class="flex-1 overflow-y-auto py-5 px-3">
            <div class="text-[10px] font-bold theme-text-muted uppercase tracking-widest mb-3 px-3">
                Menu Utama
            </div>
            
            <button onclick="switchView('view-dashboard', 'nav-dashboard')" class="w-full sidebar-link active" id="nav-dashboard">
                <svg class="w-4 h-4 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"></path>
                </svg>
                Dashboard On Farm
            </button>
            
            <button onclick="switchView('view-database', 'nav-database')" class="w-full sidebar-link" id="nav-database">
                <svg class="w-4 h-4 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4"></path>
                </svg>
                Master Data Kebun
            </button>

            <!-- MENU EVALUASI KINERJA -->
            <button onclick="switchView('view-evaluasi', 'nav-evaluasi')" class="w-full sidebar-link" id="nav-evaluasi">
                <svg class="w-4 h-4 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
                </svg>
                Evaluasi Kinerja
            </button>

            <!-- MENU INBOX EMAIL -->
            <button onclick="switchView('view-inbox', 'nav-inbox')" class="w-full sidebar-link" id="nav-inbox">
                <svg class="w-4 h-4 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                </svg>
                Inbox Email
                
                <!-- BADGE NOTIFIKASI KIRI -->
                <span id="sidebar-email-badge" class="absolute right-3 bg-red-500 text-white text-[10px] font-bold px-2 py-0.5 rounded-full hidden">
                    0
                </span>
            </button>
        </div>

        <!-- Profil User Bawah -->
        <div class="p-4 border-t theme-border theme-bg-main transition-colors duration-300">
            <div class="flex items-center gap-3">
                <div class="w-8 h-8 rounded-full border theme-border flex items-center justify-center text-xs font-bold theme-text-main" style="background-color: var(--hover-bg);">
                    PIC
                </div>
                <div class="flex flex-col overflow-hidden">
                    <span class="text-xs font-semibold theme-text-main truncate">Staf PIC HO</span>
                    <span class="text-[10px] theme-text-muted truncate">staf.pic.ho@agrinas.id</span>
                </div>
            </div>
        </div>
    </aside>

    <!-- =========================================
         AREA KONTEN KANAN (Header + Main)
         ========================================= -->
    <div class="flex-1 flex flex-col h-full overflow-hidden theme-bg-main transition-colors duration-300">
        
        <!-- HEADER ATAS KANAN -->
        <header class="h-16 theme-bg-panel border-b theme-border flex items-center justify-between px-4 md:px-6 z-10 flex-shrink-0 transition-colors duration-300">
            
            <!-- Bagian Kiri Header (Hamburger + Judul) -->
            <div class="flex items-center text-sm font-medium theme-text-muted min-w-0">
                <!-- Tombol Menu Hamburger (Khusus Layar HP) -->
                <button onclick="toggleSidebar()" class="md:hidden mr-3 p-2 -ml-2 rounded-lg theme-text-muted hover:bg-[var(--hover-bg)] focus:outline-none shrink-0">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
                </button>
                
                <svg class="w-4 h-4 mr-2 shrink-0 hidden sm:block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                </svg>
                <!-- Dikasih max-width biar teks panjang di HP otomatis dipotong pakai titik-titik (...) -->
                <span id="header-title" class="truncate max-w-[130px] sm:max-w-xs md:max-w-md">Executive On-Farm > Dashboard</span>
            </div>

            <!-- Panel Kanan Atas -->
            <div class="flex items-center gap-2 md:gap-4 shrink-0">
                
                <!-- TOMBOL GANTI TEMA -->
                <button onclick="toggleTheme()" class="relative p-2 theme-text-muted hover:text-[var(--text-main)] transition-colors focus:outline-none" title="Ganti Tema">
                    <svg id="theme-icon" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path>
                    </svg>
                </button>

                <div class="w-px h-5 theme-border border-l"></div>

                <!-- Live System Indicator -->
                <div class="flex items-center gap-2 text-[10px] font-semibold text-emerald-500 bg-emerald-500/10 px-2.5 py-1.5 md:px-3 rounded-full border border-emerald-500/20">
                    <span id="sync-dot" class="relative flex h-1.5 w-1.5">
                      <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                      <span class="relative inline-flex rounded-full h-1.5 w-1.5 bg-emerald-500"></span>
                    </span>
                    <span id="sync-text" class="hidden sm:inline">LIVE SYSTEM</span>
                </div>
                
                <div class="w-px h-5 theme-border border-l hidden sm:block"></div>
                
                <!-- Lonceng Notifikasi Update Database -->
                <div class="relative group">
                    <button onclick="markAsRead()" class="relative p-2 theme-text-muted hover:text-[var(--text-main)] transition-colors focus:outline-none z-50">
                        <span id="notif-badge" class="absolute top-1.5 right-1.5 w-2 h-2 bg-red-500 rounded-full hidden"></span>
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
